{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cott.dev/schema/contract-test/v3",
  "title": "cott contract test strategy",
  "type": "object",
  "required": ["schema_version", "symbol", "seed", "candidate_limit", "node_limit", "container_length_limit", "json_depth_limit", "lifecycle_limit", "callable_kind", "return_kind", "classification", "clause_ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 3},
    "symbol": {"type": "string"},
    "seed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_limit": {"const": 64},
    "node_limit": {"const": 64},
    "container_length_limit": {"const": 3},
    "json_depth_limit": {"const": 4},
    "lifecycle_limit": {"const": 3},
    "callable_kind": {"enum": ["sync", "async"]},
    "return_kind": {"enum": ["value", "async_iterator", "async_generator"]},
    "classification": {"enum": ["pure", "effectful", "never"]},
    "clause_ids": {"type": "array", "items": {"type": "string"}}
  }
}
