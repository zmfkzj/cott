{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cott.dev/schema/contract-test/v6",
  "title": "cott contract test strategy v6",
  "type": "object",
  "required": ["schema_version", "symbol", "seed", "proof_node_limit", "proof_branch_limit", "candidate_limit", "node_limit", "container_length_limit", "json_depth_limit", "lifecycle_limit", "callable_kind", "return_kind", "classification", "clause_ids", "obligations", "scenario"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 6},
    "symbol": {"type": "string"},
    "seed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "proof_node_limit": {"type": "integer", "minimum": 1, "maximum": 16384},
    "proof_branch_limit": {"type": "integer", "minimum": 1, "maximum": 4096},
    "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 1024},
    "node_limit": {"const": 64},
    "container_length_limit": {"const": 3},
    "json_depth_limit": {"const": 4},
    "lifecycle_limit": {"type": "integer", "minimum": 1, "maximum": 64},
    "callable_kind": {"enum": ["sync", "async"]},
    "return_kind": {"enum": ["value", "async_iterator", "async_generator"]},
    "classification": {"enum": ["pure", "effectful", "never"]},
    "clause_ids": {"type": "array", "items": {"type": "string"}},
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "role"],
        "additionalProperties": false,
        "properties": {
          "clause_id": {"type": "string", "pattern": "^(ensures|error):[0-9]+$"},
          "role": {"enum": ["success", "conditional_error"]}
        }
      }
    },
    "scenario": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scenario"}]}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start_byte", "end_byte", "start_line", "start_column", "end_line", "end_column"],
      "additionalProperties": false,
      "properties": {
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1}
      }
    },
    "data": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["text", "bytes"]},
        "value": {"type": "string"}
      }
    },
    "outcome": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["response", "redirect", "delay", "disconnect"]},
        "body": {"$ref": "#/$defs/data"},
        "encoding": {"enum": ["utf-8", "utf8", "ascii", "latin-1"]},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "location": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]*$"},
        "milliseconds": {"type": "integer", "minimum": 0}
      }
    },
    "file": {
      "type": "object",
      "required": ["data", "path", "source_order", "span"],
      "additionalProperties": false,
      "properties": {
        "data": {"$ref": "#/$defs/data"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "source_order": {"type": "integer", "minimum": 0},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "route": {
      "type": "object",
      "required": ["outcome", "path", "source_order", "span"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"$ref": "#/$defs/outcome"},
        "path": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]*$"},
        "source_order": {"type": "integer", "minimum": 0},
        "span": {"$ref": "#/$defs/span"}
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "kind", "source_order", "span"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["fs", "http", "clock", "failure"]},
        "source_order": {"type": "integer", "minimum": 0},
        "span": {"$ref": "#/$defs/span"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
        "start_ms": {"type": "integer", "minimum": 0},
        "tick_ms": {"type": "integer", "minimum": 0},
        "point": {"enum": ["file.open", "file.read", "file.write", "file.flush", "file.replace", "http.connect", "http.read", "clock.read"]},
        "occurrence": {"type": "integer", "minimum": 1},
        "error": {"enum": ["permission_denied", "not_found", "disk_full", "timeout", "connection_reset"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "fs"}}, "required": ["kind"]}, "then": {"required": ["files"]}},
        {"if": {"properties": {"kind": {"const": "http"}}, "required": ["kind"]}, "then": {"required": ["routes"]}},
        {"if": {"properties": {"kind": {"const": "clock"}}, "required": ["kind"]}, "then": {"required": ["start_ms", "tick_ms"]}},
        {"if": {"properties": {"kind": {"const": "failure"}}, "required": ["kind"]}, "then": {"required": ["point", "occurrence", "error"]}}
      ]
    },
    "expression": {"type":"object","required":["kind","span","type"],"additionalProperties":false,"properties":{"kind":{"enum":["literal","parameter_ref","binding_ref","self_ref","constant_ref","enum_singleton_ref","field","len","unary","binary","comparison_chain","result_ref","old_state_field","intrinsic","fixture_path","fixture_url","construct","variant","option_some","result_ok","result_err","list","set","tuple","array","map","match","dyn"]},"trait_ref":{"$ref":"#/$defs/tn"},"value":{"oneOf":[{"$ref":"#/$defs/value"},{"$ref":"#/$defs/expression"}]},"symbol":{"type":"string"},"base":{"$ref":"#/$defs/expression"},"name":{"type":"string"},"operand":{"$ref":"#/$defs/expression"},"op":{"type":"string"},"left":{"$ref":"#/$defs/expression"},"right":{"$ref":"#/$defs/expression"},"operands":{"type":"array","items":{"$ref":"#/$defs/expression"}},"operators":{"type":"array","items":{"type":"string"}},"reference":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/reference"}]},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"field":{"type":"string"},"arguments":{"type":"array","items":{"$ref":"#/$defs/expression"}},"selector":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/selector"}]},"dependencies":{"$ref":"#/$defs/selector"},"fixture":{"type":"string"},"path":{"type":"string"},"fields":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/expression"},{"$ref":"#/$defs/construct_field"}]}},"payload":{"$ref":"#/$defs/expression"},"items":{"type":"array","items":{"$ref":"#/$defs/expression"}},"entries":{"type":"array","items":{"$ref":"#/$defs/map_entry"}},"condition":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/expression"}]},"pattern":{"$ref":"#/$defs/pattern"},"scrutinee":{"$ref":"#/$defs/expression"}},"allOf":[{"if":{"properties":{"kind":{"const":"dyn"}},"required":["kind"]},"then":{"type":"object","required":["kind","trait_ref","value","type","span"],"additionalProperties":false,"properties":{"kind":{"const":"dyn"},"trait_ref":{"$ref":"#/$defs/tn"},"value":{"$ref":"#/$defs/expression"},"type":{"$ref":"#/$defs/tdyn"},"span":{"$ref":"#/$defs/span"}}},"else":{"required":["reference"]}},{"if":{"properties":{"kind":{"const":"old_state_field"}},"required":["kind"]},"then":{"type":"object","required":["field","kind","reference","span","type"],"additionalProperties":false,"properties":{"field":{"type":"string"},"kind":{"const":"old_state_field"},"reference":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/reference"}]},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"}}}},{"if":{"properties":{"kind":{"const":"construct"}},"required":["kind"]},"then":{"required":["fields","symbol"],"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/construct_field"}}}}},{"if":{"properties":{"kind":{"const":"variant"}},"required":["kind"]},"then":{"required":["fields","symbol"],"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/expression"}}}}},{"if":{"properties":{"kind":{"enum":["option_some","result_ok","result_err"]}},"required":["kind"]},"then":{"required":["payload"]}},{"if":{"properties":{"kind":{"enum":["list","set","tuple","array"]}},"required":["kind"]},"then":{"required":["items"]}},{"if":{"properties":{"kind":{"const":"map"}},"required":["kind"]},"then":{"required":["entries"]}},{"if":{"properties":{"kind":{"const":"match"}},"required":["kind"]},"then":{"required":["condition","pattern","scrutinee"]}}]},
    "const_argument": {"oneOf":[{"$ref":"#/$defs/const_value"},{"$ref":"#/$defs/const_parameter"},{"$ref":"#/$defs/const_reference"},{"$ref":"#/$defs/const_binary"}]},
    "const_binary": {"type":"object","required":["kind","left","op","right","type"],"additionalProperties":false,"properties":{"kind":{"const":"binary"},"left":{"$ref":"#/$defs/const_argument"},"op":{"enum":["add","subtract","multiply","divide","remainder"]},"right":{"$ref":"#/$defs/const_argument"},"type":{"$ref":"#/$defs/const_domain"}}},
    "const_domain": {"enum":["U8","U16","U32","U64"]},
    "const_parameter": {"type":"object","required":["kind","name","type"],"additionalProperties":false,"properties":{"kind":{"const":"parameter"},"name":{"type":"string"},"type":{"$ref":"#/$defs/const_domain"}}},
    "const_reference": {"type":"object","required":["kind","symbol","type"],"additionalProperties":false,"properties":{"kind":{"const":"reference"},"symbol":{"type":"string"},"type":{"$ref":"#/$defs/const_domain"}}},
    "const_value": {"type":"object","required":["kind","type","value"],"additionalProperties":false,"properties":{"kind":{"const":"value"},"type":{"$ref":"#/$defs/const_domain"},"value":{"type":"integer","minimum":0}}},
    "construct_field": {"type":"object","required":["name","value"],"additionalProperties":false,"properties":{"name":{"type":"string"},"value":{"$ref":"#/$defs/expression"}}},
    "generic_arg": {"oneOf":[{"$ref":"#/$defs/generic_type_arg"},{"$ref":"#/$defs/generic_const_arg"}]},
    "generic_const_arg": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"const"},"value":{"$ref":"#/$defs/const_argument"}}},
    "generic_type_arg": {"type":"object","required":["kind","type"],"additionalProperties":false,"properties":{"kind":{"const":"type"},"type":{"$ref":"#/$defs/type"}}},
    "map_entry": {"type":"object","required":["key","value"],"additionalProperties":false,"properties":{"key":{"$ref":"#/$defs/expression"},"value":{"$ref":"#/$defs/expression"}}},
    "pattern": {"oneOf":[{"type":"object","required":["kind","span","type"],"additionalProperties":false,"properties":{"kind":{"const":"wildcard"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"}}},{"type":"object","required":["kind","span","type","name","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"binding"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"name":{"type":"string"},"symbol":{"type":"string"}}},{"type":"object","required":["kind","span","type","arguments","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"result_ok"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"arguments":{"type":"array","items":{"$ref":"#/$defs/pattern"}},"symbol":{"type":"string"}}},{"type":"object","required":["kind","span","type","arguments","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"result_err"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"arguments":{"type":"array","items":{"$ref":"#/$defs/pattern"}},"symbol":{"type":"string"}}},{"type":"object","required":["kind","span","type","arguments","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"option_some"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"arguments":{"type":"array","items":{"$ref":"#/$defs/pattern"}},"symbol":{"type":"string"}}},{"type":"object","required":["kind","span","type","arguments","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"option_none"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"arguments":{"type":"array","items":{"$ref":"#/$defs/pattern"}},"symbol":{"type":"string"}}},{"type":"object","required":["kind","span","type","arguments","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"enum"},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"},"arguments":{"type":"array","items":{"$ref":"#/$defs/pattern"}},"symbol":{"type":"string"}}}]},
    "reference": {"type":"object","required":["kind","symbol"],"additionalProperties":false,"properties":{"kind":{"enum":["parameter","binding","constant","enum_singleton","field","old_state_field"]},"symbol":{"type":"string"}}},
    "scenario_receiver": {"type":"object","required":["kind","symbol","reference","span","type"],"additionalProperties":false,"properties":{"kind":{"const":"binding_ref"},"symbol":{"type":"string"},"reference":{"type":"object","required":["kind","symbol"],"additionalProperties":false,"properties":{"kind":{"const":"binding"},"symbol":{"type":"string"}}},"span":{"$ref":"#/$defs/span"},"type":{"$ref":"#/$defs/type"}}},
    "selector": {"type":"object","required":["owner","field"],"additionalProperties":false,"properties":{"owner":{"type":"string"},"field":{"type":"string"}}},
    "tarray": {"type":"object","required":["item","kind","length"],"additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/type"},"kind":{"const":"array"},"length":{"$ref":"#/$defs/const_argument"}}},
    "tassociated_projection": {"type":"object","required":["base","kind","name","trait"],"additionalProperties":false,"properties":{"base":{"$ref":"#/$defs/type"},"kind":{"const":"associated_projection"},"name":{"type":"string"},"trait":{"type":"string"}}},
    "tasync_generator": {"type":"object","required":["kind","yield","send"],"additionalProperties":false,"properties":{"kind":{"const":"async_generator"},"yield":{"$ref":"#/$defs/type"},"send":{"$ref":"#/$defs/type"}}},
    "tasync_iterator": {"type":"object","required":["kind","item"],"additionalProperties":false,"properties":{"kind":{"const":"async_iterator"},"item":{"$ref":"#/$defs/type"}}},
    "tbuffer": {"type":"object","required":["kind","length"],"additionalProperties":false,"properties":{"kind":{"const":"buffer"},"length":{"$ref":"#/$defs/const_argument"}}},
    "tdyn": {"type":"object","required":["kind","trait"],"additionalProperties":false,"properties":{"kind":{"const":"dyn"},"trait":{"$ref":"#/$defs/tn"}}},
    "tfactory": {"type":"object","required":["instance","kind"],"additionalProperties":false,"properties":{"instance":{"$ref":"#/$defs/tn"},"kind":{"const":"factory"}}},
    "tgenerator": {"type":"object","required":["kind","yield","send","return"],"additionalProperties":false,"properties":{"kind":{"const":"generator"},"yield":{"$ref":"#/$defs/type"},"send":{"$ref":"#/$defs/type"},"return":{"$ref":"#/$defs/type"}}},
    "titerator": {"type":"object","required":["kind","item"],"additionalProperties":false,"properties":{"kind":{"const":"iterator"},"item":{"$ref":"#/$defs/type"}}},
    "tlist": {"type":"object","required":["item","kind"],"additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/type"},"kind":{"const":"list"}}},
    "tmap": {"type":"object","required":["key","kind","value"],"additionalProperties":false,"properties":{"key":{"$ref":"#/$defs/type"},"kind":{"const":"map"},"value":{"$ref":"#/$defs/type"}}},
    "tn": {"type":"object","required":["args","kind","name"],"additionalProperties":false,"properties":{"args":{"type":"array","items":{"$ref":"#/$defs/generic_arg"}},"kind":{"const":"named"},"name":{"type":"string"}}},
    "topaque": {"type":"object","required":["kind","tag"],"additionalProperties":false,"properties":{"kind":{"const":"opaque"},"tag":{"type":"string"}}},
    "toption": {"type":"object","required":["item","kind"],"additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/type"},"kind":{"const":"option"}}},
    "tp": {"type":"object","required":["kind","name"],"additionalProperties":false,"properties":{"kind":{"const":"primitive"},"name":{"enum":["bool","i8","i16","i32","i64","u8","u16","u32","u64","f32","f64","str","bytes","path","unit","json","never","any","unknown"]}}},
    "tparam": {"type":"object","required":["kind","name"],"additionalProperties":false,"properties":{"kind":{"const":"type_parameter"},"name":{"type":"string"}}},
    "tresult": {"type":"object","required":["error","kind","ok"],"additionalProperties":false,"properties":{"error":{"$ref":"#/$defs/type"},"kind":{"const":"result"},"ok":{"$ref":"#/$defs/type"}}},
    "tset": {"type":"object","required":["item","kind"],"additionalProperties":false,"properties":{"item":{"$ref":"#/$defs/type"},"kind":{"const":"set"}}},
    "ttuple": {"type":"object","required":["items","kind"],"additionalProperties":false,"properties":{"items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/type"}},"kind":{"const":"tuple"}}},
    "type": {"oneOf":[{"$ref":"#/$defs/tp"},{"$ref":"#/$defs/tn"},{"$ref":"#/$defs/tparam"},{"$ref":"#/$defs/tlist"},{"$ref":"#/$defs/tset"},{"$ref":"#/$defs/tmap"},{"$ref":"#/$defs/ttuple"},{"$ref":"#/$defs/tarray"},{"$ref":"#/$defs/tbuffer"},{"$ref":"#/$defs/toption"},{"$ref":"#/$defs/tresult"},{"$ref":"#/$defs/topaque"},{"$ref":"#/$defs/titerator"},{"$ref":"#/$defs/tgenerator"},{"$ref":"#/$defs/tasync_iterator"},{"$ref":"#/$defs/tasync_generator"},{"$ref":"#/$defs/tfactory"},{"$ref":"#/$defs/tassociated_projection"},{"$ref":"#/$defs/tdyn"}]},
    "value": {"oneOf":[{"$ref":"#/$defs/vbool"},{"$ref":"#/$defs/vint"},{"$ref":"#/$defs/vfloat"},{"$ref":"#/$defs/vstr"},{"$ref":"#/$defs/vbytes"},{"$ref":"#/$defs/vunit"},{"$ref":"#/$defs/voption"},{"$ref":"#/$defs/vresult"},{"$ref":"#/$defs/vlist"},{"$ref":"#/$defs/vset"},{"$ref":"#/$defs/vmap"},{"$ref":"#/$defs/vtuple"},{"$ref":"#/$defs/varray"},{"$ref":"#/$defs/vbuffer"},{"$ref":"#/$defs/vnamed"},{"$ref":"#/$defs/venum"},{"$ref":"#/$defs/vjson"}]},
    "varray": {"type":"object","required":["items","kind"],"additionalProperties":false,"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/value"}},"kind":{"const":"array"}}},
    "vbool": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"bool"},"value":{"type":"boolean"}}},
    "vbuffer": {"type":"object","required":["hex","kind"],"additionalProperties":false,"properties":{"hex":{"type":"string","pattern":"^(?:[0-9a-f]{2})*$"},"kind":{"const":"buffer"}}},
    "vbytes": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"bytes"},"value":{"type":"string","pattern":"^(?:[0-9a-f]{2})*$"}}},
    "venum": {"type":"object","required":["fields","kind","variant"],"additionalProperties":false,"properties":{"fields":{"type":"array","items":{"$ref":"#/$defs/value"}},"kind":{"const":"enum"},"variant":{"type":"string"}}},
    "vfloat": {"type":"object","required":["bits","kind"],"additionalProperties":false,"properties":{"bits":{"type":"string"},"kind":{"enum":["f32","f64"]}}},
    "vint": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"integer"},"value":{"type":"string"}}},
    "vjson": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"json"},"value":{}}},
    "vlist": {"type":"object","required":["items","kind"],"additionalProperties":false,"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/value"}},"kind":{"const":"list"}}},
    "vmap": {"type":"object","required":["entries","kind"],"additionalProperties":false,"properties":{"entries":{"type":"array","items":{"type":"array","prefixItems":[{"$ref":"#/$defs/value"},{"$ref":"#/$defs/value"}],"items":false}},"kind":{"const":"map"}}},
    "vnamed": {"type":"object","required":["fields","kind","symbol"],"additionalProperties":false,"properties":{"fields":{"type":"array","items":{"type":"object","required":["name","value"],"additionalProperties":false,"properties":{"name":{"type":"string"},"value":{"$ref":"#/$defs/value"}}}},"kind":{"const":"named"},"symbol":{"type":"string"}}},
    "voption": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"option"},"value":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/value"}]}}},
    "vresult": {"type":"object","required":["kind","ok","value"],"additionalProperties":false,"properties":{"kind":{"const":"result"},"ok":{"type":"boolean"},"value":{"$ref":"#/$defs/value"}}},
    "vset": {"type":"object","required":["items","kind"],"additionalProperties":false,"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/value"}},"kind":{"const":"set"}}},
    "vstr": {"type":"object","required":["kind","value"],"additionalProperties":false,"properties":{"kind":{"const":"string"},"value":{"type":"string"}}},
    "vtuple": {"type":"object","required":["items","kind"],"additionalProperties":false,"properties":{"items":{"type":"array","items":{"$ref":"#/$defs/value"}},"kind":{"const":"tuple"}}},
    "vunit": {"type":"object","required":["kind"],"additionalProperties":false,"properties":{"kind":{"const":"unit"}}},
    "step": {
      "type": "object",
      "required": ["kind", "step_id", "span"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["call", "init", "method_call", "spawn", "await", "cancel", "tick", "assert", "data"]},
        "step_id": {"type": "integer", "minimum": 0, "maximum": 63},
        "span": {"$ref": "#/$defs/span"},
        "arguments": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "receiver": {"$ref": "#/$defs/scenario_receiver"},
        "binding": {"type": "string"},
        "callable_kind": {"enum": ["sync", "async"]},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/type"}},
        "return_type": {"$ref": "#/$defs/type"},
        "target": {"type": "string"},
        "worker": {"type": "string"},
        "result": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "cancelled": {"type": "boolean"},
        "expression": {"$ref": "#/$defs/expression"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "call"}}, "required": ["kind"]}, "then": {"required": ["arguments", "binding", "callable_kind", "parameters", "return_type", "target"]}},
        {"if": {"properties": {"kind": {"const": "init"}}, "required": ["kind"]}, "then": {"required": ["arguments", "binding", "parameters", "return_type", "target"], "properties": {"receiver": false, "callable_kind": false, "worker": false, "result": false, "cancelled": false, "expression": false}}},
        {"if": {"properties": {"kind": {"const": "method_call"}}, "required": ["kind"]}, "then": {"required": ["arguments", "binding", "callable_kind", "parameters", "receiver", "return_type", "target"], "properties": {"worker": false, "result": false, "cancelled": false, "expression": false}}},
        {"if": {"properties": {"kind": {"const": "method_call"}}, "required": ["kind"]}, "else": {"properties": {"receiver": false}}},
        {"if": {"properties": {"kind": {"const": "spawn"}}, "required": ["kind"]}, "then": {"required": ["arguments", "parameters", "return_type", "target", "worker"]}},
        {"if": {"properties": {"kind": {"const": "await"}}, "required": ["kind"]}, "then": {"required": ["cancelled", "result", "return_type", "worker"]}},
        {"if": {"properties": {"kind": {"const": "cancel"}}, "required": ["kind"]}, "then": {"required": ["worker"]}},
        {"if": {"properties": {"kind": {"const": "assert"}}, "required": ["kind"]}, "then": {"required": ["expression"]}},
        {"if": {"properties": {"kind": {"const": "data"}}, "required": ["kind"]}, "then": {"required": ["binding", "expression"]}}
      ]
    },
    "limits": {
      "type": "object",
      "required": ["scenario_timeout_ms", "filesystem_bytes", "filesystem_files", "http_body_bytes", "http_requests", "http_redirects", "transcript_events"],
      "additionalProperties": false,
      "properties": {
        "scenario_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "filesystem_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "filesystem_files": {"type": "integer", "minimum": 1, "maximum": 4096},
        "http_body_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "http_requests": {"type": "integer", "minimum": 1, "maximum": 1024},
        "http_redirects": {"type": "integer", "minimum": 1, "maximum": 64},
        "transcript_events": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "required_effects", "fixtures", "steps", "lifecycle_limit", "limits"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "required_effects": {"type": "array", "items": {"type": "string"}},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
        "steps": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/step"}},
        "lifecycle_limit": {"type": "integer", "minimum": 1, "maximum": 64},
        "limits": {"$ref": "#/$defs/limits"}
      }
    }
  }
}
