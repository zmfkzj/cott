{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cott.dev/schema/generation/v7",
  "title": "cott generation record v7",
  "type": "object",
  "required": ["schema_version", "current", "last_verified"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 7},
    "current": {"$ref": "#/$defs/snapshot"},
    "last_verified": {"anyOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["generation_id", "verified", "project_version", "compatibility", "inputs", "tools", "ir", "contract_surface", "public_python_symbols", "implementations", "dependencies", "managed_files", "unresolved", "verification", "semantic_coverage", "agent_runs"],
      "additionalProperties": false,
      "properties": {
        "generation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "verified": {"type": "boolean"},
        "project_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "tools": {"type": "object"},
        "ir": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "contract_surface": {"type": "object"},
        "public_python_symbols": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "implementations": {"type": "array", "items": {"$ref": "#/$defs/implementation"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "managed_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
        "verification": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "properties": {
                "implementation_comparison": {"$ref": "#/$defs/implementation_comparison"}
              },
              "additionalProperties": true
            }
          ]
        },
        "semantic_coverage": {"$ref": "#/$defs/semantic_coverage"},
        "agent_runs": {"type": "array"}
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["generation_schema", "canonical_ir_schema", "runtime_abi", "contract_strategy_schema"],
      "additionalProperties": false,
      "properties": {
        "generation_schema": {"const": 7},
        "canonical_ir_schema": {"const": 8},
        "runtime_abi": {"const": 7},
        "contract_strategy_schema": {"const": 5}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["cott_symbol", "kind", "callable_kind", "concrete", "method", "selection", "owner", "python_symbol", "source_origin", "runtime_origin", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "cott_symbol": {"type": "string"},
        "kind": {"enum": ["function", "async_function", "impl_method", "async_impl_method"]},
        "callable_kind": {"enum": ["sync", "async"]},
        "concrete": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "method": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "selection": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/dispatch_selection"}]},
        "owner": {"enum": ["manifest", "agent"]},
        "python_symbol": {"type": "string"},
        "source_origin": {"type": "string"},
        "runtime_origin": {"type": "string"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "function"}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "sync"}, "concrete": {"type": "null"}, "method": {"type": "null"}, "selection": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "async_function"}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "async"}, "concrete": {"type": "null"}, "method": {"type": "null"}, "selection": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "impl_method"}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "sync"}, "concrete": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "selection": {"$ref": "#/$defs/dispatch_selection"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "async_impl_method"}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "async"}, "concrete": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "selection": {"$ref": "#/$defs/dispatch_selection"}}}
        }
      ]
    },
    "dispatch_selection": {
      "type": "object",
      "required": ["kind", "trait_method"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "explicit"},
        "trait_method": {"type": "string", "minLength": 1}
      }
    },
    "source_span": {
      "type": "object",
      "required": ["start_byte", "end_byte", "start_line", "start_column", "end_line", "end_column"],
      "additionalProperties": false,
      "properties": {
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1}
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["cott_symbol", "kind", "callable_kind", "span"],
      "additionalProperties": false,
      "properties": {
        "cott_symbol": {"type": "string"},
        "kind": {"enum": ["function", "async_function", "impl_method", "async_impl_method"]},
        "callable_kind": {"enum": ["sync", "async"]},
        "span": {"$ref": "#/$defs/source_span"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["function", "impl_method"]}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "sync"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["async_function", "async_impl_method"]}}, "required": ["kind"]},
          "then": {"properties": {"callable_kind": {"const": "async"}}}
        }
      ]
    },
    "dependency": {
      "type": "object",
      "required": ["name", "version", "lock_hash", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "lock_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "uniqueItems": true
        },
        "installed": {"type": "object"}
      }
    },
    "implementation_comparison": {
      "type": "object",
      "required": ["baseline_generation_id", "status", "entries"],
      "additionalProperties": false,
      "properties": {
        "baseline_generation_id": {
          "anyOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["no_baseline", "compared"]},
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/implementation_comparison_entry"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "no_baseline"}}, "required": ["status"]},
          "then": {
            "properties": {
              "baseline_generation_id": {"type": "null"},
              "entries": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "baseline_generation_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "implementation_comparison_entry": {
      "type": "object",
      "required": ["cott_symbol", "status", "changed_fields"],
      "additionalProperties": false,
      "properties": {
        "cott_symbol": {"type": "string"},
        "status": {"enum": ["added", "removed", "unchanged", "changed"]},
        "changed_fields": {
          "type": "object",
          "properties": {
            "callable_kind": {"$ref": "#/$defs/implementation_field_change"},
            "content_hash": {"$ref": "#/$defs/implementation_field_change"},
            "concrete": {"$ref": "#/$defs/implementation_field_change"},
            "kind": {"$ref": "#/$defs/implementation_field_change"},
            "method": {"$ref": "#/$defs/implementation_field_change"},
            "owner": {"$ref": "#/$defs/implementation_field_change"},
            "python_symbol": {"$ref": "#/$defs/implementation_field_change"},
            "runtime_origin": {"$ref": "#/$defs/implementation_field_change"},
            "source_origin": {"$ref": "#/$defs/implementation_field_change"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unchanged"}}, "required": ["status"]},
          "then": {"properties": {"changed_fields": {"maxProperties": 0}}},
          "else": {"properties": {"changed_fields": {"minProperties": 1}}}
        }
      ]
    },
    "implementation_field_change": {
      "type": "object",
      "required": ["before", "after"],
      "additionalProperties": false,
      "properties": {
        "before": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "after": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "semantic_coverage": {
      "type": "object",
      "required": ["clauses", "summary", "policy"],
      "additionalProperties": false,
      "properties": {
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause_coverage"}},
        "summary": {"$ref": "#/$defs/coverage_summary"},
        "policy": {"$ref": "#/$defs/coverage_policy_result"}
      }
    },
    "clause_coverage": {
      "type": "object",
      "required": ["symbol", "clause_id", "span", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "clause_id": {"type": "string", "pattern": "^(?:(?:requires|ensures|error|invariant):(0|[1-9][0-9]*)|modifies:[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)$"},
        "span": {"$ref": "#/$defs/source_span"},
        "status": {"$ref": "#/$defs/coverage_status"},
        "evidence": {"type": "array", "items": {}}
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["observed", "unobserved", "trust_declaration", "unknown"],
      "additionalProperties": false,
      "properties": {
        "observed": {"type": "integer", "minimum": 0},
        "unobserved": {"type": "integer", "minimum": 0},
        "trust_declaration": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "coverage_policy_result": {
      "type": "object",
      "required": ["selected", "passed", "violations"],
      "additionalProperties": false,
      "properties": {
        "selected": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"},
        "violations": {"type": "array", "items": {"$ref": "#/$defs/coverage_violation"}}
      }
    },
    "coverage_violation": {
      "type": "object",
      "required": ["symbol", "clause_id", "span", "status", "reason"],
      "additionalProperties": false,
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "clause_id": {"type": "string", "pattern": "^(?:(?:requires|ensures|error|invariant):(0|[1-9][0-9]*)|modifies:[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*)$"},
        "span": {"$ref": "#/$defs/source_span"},
        "status": {"$ref": "#/$defs/coverage_status"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "coverage_status": {
      "enum": ["observed", "unobserved", "trust_declaration", "unknown"]
    }
  }
}
