{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cott.dev/schema/generation/v1",
  "title": "cott generation record",
  "type": "object",
  "required": ["schema_version", "current", "last_verified"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "current": {"$ref": "#/$defs/snapshot"},
    "last_verified": {"anyOf": [{"$ref": "#/$defs/snapshot"}, {"type": "null"}]}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": ["generation_id", "verified", "inputs", "tools", "ir", "contract_surface", "public_python_symbols", "implementations", "dependencies", "managed_files", "unresolved", "verification", "agent_runs"],
      "additionalProperties": false,
      "properties": {
        "generation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "verified": {"type": "boolean"},
        "inputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "tools": {"type": "object"},
        "ir": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "contract_surface": {"type": "object"},
        "public_python_symbols": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "implementations": {"type": "array", "items": {"$ref": "#/$defs/implementation"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "managed_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "verification": {"anyOf": [{"type": "object"}, {"type": "null"}]},
        "agent_runs": {"type": "array"}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["cott_symbol", "owner", "python_symbol", "source_origin", "runtime_origin", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "cott_symbol": {"type": "string"},
        "kind": {"enum": ["function", "impl_method"]},
        "concrete": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "method": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "owner": {"enum": ["manifest", "agent"]},
        "python_symbol": {"type": "string"},
        "source_origin": {"type": "string"},
        "runtime_origin": {"type": "string"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [
        {
          "not": {
            "anyOf": [
              {"required": ["kind"]},
              {"required": ["concrete"]},
              {"required": ["method"]}
            ]
          }
        },
        {
          "required": ["kind", "concrete", "method"]
        }
      ],
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "function"}}, "required": ["kind"]},
          "then": {"properties": {"concrete": {"type": "null"}, "method": {"type": "null"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "impl_method"}}, "required": ["kind"]},
          "then": {"properties": {"concrete": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "dependency": {
      "type": "object",
      "required": ["name", "version", "lock_hash", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "lock_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifacts": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "uniqueItems": true
        },
        "installed": {"type": "object"}
      }
    }
  }
}
