module curriculum.portfolio_cost

const MAX_F64: F64 = 1.7976931348623157e308

struct Holding:
    shares: I64
    price: F64

enum PortfolioError:
    NegativeShares
    NonFinitePrice
    NegativePrice
    TotalOverflow

fn calculate_portfolio_cost(rows: List[Holding]) -> Result[F64, PortfolioError]:
    doc """
    Computes the total market value of a portfolio: the sum of shares times
    price over its holdings.
    
    Holdings are examined one at a time in list order, and the first failing
    holding decides the error. A holding fails with NegativeShares when its
    share count is negative, otherwise with NonFinitePrice when its price is
    NaN or infinite, otherwise with NegativePrice when its price is below zero.
    Zero shares, signed-zero prices and an empty list are accepted.
    
    The running total starts at 0.0. For each accepted holding, the share count
    is converted to the nearest binary64 value and multiplied by the price, and
    the product is added to the running total; every operation is binary64,
    rounded to nearest, ties to even. If the product or the new running total
    is not finite, TotalOverflow is returned at that holding, before later
    holdings are examined.
    
    On Kotlin the F64 boundary rejects NaN and infinite prices before the call,
    so NonFinitePrice is never returned.
    """

    ensures Result.Ok(total) => 0.0 <= total <= MAX_F64

    error PortfolioError.NegativeShares
    error PortfolioError.NonFinitePrice
    error PortfolioError.NegativePrice
    error PortfolioError.TotalOverflow

scenario holdings_are_summed:
    call total = calculate_portfolio_cost(
        List(
            Holding(shares: 10, price: 2.5),
            Holding(shares: 0, price: 7.0),
            Holding(shares: 4, price: 0.25),
        ),
    )
    assert total matches Result.Ok(value) => value == 26.0

scenario first_failing_holding_decides:
    call earlier_price = calculate_portfolio_cost(
        List(Holding(shares: 2, price: -1.0), Holding(shares: -1, price: 5.0)),
    )
    assert earlier_price matches Result.Err(PortfolioError.NegativePrice)
    call shares_first = calculate_portfolio_cost(
        List(Holding(shares: -1, price: -1.0)),
    )
    assert shares_first matches Result.Err(PortfolioError.NegativeShares)

scenario overflow_is_reported_at_its_holding:
    call product = calculate_portfolio_cost(List(Holding(shares: 2, price: 1.0e308)))
    assert product matches Result.Err(PortfolioError.TotalOverflow)
    call running_total = calculate_portfolio_cost(
        List(
            Holding(shares: 1, price: 1.0e308),
            Holding(shares: 1, price: 1.0e308),
            Holding(shares: -1, price: 1.0),
        ),
    )
    assert running_total matches Result.Err(PortfolioError.TotalOverflow)

requirement TOTAL_IS_SUM_OF_HOLDING_VALUES for calculate_portfolio_cost:
    text "A portfolio of valid holdings returns the sum of shares times price accumulated from 0.0 in list order, or TotalOverflow when a product or the running total is not finite."
    checked_by holdings_are_summed
    checked_by overflow_is_reported_at_its_holding assert 1

requirement FIRST_FAILING_HOLDING_DECIDES for calculate_portfolio_cost:
    text "The first failing holding in list order decides the error: shares are checked before price, and TotalOverflow at a holding precedes errors in later holdings."
    checked_by first_failing_holding_decides
    checked_by overflow_is_reported_at_its_holding assert 2
