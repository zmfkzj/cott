module foo.bar

const MAX_PAYLOAD_SIZE: U32 = 8192

newtype Probability(F32)
    where 0.0 <= self <= 1.0

newtype PayloadSize(U32)
    where 1 <= self <= MAX_PAYLOAD_SIZE

enum PayloadFormat:
    Raw
    Text
    Structured

struct InputPayload:
    data: Bytes
    declared_size: PayloadSize
    format: PayloadFormat

struct OutputPayload:
    data: Bytes
    source_size: PayloadSize
    format: PayloadFormat

enum BarError:
    InvalidPayload(reason: Str)

struct BarOptions:
    threshold: Probability = Probability(0.5)
    use_cache: Bool = false

fn validate_payload(data: InputPayload) -> Result[InputPayload, BarError]:
    doc """
    Reject a payload without bytes. declared_size is caller-supplied metadata
    carried to the output; it is not compared with the byte count.
    """

    ensures Result.Ok(validated) => validated.data == data.data
    ensures Result.Ok(validated) => validated.declared_size == data.declared_size
    ensures Result.Ok(validated) => validated.format == data.format

    error BarError.InvalidPayload when data.data.len == 0

    effects []

fn process_payload_bytes(data: Bytes, options: BarOptions) -> Result[Bytes, BarError]:
    doc """
    The byte-processing stage of this fixture is the identity: it always
    succeeds with the input bytes, whatever the options.
    """

    ensures Result.Ok(processed) => processed == data

    errors complete

    effects []

fn build_output(data: Bytes, source_size: PayloadSize, format: PayloadFormat) -> OutputPayload:
    doc """
    Construct output from processed bytes and the original payload metadata.
    """

    ensures result.data == data
    ensures result.source_size == source_size
    ensures result.format == format

    effects []

fn process_bar(data: InputPayload, options: BarOptions) -> Result[OutputPayload, BarError]:
    doc """
    Domain-named operation of the fixture: validate the payload, process its
    bytes, then build the output from the processed bytes and the validated
    metadata.
    """

    ensures Result.Ok(output) => output.data == data.data
    ensures Result.Ok(output) => output.source_size == data.declared_size
    ensures Result.Ok(output) => output.format == data.format

    errors complete
    error BarError.InvalidPayload when data.data.len == 0

    effects []

scenario process_bar_composes_stages:
    call out = process_bar(
        InputPayload(data: Bytes("6869"), declared_size: PayloadSize(2), format: PayloadFormat.Raw),
        BarOptions(),
    )
    assert out == Result.Ok(
        value: OutputPayload(
            data: Bytes("6869"),
            source_size: PayloadSize(2),
            format: PayloadFormat.Raw,
        ),
    )
    call empty = process_bar(
        InputPayload(data: Bytes(""), declared_size: PayloadSize(1), format: PayloadFormat.Text),
        BarOptions(),
    )
    assert empty matches Result.Err(BarError.InvalidPayload(_))

requirement STAGES_COMPOSE_THROUGH_FACADES for process_bar:
    text "process_bar calls the public validate_payload facade with data, then process_payload_bytes with the validated bytes and options, then build_output with the processed bytes and the validated declared_size and format; the first Err is returned unchanged and later stages are not called."
    checked_by process_bar_composes_stages
