yError.DuplicateRate"},{"fields":[],"name":"MissingRate","symbol":"curriculum.currency_converter.CurrencyError.MissingRate"},{"fields":[],"name":"NonFiniteResult","symbol":"curriculum.currency_converter.CurrencyError.NonFiniteResult"}]},{"annotations":[],"body":null,"callable_kind":"sync","contract":{"clauses":[{"clause_id":1,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonFiniteQuantity","when":null},{"clause_id":2,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NegativeQuantity","when":null},{"clause_id":3,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.InvalidCurrencyCode","when":null},{"clause_id":4,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonFiniteRate","when":null},{"clause_id":5,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonPositiveRate","when":null},{"clause_id":6,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.DuplicateRate","when":null},{"clause_id":7,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.MissingRate","when":null}],"effects":[]},"doc":{"text":"Validates a currency conversion request and its complete EUR rate list,\nreturning Ok(Unit) when every rule is satisfied.\n\nThe source code, destination code, and every rate code must contain exactly\nthree ASCII uppercase letters A through Z. Codes are case-sensitive and\nare not trimmed. The quantity must be finite and non-negative; negative\nzero is accepted. Every per-EUR rate must be finite and strictly positive.\n\nA non-finite quantity is reported before a negative quantity. The source\ncode is checked before the destination code. Rates are then checked in list\norder; within each rate, its code is checked before a non-finite value, a\nnon-positive value, and a duplicate code, in that order. The entire list is\nchecked before missing rates, so DuplicateRate takes priority over\nMissingRate. A missing source rate is checked before a missing destination\nrate. Empty, singleton, and longer lists follow these same rules."},"generics":[],"kind":"function","name":"curriculum.currency_converter.validate_conversion_request","parameters":[{"default":null,"kind":"positional","name":"request","type":{"args":[],"kind":"named","name":"curriculum.currency_converter.ConversionRequest"}}],"public":true,"return_type":{"error":{"args":[],"kind":"named","name":"curriculum.currency_converter.CurrencyError"},"kind":"result","ok":{"kind":"primitive","name":"unit"}}},{"annotations":[],"body":null,"callable_kind":"sync","contract":{"clauses":[{"clause_id":1,"expression":{"kind":"comparison_chain","operands":[{"kind":"binding_ref","reference":{"kind":"binding","symbol":"curriculum.currency_converter.value"},"symbol":"curriculum.currency_converter.value","type":{"kind":"primitive","name":"f64"}},{"kind":"literal","reference":null,"type":{"kind":"primitive","name":"f64"},"value":{"bits":"0000000000000000","kind":"f64"}}],"operators":["greater_equal"],"reference":null,"type":{"kind":"primitive","name":"bool"}},"guard":{"pattern":{"arguments":[{"kind":"binding","name":"value","symbol":"curriculum.currency_converter.value","type":{"kind":"primitive","name":"f64"}}],"kind":"result_ok","symbol":"Result.Ok","type":{"error":{"args":[],"kind":"named","name":"curriculum.currency_converter.CurrencyError"},"kind":"result","ok":{"kind":"primitive","name":"f64"}}},"scrutinee":{"kind":"result_ref","reference":null,"type":{"error":{"args":[],"kind":"named","name":"curriculum.currency_converter.CurrencyError"},"kind":"result","ok":{"kind":"primitive","name":"f64"}}}},"kind":"ensures"},{"clause_id":2,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonFiniteQuantity","when":null},{"clause_id":3,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NegativeQuantity","when":null},{"clause_id":4,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.InvalidCurrencyCode","when":null},{"clause_id":5,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonFiniteRate","when":null},{"clause_id":6,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonPositiveRate","when":null},{"clause_id":7,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.DuplicateRate","when":null},{"clause_id":8,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.MissingRate","when":null},{"clause_id":9,"guard":null,"kind":"error","priority":null,"variant":"curriculum.currency_converter.CurrencyError.NonFiniteResult","when":null}],"effects":[]},"doc":{"text":"Validates the request, propagating its validation error unchanged, then\nconverts the quantity using rates expressed as units of currency per EUR.\n\nWhen the source and destination codes differ, the quantity is divided by\nthe source rate and that result is multiplied by the destination rate,\nusing F64 arithmetic in that order. A non-finite intermediate or product\nreturns NonFiniteResult. When the codes are equal, the fully validated list\nmust still contain that code exactly once, but rate arithmetic is skipped\nand the quantity is used unchanged.\n\nThe successful quantity is rounded to the nearest multiple of 0.01. An\nexact halfway case is rounded to the multiple whose hundredths integer is\neven. Ok contains the resulting finite, non-negative F64 value."},"generics":[],"kind":"function","name":"curriculum.currency_converter.convert_currency","parameters":[{"default":null,"kind":"positional","name":"request","type":{"args":[],"kind":"named","name":"curr