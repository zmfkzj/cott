riority":null,"variant":"curriculum.random_password.PasswordError.InvalidLength","when":{"kind":"binary","left":{"kind":"comparison_chain","operands":[{"kind":"parameter_ref","reference":{"kind":"parameter","symbol":"curriculum.random_password.length"},"symbol":"curriculum.random_password.length","type":{"kind":"primitive","name":"i64"}},{"kind":"literal","reference":null,"type":{"kind":"primitive","name":"i64"},"value":{"kind":"integer","value":"1"}}],"operators":["less"],"reference":null,"type":{"kind":"primitive","name":"bool"}},"op":"or","reference":null,"right":{"kind":"comparison_chain","operands":[{"kind":"parameter_ref","reference":{"kind":"parameter","symbol":"curriculum.random_password.length"},"symbol":"curriculum.random_password.length","type":{"kind":"primitive","name":"i64"}},{"kind":"literal","reference":null,"type":{"kind":"primitive","name":"i64"},"value":{"kind":"integer","value":"128"}}],"operators":["greater"],"reference":null,"type":{"kind":"primitive","name":"bool"}},"type":{"kind":"primitive","name":"bool"}}},{"clause_id":3,"kind":"error","priority":null,"variant":"curriculum.random_password.PasswordError.InsufficientDraws","when":null}],"effects":[]},"doc":{"text":"Validates length before inspecting draws, so a length outside 1 through 128\nreturns InvalidLength even when draws are insufficient. For a valid length\nn, exactly 2n + floor(n / 2) - 1 draws are required; a shorter list returns\nInsufficientDraws without indexing it, and later draws are ignored.\n\nThe password contains floor(n / 2) letters, ceil(3n / 10) digits, and\nn minus those two counts special characters. Draws are consumed as two per\nletter, then one per digit, then one per special character, followed by\nn - 1 shuffle draws. For each letter, the first draw's least nonnegative\nremainder modulo 26 selects from \"abcdefghijklmnopqrstuvwxyz\"; the second\ndraw's remainder modulo 2 chooses lowercase for 0 or uppercase for 1.\nDigit draws select from \"0123456789\" modulo 10, and special-character draws\nselect from \"@#$%&*\" modulo 6.\n\nLetters, digits, and special characters are first concatenated in that\norder. Fisher-Yates then visits indices i from n - 1 down through 1 and\nswaps each with the index selected by the next draw's least nonnegative\nremainder modulo i + 1. Success returns the resulting n-character string."},"generics":[],"kind":"function","name":"curriculum.random_password.generate_password","parameters":[{"default":null,"kind":"positional","name":"length","type":{"kind":"primitive","name":"i64"}},{"default":null,"kind":"positional","name":"draws","type":{"item":{"kind":"primitive","name":"i64"},"kind":"list"}}],"public":true,"return_type":{"error":{"args":[],"kind":"named","name":"curriculum.random_password.PasswordError"},"kind":"result","ok":{"kind":"primitive","name":"str"}}}]}},"dependencies":[],"generation_id":"sha256:6825bd32ada561e776022d66b9ff71f12f7d9b673561808f77d63343a3712344","implementations":[{"concrete":null,"content_hash":"sha256:45cd9803794dce2444234cf43a22951ec4ce137c2c9c7de7004550d36cb58949","cott_symbol":"curriculum.random_password.generate_password","kind":"function","method":null,"owner":"agent","python_symbol":"_cott_impl.curriculum.random_password.generate_password:generate_password","runtime_origin":"python/_cott_impl/curriculum/random_password/generate_password.py","source_origin":"python/_cott_impl/curriculum/random_password/generate_password.py"},{"concrete":null,"content_hash":"sha256:2fb803c2da2aae14e73c6dd503b72a0bc6478642e9229e657c84b8cd6a17dc6e","cott_symbol":"curriculum.random_password.required_password_draws","kind":"function","method":null,"owner":"agent","python_symbol":"_cott_impl.curriculum.random_password.required_password_draws:required_password_draws","runtime_origin":"python/_cott_impl/curriculum/random_password/required_password_draws.py","source_origin":"python/_cott_impl/curriculum/random_password/required_password_draws.py"}],"inputs":{"cott.toml":"sha256:379a194c89190