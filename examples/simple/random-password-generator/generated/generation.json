ces i from n - 1 down through 1 and\nswaps each with the index selected by the next draw's least nonnegative\nremainder modulo i + 1. Success returns the resulting n-character string."},"generics":[],"kind":"function","name":"curriculum.random_password.generate_password","parameters":[{"default":null,"kind":"positional","name":"length","source_order":0,"span":{"end_byte":475,"end_column":33,"end_line":16,"start_byte":464,"start_column":22,"start_line":16},"type":{"kind":"primitive","name":"i64"}},{"default":null,"kind":"positional","name":"draws","source_order":1,"span":{"end_byte":492,"end_column":50,"end_line":16,"start_byte":477,"start_column":35,"start_line":16},"type":{"item":{"kind":"primitive","name":"i64"},"kind":"list"}}],"public":true,"return_type":{"error":{"args":[],"kind":"named","name":"curriculum.random_password.PasswordError"},"kind":"result","ok":{"kind":"primitive","name":"str"}},"source_order":2,"span":{"end_byte":1936,"end_column":1,"end_line":42,"start_byte":443,"start_column":1,"start_line":16}}]}},"dependencies":[],"generation_id":"sha256:98f2574f42b93eef190e3ebd4f5a030becedc8136154ff2e42f98c52ad5e43c6","implementations":[{"content_hash":"sha256:45cd9803794dce2444234cf43a22951ec4ce137c2c9c7de7004550d36cb58949","cott_symbol":"curriculum.random_password.generate_password","owner":"agent","python_symbol":"_cott_impl.curriculum.random_password.generate_password:generate_password","runtime_origin":"python/_cott_impl/curriculum/random_password/generate_password.py","source_origin":"python/_cott_impl/curriculum/random_password/generate_password.py"},{"content_hash":"sha256:2fb803c2da2aae14e73c6dd503b72a0bc6478642e9229e657c84b8cd6a17dc6e","cott_symbol":"curriculum.random_password.required_password_draws","owner":"agent","python_symbol":"_cott_impl.curriculum.random_password.required_password_draws:required_password_draws","runtime_origin":"python/_cott_impl/curriculum/random_password/required_password_draws.py","source_origin":"python/_cott_impl/curri