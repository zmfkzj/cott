module curriculum.calculate_age

struct AgeSummary:
    name: Str
    years: I64
    months: I64
    days: I64

enum AgeError:
    NegativeAge
    InvalidDate
    Overflow

fn calculate_age_days(
    age_years: I64,
    today_year: I64,
    today_month: I64,
    today_day: I64,
) -> Result[I64, AgeError]:
    doc """
    Calculate the elapsed Gregorian days for an age in whole years ending on the supplied date.
    
    A February 29 anniversary falls on February 28 in a non-leap start year. Validation returns NegativeAge before InvalidDate, and InvalidDate before Overflow.
    """

    ensures Result.Ok(days) => days >= 0

    error AgeError.NegativeAge when age_years < 0
    error AgeError.InvalidDate
    error AgeError.Overflow when age_years > today_year - 1

fn summarize_age(
    name: Str,
    age_years: I64,
    today_year: I64,
    today_month: I64,
    today_day: I64,
) -> Result[AgeSummary, AgeError]:
    doc """
    Build an age summary from the Gregorian day count calculated by calculate_age_days.
    
    On success, name is unchanged, years is age_years, months is age_years * 12, and days is the helper result. Helper errors are propagated unchanged.
    """

    ensures Result.Ok(summary) => summary.name == name
    ensures Result.Ok(summary) => summary.years == age_years
    ensures Result.Ok(summary) => summary.months == age_years * 12
    ensures Result.Ok(summary) => summary.days >= 0

    error AgeError.NegativeAge when age_years < 0
    error AgeError.InvalidDate
    error AgeError.Overflow when age_years > today_year - 1
