module curriculum.website_connectivity

struct WebsiteObservation:
    url: Str
    status_code: I32

enum ConnectivityStatus:
    Working
    NotWorking

struct WebsiteClassification:
    url: Str
    status: ConnectivityStatus

enum WebsiteObservationError:
    EmptyUrl
    InvalidStatusCode

fn classify_observation(
    observation: WebsiteObservation,
) -> Result[WebsiteClassification, WebsiteObservationError]:
    doc """
    Validates and classifies one caller-supplied HTTP status observation.
    
    An empty URL returns EmptyUrl before the status code is checked;
    whitespace-only and otherwise nonempty URLs are accepted as opaque text
    and preserved exactly. A status code outside the inclusive HTTP range 100
    through 599 returns InvalidStatusCode.
    
    Status 200 maps to Working; every other accepted status maps to NotWorking.
    """

    ensures Result.Ok(classification) => classification.url == observation.url

    error WebsiteObservationError.EmptyUrl when observation.url.len == 0
    error WebsiteObservationError.InvalidStatusCode when (observation.status_code < 100 or observation.status_code > 599)

    effects []

fn classify_websites(
    observations: List[WebsiteObservation],
) -> Result[List[WebsiteClassification], WebsiteObservationError]:
    doc """
    Classifies website observations by applying classify_observation to each
    item in input order.
    
    The first invalid observation is returned unchanged. Within each item, an
    empty URL takes priority over an invalid status code. Success contains one
    classification per observation in the same order; empty input succeeds.
    """

    ensures Result.Ok(classifications) => classifications.len == observations.len

    error WebsiteObservationError.EmptyUrl
    error WebsiteObservationError.InvalidStatusCode

    effects []
