            kind: AdapterKind.Odbc,
            display_name: "ODBC",
            uri_schemes: List("odbc"),
            supports_transactions: true,
            supports_catalog: true,
            supports_files: false,
        ),
        AdapterDescriptor(
            kind: AdapterKind.BigQuery,
            display_name: "BigQuery",
            uri_schemes: List("bigquery"),
            supports_transactions: false,
            supports_catalog: true,
            supports_files: false,
        ),
        AdapterDescriptor(
            kind: AdapterKind.Trino,
