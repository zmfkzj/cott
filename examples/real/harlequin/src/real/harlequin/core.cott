    call descriptors = adapter_descriptors()
    assert descriptors == List(
        AdapterDescriptor(
            kind: AdapterKind.DuckDb,
            display_name: "DuckDB",
            uri_schemes: List("duckdb"),
            supports_transactions: true,
            supports_catalog: true,
            supports_files: true,
        ),
