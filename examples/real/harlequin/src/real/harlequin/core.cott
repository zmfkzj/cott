scenario command_line_options_are_parsed:
    call parsed = parse_cli(
        List("-a", "SQLite", "--profile=warehouse", "-r", "-f", "q.sql", "db.sqlite"),
    )
    assert parsed matches Result.Ok(options) => options.profile == Option.Some(value: "warehouse") and options.adapter == Option.Some(value: AdapterKind.Sqlite) and options.connection == Option.Some(value: "db.sqlite") and options.query_file != Option.Nothing and options.read_only and not options.no_config
    call escaped = parse_cli(List("--no-config", "--", "-weird.db"))
    assert escaped matches Result.Ok(options) => options.connection == Option.Some(value: "-weird.db") and options.no_config and options.profile == Option.Nothing and options.query_file == Option.Nothing

scenario command_line_errors_name_the_first_offending_argument:
    call unknown = parse_cli(List("--read-only=yes"))
    assert unknown == Result.Err(error: CliError.UnknownOption(argument: "--read-only=yes"))
    call missing = parse_cli(List("-r", "--profile"))
    assert missing == Result.Err(error: CliError.MissingOptionValue(option: "--profile"))
    call invalid = parse_cli(List("--adapter", "oracle", "--bogus"))
    assert invalid == Result.Err(error: CliError.InvalidAdapter(value: "oracle"))
    call two_sources = parse_cli(List("a.db", "b.db"))
    assert two_sources == Result.Err(error: CliError.ConflictingConnectionInputs)
    call profile_without_config = parse_cli(List("-P", "warehouse", "--no-config"))
    assert profile_without_config == Result.Err(error: CliError.ConflictingConnectionInputs)

scenario configuration_files_are_loaded_in_order:
    fixtures:
        fs files:
            file "harlequin.toml" text("default_profile = \"local\"\ntheme = \"nord\"\n\n[[profiles]]\nname = \"local\"\nadapter = \"sqlite\"\nconnection = \"app.db\"\nread_only = true\n\n[profiles.settings]\ntimeout = \"5\"\n\n[[profiles]]\nname = \"lake\"\nadapter = \"DuckDB\"\nconnection = \":memory:\"\n")
            file "twice.toml" text("[[profiles]]\nname = \"a\"\nadapter = \"sqlite\"\nconnection = \"a.db\"\n\n[[profiles]]\nname = \"a\"\nadapter = \"duckdb\"\nconnection = \"b.db\"\n")
            file "broken.toml" text("theme = \n")
    call loaded = load_configuration(files.path("harlequin.toml"))
    assert loaded == Result.Ok(
        value: Configuration(
            profiles: List(
                ConnectionProfile(
                    name: "local",
                    adapter: AdapterKind.Sqlite,
                    endpoint: "app.db",
                    settings: List(Setting(name: "timeout", value: "5")),
                    read_only: true,
                ),
                ConnectionProfile(
                    name: "lake",
                    adapter: AdapterKind.DuckDb,
                    endpoint: ":memory:",
                    settings: List(),
                    read_only: false,
                ),
            ),
            default_profile: Option.Some(value: "local"),
            theme: "nord",
            keymap: "default",
        ),
    )
    call duplicate = load_configuration(files.path("twice.toml"))
    assert duplicate == Result.Err(error: ConfigurationError.ProfileDuplicate(name: "a"))
    call broken = load_configuration(files.path("broken.toml"))
    assert broken matches Result.Err(ConfigurationError.Invalid(_, _))
    call absent = load_configuration(files.path("absent.toml"))
    assert absent == Result.Err(error: ConfigurationError.Missing(path: files.path("absent.toml")))

scenario profiles_resolve_with_command_line_overrides:
    call defaulted = resolve_profile(
        warehouse_configuration,
        CliOptions(
            profile: Option.Nothing,
            adapter: Option.Nothing,
            connection: Option.Nothing,
            query_file: Option.Nothing,
            read_only: false,
            no_config: false,
        ),
    )
    assert defaulted == Result.Ok(
        value: ConnectionRequest(
            adapter: AdapterKind.Sqlite,
            endpoint: "app.db",
            settings: List(),
            read_only: true,
        ),
    )
    call overridden = resolve_profile(
        warehouse_configuration,
        CliOptions(
            profile: Option.Some(value: "warehouse"),
            adapter: Option.Nothing,
            connection: Option.Some(value: "dbname=audit"),
            query_file: Option.Nothing,
            read_only: true,
            no_config: false,
        ),
    )
    assert overridden == Result.Ok(
        value: ConnectionRequest(
            adapter: AdapterKind.PostgreSql,
            endpoint: "dbname=audit",
            settings: List(Setting(name: "connect_timeout", value: "5")),
            read_only: true,
        ),
    )
    call unconfigured = resolve_profile(
        warehouse_configuration,
        CliOptions(
            profile: Option.Nothing,
            adapter: Option.Some(value: AdapterKind.Sqlite),
            connection: Option.Nothing,
            query_file: Option.Nothing,
            read_only: false,
            no_config: true,
        ),
    )
    assert unconfigured == Result.Ok(
        value: ConnectionRequest(
            adapter: AdapterKind.Sqlite,
            endpoint: ":memory:",
            settings: List(),
            read_only: false,
        ),
    )
    call missing = resolve_profile(
        warehouse_configuration,
        CliOptions(
            profile: Option.Some(value: "archive"),
            adapter: Option.Nothing,
            connection: Option.Nothing,
            query_file: Option.Nothing,
            read_only: false,
            no_config: false,
        ),
    )
    assert missing == Result.Err(error: ConfigurationError.ProfileMissing(name: "archive"))

scenario tabs_are_added_replaced_activated_and_closed:
    call added = add_query_tab(
        two_tabs,
        QueryTab(id: "c", title: "C", source: "", cursor: 0, dirty: false),
    )
    assert added.tabs.len == 3 and added.active_tab_id == Option.Some(value: "c")
    call replaced = add_query_tab(
        added,
        QueryTab(id: "a", title: "A2", source: "select 9", cursor: 1, dirty: true),
    )
    assert replaced.tabs == List(
        QueryTab(id: "a", title: "A2", source: "select 9", cursor: 1, dirty: true),
        QueryTab(id: "b", title: "B", source: "select 2", cursor: 3, dirty: true),
        QueryTab(id: "c", title: "C", source: "", cursor: 0, dirty: false),
    )
    assert replaced.active_tab_id == Option.Some(value: "a")
    call activated = activate_query_tab(replaced, "b")
    assert activated matches Result.Ok(session) => session.active_tab_id == Option.Some(value: "b")
    call closed_active_first = close_query_tab(two_tabs, "a")
    assert closed_active_first matches Result.Ok(session) => session.tabs.len == 1 and session.active_tab_id == Option.Some(value: "b")
    call closed_active_last = close_query_tab(added, "c")
    assert closed_active_last matches Result.Ok(session) => session.active_tab_id == Option.Some(value: "b")
    call closed_inactive = close_query_tab(two_tabs, "b")
    assert closed_inactive matches Result.Ok(session) => session.active_tab_id == Option.Some(value: "a")
    call unknown = activate_query_tab(two_tabs, "z")
    assert unknown == Result.Err(error: SessionError.TabMissing(tab_id: "z"))

scenario history_keeps_the_newest_entries:
    data first: QueryHistoryEntry = QueryHistoryEntry(
        source: "select 1",
        executed_at: "2026-01-01T00:00:00Z",
        succeeded: true,
    )
    data second: QueryHistoryEntry = QueryHistoryEntry(
        source: "select 2",
        executed_at: "2026-01-01T00:00:01Z",
        succeeded: false,
    )
    data third: QueryHistoryEntry = QueryHistoryEntry(
        source: "select 3",
        executed_at: "2026-01-01T00:00:02Z",
        succeeded: true,
    )
    call one = append_query_history(QueryHistory(entries: List(), capacity: 2), first)
    call two = append_query_history(one, second)
    call three = append_query_history(two, third)
    assert three.entries == List(second, third)

scenario statements_split_outside_quotes_and_comments:
    call split = split_statements(" select 'a;b' ; -- skip; this\n/* c; */ select \"x;\" ;; select 2")
    assert split == Result.Ok(
        value: List("select 'a;b'", "-- skip; this\n/* c; */ select \"x;\"", "select 2"),
    )
    call quote = split_statements("select 'it''s")
    assert quote == Result.Err(error: SqlClientError.UnterminatedSql(delimiter: "'"))
    call comment = split_statements("select 1 /* open")
    assert comment == Result.Err(error: SqlClientError.UnterminatedSql(delimiter: "*/"))
    call empty = split_statements(" -- nothing\n ; /* */ ")
    assert empty == Result.Err(error: SqlClientError.EmptySql)

scenario query_files_round_trip_as_utf8:
    fixtures:
        fs files:
            file "saved.sql" text("select 1;")
            file "latin1.sql" hex("e9")
        http s3:
            route "/unused" -> response(status: 404, body: text(""), encoding: "utf-8")
    call saved = save_query_file(
        FileReference(location: FileLocation.Local(path: files.path("saved.sql")), writable: true),
        "select 'é';",
    )
    assert saved matches Result.Ok(receipt) => receipt.bytes_written == 12
    call loaded = load_query_file(
        FileReference(location: FileLocation.Local(path: files.path("saved.sql")), writable: false),
    )
    assert loaded matches Result.Ok(file) => file.source == "select 'é';"
    call denied = save_query_file(
        FileReference(location: FileLocation.Local(path: files.path("saved.sql")), writable: false),
        "drop table t;",
    )
    assert denied matches Result.Err(FileError.PermissionDenied(_))
    call undecodable = load_query_file(
        FileReference(
            location: FileLocation.Local(path: files.path("latin1.sql")),
            writable: false,
        ),
    )
    assert undecodable matches Result.Err(FileError.InvalidEncoding(_))
    call absent = load_query_file(
        FileReference(
            location: FileLocation.Local(path: files.path("absent.sql")),
            writable: false,
        ),
    )
    assert absent matches Result.Err(FileError.NotFound(_))

scenario failed_save_keeps_the_previous_query:
    fixtures:
        fs files:
            file "saved.sql" text("select 1;")
        http s3:
            route "/unused" -> response(status: 404, body: text(""), encoding: "utf-8")
        failure disk_full:
            point: file.replace
            occurrence: 1
            error: disk_full
    call failed = save_query_file(
        FileReference(location: FileLocation.Local(path: files.path("saved.sql")), writable: true),
        "select 2;",
    )
    assert failed matches Result.Err(FileError.TransferFailed(_, _))
    call kept = load_query_file(
        FileReference(location: FileLocation.Local(path: files.path("saved.sql")), writable: false),
    )
    assert kept matches Result.Ok(file) => file.source == "select 1;"
