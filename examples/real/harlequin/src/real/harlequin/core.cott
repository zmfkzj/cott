            display_name: "SQLite",
            uri_schemes: List("sqlite"),
            supports_transactions: true,
            supports_catalog: true,
            supports_files: true,
        ),
        AdapterDescriptor(
            kind: AdapterKind.PostgreSql,
            display_name: "PostgreSQL",
            uri_schemes: List("postgres", "postgresql"),
            supports_transactions: true,
            supports_catalog: true,
            supports_files: false,
        ),
