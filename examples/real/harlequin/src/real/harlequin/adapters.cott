scenario catalog_child_read_failure_uses_a_real_catalog_parent:
    fixtures:
        database db:
            backend: sqlite
        fs files:
            file "anchor" text("")
        failure denied:
            point: database.read
            occurrence: 2
            error: connection_reset
    call opened = connect(fixture_sqlite_request)
    unwrap connection = opened
    call loaded = load_catalog(connection)
    unwrap catalog = loaded
    item parent = catalog at 0
    assert parent.label == "main"
    call failed = load_catalog_children(connection, parent)
    assert failed matches Result.Err(QueryError.Failed(_, _))
    call closed = close_connection(connection)
    assert closed == Result.Ok(value: ())
