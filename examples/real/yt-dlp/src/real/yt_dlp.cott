scenario nested_request_values:
    fixtures:
        fs files:
            file "archive.txt" text("")
    data request: ExecutionRequest = direct_media_request
    call network = validate_network(request.network)
    assert network matches Result.Ok(_)
    call urls = resolve_inputs(request.inputs, List())
    assert urls matches Result.Ok(values) => values == List("https://example.invalid/clip.mp4")
    call rendered = render_items(
        List(
            MediaItem(
                url: "https://example.invalid/clip.mp4",
                id: "clip",
                title: "clip.mp4",
                ext: "mp4",
                playlist_index: 1,
            ),
        ),
        request.json_mode,
    )
    assert (rendered == "[{\"url\":\"https://example.invalid/clip.mp4\",\"id\":\"clip\",\"title\":\"clip.mp4\",\"ext\":\"mp4\",\"playlist_index\":1}]")

scenario cli_arguments_map_to_typed_inputs:
    call parsed = parse_arguments(
        List(
            "https://example.invalid/a.mp4",
            "-a",
            "urls.txt",
            "--config-locations=site.conf",
            "--batch-file",
            "-more.txt",
        ),
    )
    assert parsed == Result.Ok(
        value: List(
            CliInput(kind: InputKind.Argument, value: "https://example.invalid/a.mp4"),
            CliInput(kind: InputKind.BatchFile, value: "urls.txt"),
            CliInput(kind: InputKind.ConfigFile, value: "site.conf"),
            CliInput(kind: InputKind.BatchFile, value: "-more.txt"),
        ),
    )
    call missing_value = parse_arguments(List("https://example.invalid/a.mp4", "-a"))
    assert missing_value matches Result.Err(MediaError.InvalidInput(_))
    call unknown_option = parse_arguments(List("--format", "best"))
    assert unknown_option matches Result.Err(MediaError.InvalidInput(_))

scenario inputs_resolve_in_order:
    call batch = parse_batch_urls(
        "https://example.invalid/1.mp4\r\n  # note\n\n  https://example.invalid/2.mp4  \n;skip\nhttps://example.invalid/1.mp4",
        List("#", ";"),
    )
    assert batch == Result.Ok(
        value: List(
            "https://example.invalid/1.mp4",
            "https://example.invalid/2.mp4",
            "https://example.invalid/1.mp4",
        ),
    )
    call empty_prefix = parse_batch_urls("https://example.invalid/1.mp4", List(""))
    assert empty_prefix matches Result.Err(MediaError.InvalidInput(_))
    call merged = resolve_inputs(
        List(CliInput(kind: InputKind.Argument, value: "a")),
        List(CliInput(kind: InputKind.Argument, value: "b")),
    )
    assert merged == Result.Ok(value: List("a", "b"))
    call unexpanded = resolve_inputs(
        List(CliInput(kind: InputKind.BatchFile, value: "urls.txt")),
        List(),
    )
    assert unexpanded matches Result.Err(MediaError.InvalidInput(_))

scenario shortcut_urls_follow_yt_dlp_prefixes:
    call search = build_shortcut_url(
        ShortcutRequest(kind: ShortcutKind.Search, query: " cats ", limit: 12),
    )
    assert search == Result.Ok(value: "ytsearch12: cats ")
    call search_all = build_shortcut_url(
        ShortcutRequest(kind: ShortcutKind.SearchAll, query: "cats", limit: 0),
    )
    assert search_all == Result.Ok(value: "ytsearchall:cats")
    call url = build_shortcut_url(
        ShortcutRequest(
            kind: ShortcutKind.Url,
            query: "  https://Example.invalid/A?q=1  ",
            limit: 0,
        ),
    )
    assert url == Result.Ok(value: "https://Example.invalid/A?q=1")
    call invalid = build_shortcut_url(
        ShortcutRequest(kind: ShortcutKind.Url, query: "not a url", limit: 1),
    )
    assert invalid == Result.Err(error: MediaError.InvalidShortcut(value: "not a url"))

scenario extractor_choice_uses_prefixes_and_enablement:
    call discovered = discover_extractors()
    assert discovered == List(
        ExtractorDescriptor(
            name: "generic",
            urls: List("http://", "https://"),
            enabled: true,
            requires_login: false,
        ),
    )
    data extractors: List[ExtractorDescriptor] = List(
        ExtractorDescriptor(
            name: "archive",
            urls: List("https://archive.invalid/"),
            enabled: false,
            requires_login: false,
        ),
        ExtractorDescriptor(
            name: "generic",
            urls: List("http://", "https://"),
            enabled: true,
            requires_login: false,
        ),
    )
    call chosen = choose_extractor("https://archive.invalid/a.mp4", extractors)
    assert chosen matches Result.Ok(extractor) => extractor.name == "generic"
    call disabled = choose_extractor(
        "ftp://archive.invalid/a.mp4",
        List(
            ExtractorDescriptor(
                name: "ftp",
                urls: List("ftp://"),
                enabled: false,
                requires_login: false,
            ),
        ),
    )
    assert disabled == Result.Err(error: MediaError.ExtractorMissing(name: "ftp"))
    call unsupported = choose_extractor("not a url", extractors)
    assert unsupported == Result.Err(error: MediaError.UnsupportedUrl)

scenario unsupported_settings_fail_closed:
    fixtures:
        fs files:
            file "netrc" text("")
    call insecure = validate_workarounds(
        WorkaroundPolicy(
            certificate: CertificatePolicy.Insecure,
            force_generic_extractor: true,
            legacy_server_connect: false,
            extractor_args: List(),
        ),
    )
    assert insecure matches Result.Err(MediaError.CertificateFailure(_))
    call netrc = resolve_authentication(
        Authentication(
            kind: AuthenticationKind.Netrc,
            username: "",
            password: "",
            netrc_location: files.path("netrc"),
            cookie_file: files.path("netrc"),
            browser: "",
            profile: "",
        ),
    )
    assert netrc matches Result.Err(MediaError.AuthenticationFailed(_))
    call country = select_geo_route(
        NetworkPolicy(
            proxy_mode: ProxyMode.Direct,
            proxy: "",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.Country,
            geo_country: "US",
            geo_ip_block: "",
        ),
    )
    assert country matches Result.Err(MediaError.GeoRestricted(_))
    call views = filter_video(
        List(clip_one),
        VideoFilterRequest(
            date_after: "",
            date_before: "",
            min_views: 1,
            max_views: 0,
            age_limit: 0,
            match_filter: "",
            reject_live: false,
            include_ads: true,
        ),
    )
    assert views matches Result.Err(MediaError.InvalidInput(_))
    call waiting = resolve_live_media(
        List(),
        LiveRequest(mode: LiveMode.Wait, wait_for_video_ms: 1000, concurrent_fragments: 1),
    )
    assert waiting == Result.Err(error: MediaError.RetryExhausted(attempts: 1))

scenario each_rejection_condition_is_observed:
    fixtures:
        fs files:
            file "in.mp4" text("")
    call direct_with_proxy = validate_network(
        NetworkPolicy(
            proxy_mode: ProxyMode.Direct,
            proxy: "http://proxy.invalid:8080",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.Default,
            geo_country: "",
            geo_ip_block: "",
        ),
    )
    assert direct_with_proxy matches Result.Err(MediaError.InvalidInput(_))
    call proxy_missing = validate_network(
        NetworkPolicy(
            proxy_mode: ProxyMode.Http,
            proxy: "",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.Default,
            geo_country: "",
            geo_ip_block: "",
        ),
    )
    assert proxy_missing matches Result.Err(MediaError.InvalidInput(_))
    call stray_country = validate_network(
        NetworkPolicy(
            proxy_mode: ProxyMode.Direct,
            proxy: "",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.Default,
            geo_country: "US",
            geo_ip_block: "",
        ),
    )
    assert stray_country matches Result.Err(MediaError.InvalidInput(_))
    call long_country = validate_network(
        NetworkPolicy(
            proxy_mode: ProxyMode.Direct,
            proxy: "",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.Country,
            geo_country: "USA",
            geo_ip_block: "",
        ),
    )
    assert long_country matches Result.Err(MediaError.InvalidInput(_))
    call missing_block = validate_network(
        NetworkPolicy(
            proxy_mode: ProxyMode.Direct,
            proxy: "",
            socket_timeout_ms: 1000,
            source_address: "",
            force_ipv4: false,
            force_ipv6: false,
            geo_mode: GeoBypassMode.IpBlock,
            geo_country: "",
            geo_ip_block: "",
        ),
    )
    assert missing_block matches Result.Err(MediaError.InvalidInput(_))
    call no_password = resolve_authentication(
        Authentication(
            kind: AuthenticationKind.Credentials,
            username: "user",
            password: "",
            netrc_location: files.path("in.mp4"),
            cookie_file: files.path("in.mp4"),
            browser: "",
            profile: "",
        ),
    )
    assert no_password matches Result.Err(MediaError.AuthenticationFailed(_))
    call cookies = resolve_authentication(
        Authentication(
            kind: AuthenticationKind.Cookies,
            username: "",
            password: "",
            netrc_location: files.path("in.mp4"),
            cookie_file: files.path("in.mp4"),
            browser: "",
            profile: "",
        ),
    )
    assert cookies matches Result.Err(MediaError.CookieFailure(_))
    call no_wait_budget = resolve_live_media(
        List(clip_one),
        LiveRequest(mode: LiveMode.Wait, wait_for_video_ms: 0, concurrent_fragments: 1),
    )
    assert no_wait_budget matches Result.Err(MediaError.InvalidInput(_))
    call no_tool = plan_post_processing(
        clip_one,
        PostProcessRequest(
            kinds: List(PostProcessorKind.Fixup),
            audio_format: "",
            video_format: "",
            sponsorblock_categories: List(),
            external_tool: Option.Nothing,
        ),
    )
    assert no_tool == Result.Err(error: MediaError.ExternalToolMissing(name: "ffmpeg"))
    call empty_tool = plan_post_processing(
        clip_one,
        PostProcessRequest(
            kinds: List(PostProcessorKind.Fixup),
            audio_format: "",
            video_format: "",
            sponsorblock_categories: List(),
            external_tool: Option.Some(
                value: ExternalToolRequest(
                    executable: "",
                    arguments: List(),
                    input: files.path("in.mp4"),
                    output: files.path("out.mp4"),
                    timeout_ms: 1000,
                ),
            ),
        ),
    )
    assert empty_tool == Result.Err(error: MediaError.ExternalToolMissing(name: ""))
    call no_languages = select_subtitles(
        clip_one,
        SubtitleRequest(
            mode: SubtitleMode.Manual,
            languages: List(),
            formats: List(),
            convert_format: "",
            embed: false,
        ),
    )
    assert no_languages == Result.Err(error: MediaError.SubtitleUnavailable(language: ""))

scenario playlist_ranges_repeat_overlaps_in_request_order:
    data items: List[MediaItem] = List(clip_one, clip_two, clip_three)
    call expanded = expand_playlist_ranges(
        items,
        List(PlaylistRange(first: 2, last: 3), PlaylistRange(first: 1, last: 2)),
    )
    assert expanded == Result.Ok(value: List(clip_two, clip_three, clip_one, clip_two))
    call inverted = expand_playlist_ranges(items, List(PlaylistRange(first: 3, last: 1)))
    assert inverted == Result.Err(error: MediaError.InvalidRange)

scenario formats_filter_and_sort_best_first:
    data formats: List[FormatDescriptor] = List(low_video, high_video, high_audio)
    call audio = filter_formats(
        formats,
        FormatRequest(
            selector: "bestaudio",
            containers: List(FormatContainer.Audio),
            sort_fields: List(),
            merge_output_format: "",
            min_file_size: 15,
            max_file_size: 100,
            prefer_free_formats: false,
        ),
    )
    assert audio == Result.Ok(value: List(high_audio))
    call none = filter_formats(
        formats,
        FormatRequest(
            selector: "tiny",
            containers: List(),
            sort_fields: List(),
            merge_output_format: "",
            min_file_size: 1000,
            max_file_size: 0,
            prefer_free_formats: false,
        ),
    )
    assert none == Result.Err(error: MediaError.FormatUnavailable(selector: "tiny"))
    call by_resolution = sort_formats(formats, List("res", "abr"))
    assert by_resolution == List(high_audio, high_video, low_video)
    call by_size = sort_formats(formats, List("size"))
    assert by_size == List(high_video, high_audio, low_video)
    call unknown_key = sort_formats(formats, List("fps"))
    assert unknown_key == formats

scenario side_output_plans_use_item_ids:
    call thumbnails = plan_thumbnails(
        clip_two,
        ThumbnailRequest(
            write: true,
            formats: List("jpg", "", "png"),
            convert_format: "webp",
            embed: true,
        ),
    )
    assert thumbnails == List("two.jpg", "two.png", "two.webp", "embed:two")
    call metadata = plan_metadata(
        clip_two,
        MetadataRequest(
            write_info_json: true,
            write_description: false,
            write_comments: true,
            write_playlist_metadata: false,
            embed: true,
        ),
    )
    assert metadata == List("two.info.json", "two.comments.json", "embed:two")
    call subtitles = select_subtitles(
        clip_two,
        SubtitleRequest(
            mode: SubtitleMode.Manual,
            languages: List("en", ""),
            formats: List(),
            convert_format: "",
            embed: false,
        ),
    )
    assert subtitles == Result.Err(error: MediaError.SubtitleUnavailable(language: ""))

scenario output_paths_render_and_sanitize:
    fixtures:
        fs files:
            file "out/keep.txt" text("")
    call rendered = render_output_path(clip_two, "%(playlist_index)d-%(title)s [%(id)s].%(ext)s %% %(uploader)s", "NA")
    assert rendered == Result.Ok(value: "2-Two: Live? [two].webm % NA")
    call bad_conversion = render_output_path(clip_two, "%(title)d", "NA")
    assert bad_conversion == Result.Err(error: MediaError.InvalidTemplate)
    call sanitized = resolve_output_path(
        clip_two,
        OutputRequest(
            template: "%(title)s.%(ext)s",
            home: files.path("home"),
            temp: files.path("tmp"),
            output: files.path("out"),
            missing_placeholder: "NA",
            restrict_filenames: false,
            windows_filenames: true,
            trim_filename_bytes: 0,
        ),
    )
    assert sanitized == Result.Ok(value: files.path("out/Two_ Live_.webm"))

scenario archive_plan_skips_or_stops:
    data items: List[MediaItem] = List(clip_one, clip_two, clip_three)
    call skipped = plan_downloads(items, List("two"), false)
    assert skipped == DownloadPlan(items: List(clip_one, clip_three), stopped_on_archive: false)
    call stopped = plan_downloads(items, List("two"), true)
    assert stopped == DownloadPlan(items: List(clip_one), stopped_on_archive: true)

scenario single_fragment_and_tool_plans:
    fixtures:
        fs files:
            file "in.mp4" text("")
    data transfer: TransferRequest = TransferRequest(
        url: "https://example.invalid/one.mp4",
        destination: files.path("one.mp4"),
        simulate: false,
        max_bytes: 1000,
    )
    call fragments = plan_fragments(
        transfer,
        FragmentPolicy(
            concurrent_fragments: 1,
            buffer_size: 65536,
            chunk_size: 0,
            rate_limit_bytes_per_second: 0,
            retries: 0,
            fragment_retries: 0,
            file_access_retries: 0,
            continue_download: false,
            part_files: true,
        ),
    )
    assert fragments == Result.Ok(value: List(transfer))
    data tool: ExternalToolRequest = ExternalToolRequest(
        executable: "cott-media-tool",
        arguments: List("--quiet"),
        input: files.path("in.mp4"),
        output: files.path("out.m4a"),
        timeout_ms: 1000,
    )
    call planned = plan_post_processing(
        clip_one,
        PostProcessRequest(
            kinds: List(
                PostProcessorKind.ExtractAudio,
                PostProcessorKind.EmbedThumbnail,
                PostProcessorKind.SponsorBlock,
            ),
            audio_format: "m4a",
            video_format: "",
            sponsorblock_categories: List("sponsor", "intro"),
            external_tool: Option.Some(value: tool),
        ),
    )
    assert planned == Result.Ok(
        value: List(
            ExternalToolRequest(
                executable: "cott-media-tool",
                arguments: List("--quiet", "extract-audio", "m4a"),
                input: files.path("in.mp4"),
                output: files.path("out.m4a"),
                timeout_ms: 1000,
            ),
            ExternalToolRequest(
                executable: "cott-media-tool",
                arguments: List("--quiet", "embed-thumbnail"),
                input: files.path("in.mp4"),
                output: files.path("out.m4a"),
                timeout_ms: 1000,
            ),
            ExternalToolRequest(
                executable: "cott-media-tool",
                arguments: List("--quiet", "sponsorblock", "sponsor,intro"),
                input: files.path("in.mp4"),
                output: files.path("out.m4a"),
                timeout_ms: 1000,
            ),
        ),
    )
    call missing_format = plan_post_processing(
        clip_one,
        PostProcessRequest(
            kinds: List(PostProcessorKind.RemuxVideo),
            audio_format: "",
            video_format: "",
            sponsorblock_categories: List(),
            external_tool: Option.Some(value: tool),
        ),
    )
    assert missing_format matches Result.Err(MediaError.InvalidInput(_))

scenario tool_without_timeout_is_rejected:
    fixtures:
        fs files:
            file "in.mp4" text("")
    call unbounded = plan_post_processing(
        clip_one,
        PostProcessRequest(
            kinds: List(PostProcessorKind.Fixup),
            audio_format: "",
            video_format: "",
            sponsorblock_categories: List(),
            external_tool: Option.Some(
                value: ExternalToolRequest(
                    executable: "cott-media-tool",
                    arguments: List(),
                    input: files.path("in.mp4"),
                    output: files.path("out.mp4"),
                    timeout_ms: 0,
                ),
            ),
        ),
    )
    assert unbounded matches Result.Err(MediaError.InvalidInput(_))

scenario json_lines_rendering:
    call lines = render_items(List(clip_one, clip_two), JsonMode.Lines)
    assert (lines == "{\"url\":\"https://example.invalid/one.mp4\",\"id\":\"one\",\"title\":\"one.mp4\",\"ext\":\"mp4\",\"playlist_index\":1}\n{\"url\":\"https://example.invalid/two.webm\",\"id\":\"two\",\"title\":\"Two: Live?\",\"ext\":\"webm\",\"playlist_index\":2}")
    call empty_lines = render_items(List(), JsonMode.Lines)
    assert empty_lines == ""
    call empty_array = render_items(List(), JsonMode.Single)
    assert empty_array == "[]"

scenario update_channels_map_to_official_repositories:
    call padded = resolve_update_repository(UpdatePolicy.Check, " nightly ")
    assert padded == Result.Ok(value: "yt-dlp/yt-dlp-nightly-builds")
    call stable = resolve_update_repository(UpdatePolicy.Apply, "")
    assert stable == Result.Ok(value: "yt-dlp/yt-dlp")
    call wrong_case = resolve_update_repository(UpdatePolicy.Apply, "Nightly")
    assert wrong_case matches Result.Err(MediaError.UpdateUnavailable(_))
    call forced = resolve_update_repository(UpdatePolicy.Master, "not-a-channel")
    assert forced == Result.Ok(value: "yt-dlp/yt-dlp-master-builds")
