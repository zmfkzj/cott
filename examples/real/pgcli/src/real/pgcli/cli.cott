data styled_config: PgcliConfig = PgcliConfig(
    main: MainSettings(
        smart_completion: true,
        auto_suggest: true,
        wider_completion_menu: false,
        always_use_single_connection: false,
        multi_line: false,
        multi_line_mode: "psql",
        destructive_warning: List(
            "drop",
            "shutdown",
            "delete",
            "truncate",
            "alter",
            "update",
            "unconditional_update",
        ),
        destructive_warning_restarts_connection: false,
        destructive_statements_require_transaction: false,
        expand: false,
        auto_expand: false,
        auto_retry_closed_connection: true,
        generate_aliases: false,
        alias_map_file: "",
        log_file: "default",
        keyword_casing: "auto",
        casing_file: "default",
        generate_casing_file: false,
        case_column_headers: true,
        history_file: "default",
        log_level: "INFO",
        asterisk_column_order: "table_order",
        qualify_columns: "if_more_than_one_table",
        search_path_filter: false,
        pager: "",
        timing: true,
        hide_named_query_text: false,
        show_bottom_toolbar: true,
        table_format: "psql",
        syntax_style: "default",
        vi: false,
        connect_timeout: 30,
        on_error: "STOP",
        row_limit: 1000,
        max_field_width: Option.Some(value: 500),
        less_chatty: false,
        verbose_errors: false,
        prompt: "\\u@\\h:\\d> ",
        min_num_menu_lines: 4,
        multiline_continuation_char: "",
        null_string: "<null>",
        enable_pager: true,
        keyring: true,
        use_local_timezone: true,
    ),
    colors: List(
        ConfigEntry(name: "selected", value: "#ffffff bg:#6666aa"),
        ConfigEntry(name: "output.header", value: "#00ff5f bold"),
        ConfigEntry(name: "output.odd-row", value: ""),
        ConfigEntry(name: "output.even-row", value: "bg:#101010"),
        ConfigEntry(name: "output.null", value: "#808080"),
        ConfigEntry(name: "Token.Output.TableSeparator", value: "#555555"),
    ),
    named_queries: List(),
    alias_dsn: List(),
    init_commands: List(),
    alias_dsn_init_commands: List(),
    decimal_format: "",
    float_format: ",",
    column_date_formats: List(ConfigEntry(name: "created", value: "%Y-%m-%d")),
    ssh_tunnels: List(),
    dsn_ssh_tunnels: List(),
)

data plain_config: PgcliConfig = PgcliConfig(
    main: MainSettings(
        smart_completion: false,
        auto_suggest: false,
        wider_completion_menu: false,
        always_use_single_connection: true,
        multi_line: true,
        multi_line_mode: "safe",
        destructive_warning: List("moderate"),
        destructive_warning_restarts_connection: true,
        destructive_statements_require_transaction: true,
        expand: true,
        auto_expand: true,
        auto_retry_closed_connection: false,
        generate_aliases: true,
        alias_map_file: "",
        log_file: "default",
        keyword_casing: "upper",
        casing_file: "default",
        generate_casing_file: false,
        case_column_headers: false,
        history_file: "default",
        log_level: "DEBUG",
        asterisk_column_order: "alphabetic",
        qualify_columns: "always",
        search_path_filter: true,
        pager: "less",
        timing: false,
        hide_named_query_text: true,
        show_bottom_toolbar: false,
        table_format: "grid",
        syntax_style: "nosuchstyle",
        vi: true,
        connect_timeout: 5,
        on_error: "RESUME",
        row_limit: 0,
        max_field_width: Option.Nothing,
        less_chatty: true,
        verbose_errors: true,
        prompt: "\\u> ",
        min_num_menu_lines: 8,
        multiline_continuation_char: ".",
        null_string: "NULL",
        enable_pager: false,
        keyring: false,
        use_local_timezone: false,
    ),
    colors: List(),
    named_queries: List(),
    alias_dsn: List(),
    init_commands: List(),
    alias_dsn_init_commands: List(),
    decimal_format: ",",
    float_format: "",
    column_date_formats: List(),
    ssh_tunnels: List(),
    dsn_ssh_tunnels: List(),
)

scenario settings_combine_options_and_config:
    call scripted = session_settings_from(
        scripted_options,
        styled_config,
        SetupEnvironment(home: "/home/ann", colorterm: "TrueColor"),
    )
    assert scripted == SessionSettings(
        table_format: "psql",
        expanded_output: false,
        auto_expand: true,
        multi_line: false,
        multiline_mode: "psql",
        vi_mode: false,
        explain_mode: false,
        smart_completion: true,
        hide_named_query_text: false,
        verbose_errors: false,
        output_file: Option.Nothing,
        log_file: Option.Some(value: "/tmp/pgcli.log"),
        row_limit: 20,
        max_field_width: Option.Some(value: 500),
        null_string: "<null>",
        on_error: "STOP",
        destructive_warning: List("drop", "alter"),
        destructive_warning_restarts_connection: false,
        destructive_statements_require_transaction: false,
        force_destructive: true,
        auto_retry_closed_connection: true,
        tuples_only: true,
        less_chatty: true,
        decimal_format: "",
        float_format: ",",
        column_date_formats: Map("created": "%Y-%m-%d"),
        case_column_headers: true,
        output_style: Option.Some(
            value: OutputStyle(
                base: "",
                header: "#00ff5f bold",
                odd_row: "",
                even_row: "bg:#101010",
                null: "#808080",
                table_separator: "#555555",
                true_color: true,
            ),
        ),
        prompt_format: "\\d# ",
        prompt_dsn_format: Option.Some(value: "\\d@\\h"),
        dsn_alias: Option.Nothing,
        scripted: true,
        completion_refreshing: false,
    )
    call interactive = session_settings_from(
        interactive_options,
        plain_config,
        SetupEnvironment(home: "/home/ann", colorterm: "24bit"),
    )
    assert interactive == SessionSettings(
        table_format: "grid",
        expanded_output: true,
        auto_expand: true,
        multi_line: true,
        multiline_mode: "safe",
        vi_mode: true,
        explain_mode: false,
        smart_completion: false,
        hide_named_query_text: true,
        verbose_errors: true,
        output_file: Option.Nothing,
        log_file: Option.Nothing,
        row_limit: 0,
        max_field_width: Option.Nothing,
        null_string: "NULL",
        on_error: "RESUME",
        destructive_warning: List(
            "drop",
            "shutdown",
            "delete",
            "truncate",
            "alter",
            "unconditional_update",
        ),
        destructive_warning_restarts_connection: true,
        destructive_statements_require_transaction: true,
        force_destructive: false,
        auto_retry_closed_connection: false,
        tuples_only: false,
        less_chatty: true,
        decimal_format: ",",
        float_format: "",
        column_date_formats: Map(),
        case_column_headers: false,
        output_style: Option.Some(
            value: OutputStyle(
                base: "#d0d0d0",
                header: "",
                odd_row: "",
                even_row: "",
                null: "",
                table_separator: "",
                true_color: false,
            ),
        ),
        prompt_format: "\\u> ",
        prompt_dsn_format: Option.Nothing,
        dsn_alias: Option.Nothing,
        scripted: false,
        completion_refreshing: false,
    )
    call from_file = session_settings_from(
        file_options,
        plain_config,
        SetupEnvironment(home: "/home/ann", colorterm: ""),
    )
    assert from_file.destructive_warning == List(
        "drop",
        "shutdown",
        "delete",
        "truncate",
        "alter",
        "unconditional_update",
        "update",
    )
    assert from_file.scripted and not from_file.tuples_only and not from_file.force_destructive
