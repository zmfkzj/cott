    call out1 = format_output(
        Option.Some(value: ""),
        Option.Some(
            value: ResultSet(
                columns: List("bigint_array", "nested_numeric_array", "配列"),
                type_names: List("", "", ""),
                rows: rows1,
                rowcount: 2,
