                    items: List(
                        Cell.Integer(value: 1),
                        Cell.Integer(value: 2),
                        Cell.Integer(value: 3),
                    ),
                ),
                Cell.Array(
                    items: List(
                        Cell.Array(items: List(Cell.Decimal(value: "1"), Cell.Decimal(value: "2"))),
                        Cell.Array(items: List(Cell.Decimal(value: "3"), Cell.Decimal(value: "4"))),
                    ),
                ),
                Cell.Array(
                    items: List(
                        Cell.Text(value: "å"),
                        Cell.Text(value: "魚"),
                        Cell.Text(value: "текст"),
