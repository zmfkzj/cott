scenario explain_plan_visualizer:
    call plan1 = visualize_explain_plans("[{\"Plan\":{\"Node Type\":\"Nested Loop\",\"Join Type\":\"Left\",\"Total Cost\":123456.78,\"Plan Rows\":10,\"Actual Total Time\":2500.5,\"Actual Rows\":5000,\"Actual Loops\":1,\"Output\":[\"x.alpha_column_1\",\"x.alpha_column_2\",\"x.alpha_column_3\",\"x.alpha_column_4\",\"x.alpha_column_5\",\"x.alpha_column_6\",\"x.alpha_column_7\",\"y.b\"],\"Plans\":[{\"Node Type\":\"Index Scan\",\"Scan Direction\":\"Forward\",\"Index Name\":\"x_pkey\",\"Index Condition\":\"(x.a = 1)\",\"Relation Name\":\"x\",\"Total Cost\":8.3,\"Plan Rows\":1,\"Actual Total Time\":150.25,\"Actual Rows\":1,\"Actual Loops\":3,\"Plans\":[{\"Node Type\":\"Materialize\",\"Total Cost\":0,\"Plan Rows\":0,\"Actual Total Time\":0,\"Actual Rows\":0,\"Actual Loops\":1}]},{\"Node Type\":\"CTEScan\",\"CTE Name\":\"w\",\"Hash Condition\":\"(y.b = w.b)\",\"Total Cost\":20,\"Plan Rows\":1000,\"Actual Total Time\":70000,\"Actual Rows\":50,\"Actual Loops\":1,\"Filter\":\"(y.b > 0)\",\"Rows Removed by Filter\":12345,\"Output\":[\"w.beta_column_1\",\"w.beta_column_2\",\"w.beta_column_3\",\"w.beta_column_4\",\"w.beta_column_5\",\"w.beta_column_6\",\"w.beta_column_7\"]}]},\"Planning Time\":0.5,\"Execution Time\":75000}]", 100)
    assert plan1 == Result.Ok(
        value: FormattedOutput(
            text: "○ Total Cost: 123,448\n○ Planning Time: \u001b[32m<1 ms\u001b[0m\n○ Execution Time: \u001b[31m1.25 m\u001b[0m\n\u001b[90m┬\u001b[0m\n\u001b[90m\u001b[0m\u001b[90m│\u001b[0m\n\u001b[90m\u001b[0m\u001b[90m├─⌠\u001b[0m \u001b[37mNested Loop\u001b[0m \u001b[37m\u001b[41mcostliest\u001b[0m \u001b[37m\u001b[41mlargest\u001b[0m \u001b[37m\u001b[41mbad estimate\u001b[0m\n\u001b[90m│ │ \u001b[0m\u001b[90mMerges two record sets by looping through every record in the first set and trying to find a\u001b[0m\n\u001b[90m│ │ \u001b[0m\u001b[90mmatch in the second set. All matching records are returned.\u001b[0m\n\u001b[90m│ │ \u001b[0m○ Duration: \u001b[31m2.35 s\u001b[0m (3%)\n\u001b[90m│ │ \u001b[0m○ Cost: 123,448 (100%)\n\u001b[90m│ │ \u001b[0m○ Rows: 5,000\n\u001b[90m│ │   \u001b[0mLeft \u001b[90mjoin\u001b[0m\n\u001b[90m│ │   \u001b[0m\u001b[90mrows\u001b[0m Underestimated \u001b[90mby\u001b[0m 500.00x\n\u001b[90m│ \u001b[0m\u001b[90m├►  \u001b[0m\u001b[36mx.alpha_column_1 + x.alpha_column_2 + x.alpha_column_3 + x.alpha_column_4 + x.alpha_column_5 +\u001b[0m\n\u001b[90m│ \u001b[0m\u001b[90m│  \u001b[0m\u001b[36mx.alpha_column_6 + x.alpha_column_7 + y.b\u001b[0m\n\u001b[90m│ \u001b[0m\u001b[90m│\u001b[0m\n\u001b[90m│ \u001b[0m\u001b[90m├─⌠\u001b[0m \u001b[37mIndex Scan\u001b[0m\u001b[90m [Forward]\u001b[0m \n\u001b[90m│ │ │ \u001b[0m\u001b[90mFinds relevant records based on an Index. Index Scans perform 2 read operations: one to read\u001b[0m\n\u001b[90m│ │ │ \u001b[0m\u001b[90mthe index and another to read the actual value from the table.\u001b[0m\n\u001b[90m│ │ │ \u001b[0m○ Duration: \u001b[33m450.75 ms\u001b[0m (1%)\n\u001b[90m│ │ │ \u001b[0m○ Cost: 8 (0%)\n\u001b[90m│ │ │ \u001b[0m○ Rows: 1\n\u001b[90m│ │ │   \u001b[0m\u001b[90mon\u001b[0m unknown.x\n\u001b[90m│ │ │   \u001b[0m\u001b[90musing\u001b[0m x_pkey\n\u001b[90m│ │ │   \u001b[0m\u001b[90mcondition\u001b[0m (x.a = 1)\n\u001b[90m│ │ \u001b[0m\u001b[90m│\u001b[0m\n\u001b[90m│ │ \u001b[0m\u001b[90m└─⌠\u001b[0m \u001b[37mMaterialize\u001b[0m \n\u001b[90m│ │   │ \u001b[0m\u001b[90mNot found : Materialize\u001b[0m\n\u001b[90m│ │   │ \u001b[0m○ Cost: 0 (0%)\n\u001b[90m│ │   │ \u001b[0m○ Rows: 0\n\u001b[90m│ \u001b[0m\u001b[90m│\u001b[0m\n\u001b[90m│ \u001b[0m\u001b[90m└─⌠\u001b[0m \u001b[37mCTEScan\u001b[0m \u001b[37m\u001b[41mslowest\u001b[0m\n\u001b[90m│   │ \u001b[0m\u001b[90mPerforms a sequential scan of Common Table Expression (CTE) query results. Note that results\u001b[0m\n\u001b[90m│   │ \u001b[0m\u001b[90mof a CTE are materialized (calculated and temporarily stored).\u001b[0m\n\u001b[90m│   │ \u001b[0m○ Duration: \u001b[31m1.17 m\u001b[0m (93%)\n\u001b[90m│   │ \u001b[0m○ Cost: 20 (0%)\n\u001b[90m│   │ \u001b[0m○ Rows: 50\n\u001b[90m│   │   \u001b[0m\u001b[90mfilter\u001b[0m (y.b > 0) \u001b[90m[-12,345 rows]\u001b[0m\n\u001b[90m│   │   \u001b[0m\u001b[90mon\u001b[0m (y.b = w.b)\n\u001b[90m│   │   \u001b[0mCTE w\n\u001b[90m│   │   \u001b[0m\u001b[90mrows\u001b[0m Overestimated \u001b[90mby\u001b[0m 20.00x\n\u001b[90m│   \u001b[0m\u001b[90m⌡► \u001b[0m\u001b[36mw.beta_column_1 + w.beta_column_2 + w.beta_column_3 + w.beta_column_4 + w.beta_column_5 +\u001b[0m\n\u001b[90m│   \u001b[0m\u001b[90m   \u001b[0m\u001b[36mw.beta_column_6 + w.beta_column_7\u001b[0m",
            items: 1,
        ),
    )
    call plan2 = visualize_explain_plans("[{\"Plan\":{\"Node Type\":\"Result\",\"Total Cost\":1,\"Plan Rows\":1,\"Actual Rows\":1,\"Actual Total Time\":0.5,\"Actual Loops\":1}}]", 100)
    assert plan2 == Result.Err(error: OutputError.Failed(message: "'Planning Time'"))

scenario style_text_sequences:
    call styled1 = style_text("a", "#00ff5f bold", "", false)
    assert styled1 == "\u001b[38;5;47;01ma\u001b[39;00m"
    call styled2 = style_text("a", "#00ff5f bold", "", true)
    assert styled2 == "\u001b[38;2;0;255;95;01ma\u001b[39;00m"
    call styled3 = style_text("x\n\ny", "bg:#eee #111", "", false)
    assert (styled3 == "\u001b[38;5;233;48;5;255mx\u001b[39;49m\n\n\u001b[38;5;233;48;5;255my\u001b[39;49m")
    call styled4 = style_text("+", "noinherit italic", "#d0d0d0 bold", false)
    assert styled4 == "\u001b[38;5;252;01;03m+\u001b[39;00m"
    call styled5 = style_text("q", "ansiwhite bg:ansiwhite underline", "", false)
    assert styled5 == "\u001b[01;11;04mq\u001b[39;49;00m"
    call styled6 = style_text("q", "transparent", "", true)
    assert styled6 == "q"
    call styled7 = style_text("q", "nobold ansigreen #abc", "bold", true)
    assert styled7 == "\u001b[38;2;170;187;204mq\u001b[39m"

scenario duration_words_mirror_test_main:
    call words1 = duration_in_words(0.0)
    assert words1 == "0 seconds"
    call words2 = duration_in_words(0.0009)
    assert words2 == "0.001 second"
    call words3 = duration_in_words(0.0005)
    assert words3 == "0.001 second"
    call words4 = duration_in_words(0.0004)
    assert words4 == "0.0 second"
    call words5 = duration_in_words(0.2)
    assert words5 == "0.2 second"

scenario timing_reports:
    call timing1 = timing_report(0.0123, 0.01)
    assert timing1 == "Time: 0.012s"
    call timing2 = timing_report(1.0, 0.5)
    assert timing2 == "Time: 1.000s"
    call timing3 = timing_report(75.25, 74.5)
    assert (timing3 == "Time: 75.250s (1 minute 15 seconds), executed in: 74.500s (1 minute 14 seconds)")
    call timing4 = timing_report(3725.0, 0.9996)
    assert (timing4 == "Time: 3725.000s (1 hour 2 minutes 5 seconds), executed in: 1.000s (1.0 second)")

