scenario completion_helpers_follow_upstream_rules:
    call escaped_users_upper = escape_identifier_name("Users")
    assert escaped_users_upper == "\"Users\""
    call escaped_count = escape_identifier_name("count")
    assert escaped_count == "\"count\""
    call escaped_a_b = escape_identifier_name("a b")
    assert escaped_a_b == "\"a b\""
    call alias_0 = generate_table_alias("_custom_fun", Map())
    assert alias_0 == "cf"
    call alias_1 = generate_table_alias("users", Map("users": "usr"))
    assert alias_1 == "usr"
    data sample_function: FunctionMetadata = FunctionMetadata(
        schema_name: "public",
        func_name: "f",
        arg_names: Option.Some(value: List("a", "bb", "ccc", "d")),
        arg_types: Option.Some(value: List("integer", "integer", "text", "integer")),
        arg_modes: Option.Some(value: List("i", "i", "i", "o")),
        return_type: "record",
        is_aggregate: false,
        is_window: false,
        is_set_returning: false,
        is_extension: false,
        arg_defaults: Option.Some(value: "5, 'x'::text"),
    )

scenario prevalence_counts_keywords_and_names:
    call fresh = prevalence_from(Map(), Map())
    call counted_handle = update_prevalence(fresh, "SELECT * FROM foo WHERE bar GROUP BY baz;\n             select * from foo;\n             SELECT * FROM foo WHERE bar GROUP\n             BY baz", false)
    call counted = prevalence_counts(counted_handle)
    assert counted == Prevalence(
        keyword_counts: Map("BY": 2, "FROM": 3, "GROUP BY": 2, "SELECT": 3, "WHERE": 2),
        name_counts: Map("foo": 3, "bar": 2, "baz": 2),
    )
    call untouched = prevalence_counts(fresh)
    assert untouched == Prevalence(keyword_counts: Map(), name_counts: Map())

scenario suggestions_follow_statement_context:
    call suggested_0 = suggest_sql_completions("SELECT  FROM tabl", "SELECT ")
    assert suggested_0 == List(
        Suggestion.Column(
            table_refs: List(
                TableReference(
                    schema: Option.Nothing,
                    name: "tabl",
                    alias_name: Option.Nothing,
                    is_function: false,
                ),
            ),
            require_last_table: false,
            local_tables: List(),
            qualifiable: true,
            context: Option.Nothing,
        ),
        Suggestion.Function(schema: Option.Nothing, table_refs: List(), usage: FunctionUsage.Call),
        Suggestion.Keyword(last_token: Option.Some(value: "SELECT")),
    )
    call suggested_1 = suggest_sql_completions("SELECT * FROM ", "SELECT * FROM ")
    assert suggested_1 == List(
        Suggestion.Schema(quoted: false),
        Suggestion.FromClauseItem(schema: Option.Nothing, table_refs: List(), local_tables: List()),
    )
    call suggested_2 = suggest_sql_completions("select * from abc a join def d on ", "select * from abc a join def d on ")
    assert suggested_2 == List(
        Suggestion.Alias(aliases: List("a", "d")),
        Suggestion.JoinCondition(
            table_refs: List(
                TableReference(
                    schema: Option.Nothing,
                    name: "abc",
                    alias_name: Option.Some(value: "a"),
                    is_function: false,
                ),
                TableReference(
                    schema: Option.Nothing,
                    name: "def",
                    alias_name: Option.Some(value: "d"),
                    is_function: false,
                ),
            ),
            parent: Option.Nothing,
        ),
    )
    call suggested_3 = suggest_sql_completions("SELECT * FROM users u JOIN ", "SELECT * FROM users u JOIN ")
    assert suggested_3 == List(
        Suggestion.Schema(quoted: false),
        Suggestion.FromClauseItem(
            schema: Option.Nothing,
            table_refs: List(
                TableReference(
                    schema: Option.Nothing,
                    name: "users",
                    alias_name: Option.Some(value: "u"),
                    is_function: false,
                ),
            ),
            local_tables: List(),
        ),
        Suggestion.Join(
            table_refs: List(
                TableReference(
                    schema: Option.Nothing,
                    name: "users",
                    alias_name: Option.Some(value: "u"),
                    is_function: false,
                ),
            ),
            schema: Option.Nothing,
        ),
    )

scenario public_completion:
    call catalog = completion_catalog_from(public_metadata)
    call no_counts = prevalence_from(Map(), Map())
    call preferred_counts = prevalence_from(Map("MAXEXTENTS": 2), Map("users": 3))
    data local_plain_settings: CompleterSettings = plain_settings
    call builtins_list = complete_sql_text(
        CompletionRequest(
            text: "SELECT MA",
            cursor: 9,
            smart_completion: true,
            catalog: catalog,
            settings: local_plain_settings,
            prevalence: no_counts,
            special_commands: List(),
            named_queries: List(),
            table_formats: List(),
        ),
    )
    call builtins = completion_lines(builtins_list, 150)
    assert builtins == List(
        "MAKE_DATE | -2 | MAKE_DATE | function",
        "MAKE_INTERVAL | -2 | MAKE_INTERVAL | function",
        "MAKE_TIME | -2 | MAKE_TIME | function",
        "MAKE_TIMESTAMP | -2 | MAKE_TIMESTAMP | function",
        "MAKE_TIMESTAMPTZ | -2 | MAKE_TIMESTAMPTZ | function",
        "MASKLEN | -2 | MASKLEN | function",
        "MAX | -2 | MAX | function",
        "MATERIALIZED VIEW | -2 | MATERIALIZED VIEW | keyword",
        "MAXEXTENTS | -2 | MAXEXTENTS | keyword",
    )
    call signature_list = complete_sql_text(
        CompletionRequest(
            text: "DROP FUNCTION set_ret",
            cursor: 21,
            smart_completion: true,
            catalog: catalog,
            settings: local_plain_settings,
            prevalence: no_counts,
            special_commands: List(),
            named_queries: List(),
            table_formats: List(),
        ),
    )
    call signature = completion_lines(signature_list, 150)
    assert signature == List(
        "set_returning_func(x integer, y integer) | -7 | set_returning_func(x integer, y integer) | function",
    )
    call from_items_list = complete_sql_text(
        CompletionRequest(
            text: "SELECT * FROM ",
            cursor: 14,
            smart_completion: true,
            catalog: catalog,
            settings: alias_settings,
            prevalence: no_counts,
            special_commands: List(),
            named_queries: List(),
            table_formats: List(),
        ),
    )
    call from_items = completion_lines(from_items_list, 150)
    assert from_items == List(
        "public | 0 | public | schema",
        "\"select\" s | 0 | \"select\" s | table",
        "\"Users\" U | 0 | \"Users\" U | table",
        "orders o | 0 | orders o | table",
        "users u | 0 | users u | table",
        "functions f | 0 | functions f | view",
        "user_emails ue | 0 | user_emails ue | view",
        "_custom_fun() cf | 0 | _custom_fun() cf | function",
        "custom_fun() cf | 0 | custom_fun() cf | function",
        "custom_func1() cf | 0 | custom_func1() cf | function",
        "custom_func2() cf | 0 | custom_func2() cf | function",
        "set_returning_func(x := , y := ) srf | 0 | set_returning_func(x, y) srf | function",
    )
    call fuzzy_items_list = complete_sql_text(
        CompletionRequest(
            text: "SELECT * FROM us",
            cursor: 16,
            smart_completion: true,
            catalog: catalog,
            settings: local_plain_settings,
            prevalence: no_counts,
            special_commands: List(),
            named_queries: List(),
            table_formats: List(),
        ),
    )
    call first_builtins = completion_items(builtins_list, 2)
    assert first_builtins == List(
        CompletionItem(
            text: "MAKE_DATE",
            start_position: -2,
            display: "MAKE_DATE",
            display_meta: "function",
        ),
        CompletionItem(
            text: "MAKE_INTERVAL",
            start_position: -2,
            display: "MAKE_INTERVAL",
            display_meta: "function",
        ),
    )
    call signature_items = completion_items(signature_list, 5)
    assert signature_items == List(
        CompletionItem(
            text: "set_returning_func(x integer, y integer)",
            start_position: -7,
            display: "set_returning_func(x integer, y integer)",
            display_meta: "function",
        ),
    )
    call no_items = completion_items(from_items_list, 0)
    assert no_items == List()

scenario cased_completion:
    call catalog = completion_catalog_from(cased_metadata)
    call unqualified_catalog = catalog_with_search_path(catalog, List())
    call empty_catalog = empty_completion_catalog()
    call cased_id = apply_identifier_casing(catalog, "id")
    assert cased_id == "ID"
    call uncased_id = apply_identifier_casing(catalog, "Id")
    assert uncased_id == "Id"
    call no_counts = prevalence_from(Map(), Map())
    data local_lower_settings: CompleterSettings = lower_settings
    data local_plain_settings: CompleterSettings = plain_settings
    call cased_items_list = complete_sql_text(
        CompletionRequest(
            text: "SELECT * FROM ",
            cursor: 14,
            smart_completion: true,
            catalog: catalog,
            settings: local_lower_settings,
            prevalence: no_counts,
            special_commands: List(),
            named_queries: List(),
            table_formats: List(),
        ),
    )
