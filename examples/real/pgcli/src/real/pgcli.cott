module real.pgcli

enum ConnectionError:
    MissingDatabase
    InvalidPort(value: Str)
    InvalidDsn(value: Str)
    ProfileMissing(name: Str)
    TlsInvalid(message: Str)
    SshInvalid(message: Str)
    CredentialUnavailable(message: Str)
    PromptDisabled
    ConnectionFailed(message: Str)

enum DatabaseError:
    ConnectionFailed(message: Str)
    QueryFailed(message: Str)

enum ClientError:
    InvalidCommand(source: Str)
    InvalidSql(message: Str)
    CatalogFailed(message: Str)
    QueryFailed(message: Str)
    TransactionFailed(message: Str)
    ImportFailed(path: Path, message: Str)
    ExportFailed(path: Path, message: Str)
    HistoryFailed(path: Path, message: Str)
    FavoriteFailed(name: Str)
    EditorFailed(message: Str)
    PagerFailed(message: Str)
    NotificationFailed(message: Str)
    TerminalFailed(message: Str)
    UnsupportedFormat(value: Str)

struct ConnectionInputs:
    host: Str
    port: Str
    user: Str
    password: Str
    database: Str

struct EnvironmentInputs:
    host: Str
    port: Str
    user: Str
    password: Str
    database: Str

struct ConnectionSettings:
    host: Str
    port: Str
    user: Str
    password: Str
    database: Str

struct TlsSettings:
    mode: Str
    root_certificate: Path
    certificate: Path
    private_key: Path

struct SshSettings:
    host: Str
    port: U16
    user: Str
    private_key: Path

struct ConnectionProfile:
    name: Str
    dsn: Str
    inputs: ConnectionInputs
    tls: TlsSettings
    ssh: Option[SshSettings]

struct ConnectionRequest:
    dsn: Str
    profile: Str
    inputs: ConnectionInputs
    environment: EnvironmentInputs
    tls: TlsSettings
    ssh: Option[SshSettings]

struct ConnectionPlan:
    settings: ConnectionSettings
    dsn: Str
    tls: TlsSettings
    ssh: Option[SshSettings]

enum PasswordSource:
    Supplied
    Environment
    Keyring
    Prompt
    None

enum PromptAction:
    UsePassword
    PromptPassword

struct CredentialRequest:
    service: Str
    user: Str
    supplied_password: Str
    environment_password: Str
    no_prompt: Bool
    use_keyring: Bool

struct CredentialResolution:
    password: Str
    source: PasswordSource

struct ColumnCatalog:
    name: Str

struct TableCatalog:
    schema: Str
    name: Str
    columns: List[ColumnCatalog]

struct RelationCatalog:
    schema: Str
    name: Str
    kind: Str
    columns: List[ColumnCatalog]

struct RoutineCatalog:
    schema: Str
    name: Str
    arguments: Str
    result_type: Str

struct Catalog:
    databases: List[Str]
    schemas: List[Str]
    relations: List[RelationCatalog]
    routines: List[RoutineCatalog]
    roles: List[Str]
    extensions: List[Str]
    publications: List[Str]
    subscriptions: List[Str]
    refreshed_at_ms: U64
    limit: U64

struct CatalogRefreshRequest:
    connection: ConnectionPlan
    include_system: Bool
    limit: U64

struct CompletionRequest:
    source: Str
    cursor: U64
    catalog: List[TableCatalog]

struct CompletionPolicy:
    max_candidates: U64
    include_keywords: Bool

struct CompletionResult:
    candidates: List[Str]
    replace_start: U64

struct HighlightRequest:
    source: Str
    color: Bool

struct HighlightedSql:
    text: Str
    contains_error: Bool

enum RenderLayout:
    Horizontal
    Vertical

enum TableFormat:
    Aligned
    Csv
    Tsv
    Json
    JsonLines
    Html
    Latex
    Markdown
    Vertical

struct RenderRequest:
    columns: List[Str]
    rows: List[List[Str]]
    terminal_width: U16
    vertical: Bool

struct FormatRequest:
    query: QueryResult
    format: TableFormat
    terminal_width: U16
    max_column_width: U16
    max_rows: U64

struct RenderedQuery:
    text: Str
    layout: RenderLayout
    width: U16

struct FormattedQuery:
    rendered: RenderedQuery
    truncated_rows: U64

struct QueryResult:
    columns: List[Str]
    rows: List[List[Str]]

struct ExecutedQuery:
    result: QueryResult
    status: Str
    affected_rows: U64
    elapsed_ms: U64
    notices: List[Str]

struct QueryRequest:
    connection: ConnectionPlan
    sql: Str
    max_rows: U64
    transaction: TransactionMode
    timing: Bool

struct QueryPlan:
    sql: Str
    statement_count: U64
    requires_terminator: Bool

struct InputBuffer:
    text: Str
    cursor: U64
    multiline: Bool

struct EditorRequest:
    buffer: InputBuffer
    editor: Str
    temporary_path: Path

struct PagerRequest:
    text: Str
    pager: Str
    enabled: Bool
    terminal_height: U16

doc """
History persistence is UTF-8 JSON: one array in oldest-to-newest stored order,
with exact object fields sql (string), executed_at_ms (integer 0..2^64-1, never
boolean), database (string), success (boolean). This is this Cott client's format,
not upstream pgcli's query-text-only history. No timestamp is inferred or rewritten.
"""
struct HistoryEntry:
    sql: Str
    executed_at_ms: U64
    database: Str
    success: Bool

doc """
Normalize history by preserving stored order, optionally deduplicating exact
(database, sql) pairs when unique is true. Keep each pair's last occurrence, then
retain the last max_entries entries in their original relative order. A zero
capacity produces an empty list. Do not sort by executed_at_ms.
"""
struct HistoryPolicy:
    path: Path
    max_entries: U64
    unique: Bool

doc """
Favorites persistence is UTF-8 JSON: one array in authored order, with exact object
fields name (string), sql (string), tags (array of strings). No unknown/missing
fields or coercions. Names are nonempty and unique by exact case-sensitive spelling;
tags may repeat and retain their order. This is this Cott client's format, not an
upstream pgcli configuration section.
"""
struct Favorite:
    name: Str
    sql: Str
    tags: List[Str]

struct FavoriteStore:
    path: Path
    max_entries: U64

struct ExportRequest:
    sql: Str
    target: Path
    format: TableFormat
    delimiter: Str
    header: Bool
    max_rows: U64

struct ImportRequest:
    table: Str
    source: Path
    delimiter: Str
    header: Bool
    null_text: Str
    max_rows: U64

struct TransferResult:
    rows: U64
    path: Path

struct Notification:
    channel: Str
    payload: Str
    pid: U32

struct NotificationRequest:
    connection: ConnectionPlan
    channels: List[Str]
    timeout_ms: U32
    max_notifications: U64

struct WatchRequest:
    query: QueryRequest
    interval_ms: U32
    max_iterations: U64

struct WatchResult:
    executions: U64
    last_result: ExecutedQuery

enum TransactionMode:
    AutoCommit
    Manual
    ReadOnly

struct TransactionState:
    mode: TransactionMode
    active: Bool
    failed: Bool

enum BackslashCommand:
    Quit
    Help
    Tables
    Describe
    Unknown

enum MetaCommand:
    Quit
    Shell(command: Str)
    RefreshCatalog
    Help
    SqlHelp(topic: Str)
    SetFormat(format: TableFormat)
    Connect(database: Str)
    ConnectionInfo
    Copy(table: Str, path: Path, from_file: Bool)
    Describe(pattern: Str)
    ListDomains(pattern: Str)
    ListForeignTables(pattern: Str)
    ListTextSearchConfigurations(pattern: Str)
    ListDataTypes(pattern: Str)
    ListTablespaces(pattern: Str)
    ListDefaultPrivileges(pattern: Str)
    ListFunctions(pattern: Str)
    ListIndexes(pattern: Str)
    ListMaterializedViews(pattern: Str)
    ListSchemas(pattern: Str)
    ListPrivileges(pattern: Str)
    ListSequences(pattern: Str)
    ListTables(pattern: Str)
    ListRoles
    ListViews(pattern: Str)
    ListExtensions
    ListDatabases
    ShowFunction(pattern: Str)
    EditBuffer
    Echo(text: Str)
    ReadFile(path: Path)
    ReadRelativeFile(path: Path)
    NamedQuery(name: Str, arguments: List[Str])
    SetLogFile(path: Path)
    DeleteNamedQuery(name: Str)
    PrintNamedQuery(name: Str)
    SaveNamedQuery(name: Str, sql: Str)
    SetOutput(path: Path)
    ClearOutput
    SetPager(enabled: Bool)
    SetOptions(key: Str, value: Str)
    QueryOutputEcho(text: Str)
    Timing
    VerboseErrors(enabled: Bool)
    Watch(interval_ms: U32)
    Expanded
    ExecuteBuffer
    ExecuteExpanded
    PrintBuffer
    ResetBuffer
    WriteBuffer(path: Path)
    History(pattern: Str)
    Favorite(name: Str)
    ListFavorites(pattern: Str)
    DeleteFavorite(name: Str)
    Password
    ListNotifications
    Unknown(source: Str)

struct CommandInvocation:
    command: MetaCommand
    buffer: InputBuffer

struct SessionOptions:
    connection: ConnectionPlan
    catalog_limit: U64
    completion_limit: U64
    history: HistoryPolicy
    favorites: FavoriteStore
    format: TableFormat
    timing: Bool
    pager: Bool
    multiline: Bool
    transaction: TransactionMode

struct CommandResult:
    buffer: InputBuffer
    output: Str
    quit: Bool

struct InteractiveRequest:
    options: SessionOptions
    initial_sql: Str
    execute_once: Bool

fn parse_dsn(value: Str) -> Result[ConnectionInputs, ConnectionError]:
    ensures Result.Ok(inputs) => inputs.database != ""

    error ConnectionError.InvalidDsn

    effects []

fn resolve_profile(
    name: Str,
    profiles: List[ConnectionProfile],
) -> Result[ConnectionProfile, ConnectionError]:
    ensures Result.Ok(profile) => profile.name == name

    error ConnectionError.ProfileMissing

    effects []

fn resolve_connection(
    inputs: ConnectionInputs,
    environment: EnvironmentInputs,
) -> Result[ConnectionSettings, ConnectionError]:
    ensures Result.Ok(settings) => ((inputs.host != "" and settings.host == inputs.host) or (inputs.host == "" and settings.host == environment.host))
    ensures Result.Ok(settings) => ((inputs.port != "" and settings.port == inputs.port) or (inputs.port == "" and settings.port == environment.port))
    ensures Result.Ok(settings) => ((inputs.user != "" and settings.user == inputs.user) or (inputs.user == "" and settings.user == environment.user))
    ensures Result.Ok(settings) => ((inputs.password != "" and settings.password == inputs.password) or (inputs.password == "" and settings.password == environment.password))
    ensures Result.Ok(settings) => ((inputs.database != "" and settings.database == inputs.database) or (inputs.database == "" and settings.database == environment.database))

    error ConnectionError.MissingDatabase
    error ConnectionError.InvalidPort

    effects []

fn resolve_connection_plan(
    request: ConnectionRequest,
    profile: Option[ConnectionProfile],
) -> Result[ConnectionPlan, ConnectionError]:
    ensures Result.Ok(plan) => plan.settings.database != ""

    error ConnectionError.MissingDatabase
    error ConnectionError.InvalidPort
    error ConnectionError.InvalidDsn
    error ConnectionError.TlsInvalid
    error ConnectionError.SshInvalid

    effects []

fn prompt_policy(no_prompt: Bool, password: Str) -> Result[PromptAction, ConnectionError]:
    ensures Result.Ok(action) => ((password != "" and action == PromptAction.UsePassword) or (password == "" and action == PromptAction.PromptPassword))

    error ConnectionError.PromptDisabled when no_prompt and password == ""

    effects []

fn resolve_credential(request: CredentialRequest) -> Result[CredentialResolution, ConnectionError]:
    doc """
    Resolve a password with short-circuit priority: nonempty supplied_password
    returns Supplied; otherwise nonempty environment_password returns Environment.
    Those fields are already resolved input, so do not read process environment.
    Otherwise, if use_keyring is true, require nonempty service and user and call
    the lock-selected keyring.get_password(service, user). A nonempty result
    returns Keyring. A None or empty result means no stored credential and proceeds
    to the prompt policy. A backend/lookup failure returns CredentialUnavailable
    with a fixed nonsecret message; never write/delete a keyring entry.
    If still unresolved and no_prompt is true, return PromptDisabled without
    reading stdin or opening the terminal. Otherwise prompt exactly once using
    getpass.getpass with a fixed "Password: " prompt. Do not permit its echoed-input
    fallback: treat getpass.GetPassWarning as an error. A nonempty response returns
    Prompt; an explicitly submitted empty response returns password="" with
    PasswordSource.None (passwordless authentication). EOF, cancellation, terminal
    or hidden-input failure returns CredentialUnavailable without echoing secrets.
    Never log or include any password, service credential or raw exception in errors.
    """

    ensures Result.Ok(resolution) => (resolution.password != "" or resolution.source == PasswordSource.None)

    error ConnectionError.CredentialUnavailable
    error ConnectionError.PromptDisabled

    effects [file.read, file.write, network]

fn connect(plan: ConnectionPlan) -> Result[Unit, ConnectionError]:
    doc """
    Probe an authenticated PostgreSQL session using the lock-selected psycopg
    driver, execute SELECT 1, and close it before returning Unit. This function
    does not install a global session or retain a transaction or SSH daemon.
    A real successful query, not an open TCP socket, establishes success.
    
    Parse plan.dsn with psycopg.conninfo.conninfo_to_dict (empty means no DSN).
    Nonempty settings.host, port, user, password and database override the DSN's
    corresponding host, port, user, password and dbname; empty settings leave
    the DSN value in place. Require a nonempty resolved dbname. Validate a supplied
    port as decimal 1..65535; the default port is 5432. Pass connection parameters
    as psycopg keyword arguments, never SQL or shell text.
    plan.tls.mode overrides sslmode: empty means prefer; otherwise accept exactly
    disable, allow, prefer, require, verify-ca, verify-full. The Path value "."
    means an omitted certificate path. Other root_certificate, certificate and
    private_key paths override sslrootcert, sslcert and sslkey respectively.
    The certificate and private key are supplied together or both omitted.
    Invalid DSN/port/TLS data maps to ConnectionFailed, the only declared error.
    Set connect_timeout=10 regardless of DSN and issue no application writes.
    
    Without SSH connect directly. With Some(ssh), use the installed OpenSSH ssh
    executable with an argument vector, never a shell. Validate nonempty jump
    host/user, positive port, and a single remote database host (no comma-separated
    host list, Unix socket or control characters). Preserve the resolved database
    hostname for TLS verification, but connect to the loopback tunnel using
    hostaddr=127.0.0.1 and the allocated local port. Missing remote host defaults
    to localhost from the jump host's perspective.
    Launch a foreground control master with -M -N, a private mode-0700 temporary
    directory and control socket, BatchMode=yes, StrictHostKeyChecking=yes,
    ExitOnForwardFailure=yes, ConnectTimeout=10, ControlPersist=no and
    GatewayPorts=no. Existing known_hosts is authority: never accept an unknown
    key automatically. Use -p and -l for jump port/user; private_key "." means
    no explicit identity file, otherwise use -i. Reject jump host beginning "-".
    Wait at most ten monotonic seconds for ssh -S socket -O check to succeed.
    Allocate a loopback-only port through a short-lived bound socket, then ask
    the authenticated master with -O forward -L 127.0.0.1:port:dbhost:dbport.
    Quote IPv6 hosts with forwarding-syntax brackets. A bind race is a declared
    failure, never permission to connect through an unconfirmed forwarding.
    Confirm the control request succeeded before contacting PostgreSQL.
    All ssh commands are bounded; stdin is DEVNULL, no password prompt or shell,
    no password in argv, and subprocess output is not copied into diagnostics.
    
    On every path close the psycopg connection, request control-master exit,
    terminate then kill and wait for a still-running owned foreground process,
    and remove the temporary control directory. Never kill an unrelated PID.
    All validation, driver, authentication, TLS, SSH, query, timeout or cleanup
    failures return ConnectionFailed with a fixed nonsecret category message;
    never include a DSN, password, private-key contents or raw exception text.
    """

    ensures Result.Ok(connected) => connected == ()

    error ConnectionError.ConnectionFailed

    effects [network, database.read, database.write, file.read, file.write, clock]

fn refresh_catalog(request: CatalogRefreshRequest) -> Result[Catalog, ClientError]:
    ensures Result.Ok(catalog) => catalog.limit == request.limit
    ensures Result.Ok(catalog) => catalog.relations.len <= request.limit

    error ClientError.CatalogFailed

    effects [database.read, clock]

fn complete_sql(request: CompletionRequest) -> CompletionResult:
    effects []

fn complete_catalog_sql(request: CompletionRequest, policy: CompletionPolicy) -> CompletionResult:
    ensures result.candidates.len <= policy.max_candidates

    effects []

fn highlight_sql(request: HighlightRequest) -> HighlightedSql:
    effects []

fn plan_query(buffer: InputBuffer) -> Result[QueryPlan, ClientError]:
    ensures Result.Ok(plan) => plan.sql == buffer.text

    error ClientError.InvalidSql

    effects []

fn edit_multiline(buffer: InputBuffer, input: Str) -> InputBuffer:
    ensures result.cursor <= result.text.len

    effects []

fn recognize_backslash(source: Str) -> BackslashCommand:
    effects []

fn parse_meta_command(source: Str) -> MetaCommand:
    effects []

fn render_query(request: RenderRequest) -> RenderedQuery:
    effects []

fn format_query(request: FormatRequest) -> FormattedQuery:
    ensures result.truncated_rows <= request.max_rows

    effects []

fn execute_query(connection: ConnectionSettings, sql: Str) -> Result[QueryResult, DatabaseError]:
    ensures Result.Ok(query_result) => query_result.rows.len == 0 or query_result.columns.len > 0

    error DatabaseError.ConnectionFailed
    error DatabaseError.QueryFailed

    effects [database.read, database.write]

fn execute_planned_query(request: QueryRequest) -> Result[ExecutedQuery, ClientError]:
    ensures Result.Ok(executed) => executed.result.rows.len <= request.max_rows

    error ClientError.QueryFailed
    error ClientError.TransactionFailed

    effects [database.read, database.write, clock]

fn begin_transaction(mode: TransactionMode) -> TransactionState:
    ensures result.mode == mode

    effects [database.write]

fn commit_transaction(transaction: TransactionState) -> Result[TransactionState, ClientError]:
    ensures Result.Ok(committed) => not committed.active

    error ClientError.TransactionFailed

    effects [database.write]

fn rollback_transaction(transaction: TransactionState) -> Result[TransactionState, ClientError]:
    ensures Result.Ok(rolled_back) => not rolled_back.active

    error ClientError.TransactionFailed

    effects [database.write]

fn load_history(policy: HistoryPolicy) -> Result[List[HistoryEntry], ClientError]:
    doc """
    Read policy.path as the HistoryEntry JSON format and apply HistoryPolicy
    normalization only after validating every row, including rows later trimmed.
    A missing file is an empty success. Invalid UTF-8/JSON/field types, a non-array
    root, a non-regular or symlink leaf, and other I/O failures return
    HistoryFailed(path=policy.path, message=a fixed nonsecret category).
    Reject files larger than 16 MiB using a bounded read; do not execute file content.
    """

    ensures Result.Ok(entries) => entries.len <= policy.max_entries

    error ClientError.HistoryFailed

    effects [file.read]

fn save_history(policy: HistoryPolicy, entries: List[HistoryEntry]) -> Result[Unit, ClientError]:
    doc """
    Apply HistoryPolicy normalization, then write the HistoryEntry JSON format
    with ensure_ascii=False, compact separators and one final newline. Preserve
    field values exactly and reject serialized data larger than 16 MiB.
    Replace policy.path atomically using an exclusive same-directory temporary
    file, mode 0600, flush/fsync then os.replace, followed by parent directory fsync.
    Parent directories are not created. Reject a symlink/non-regular existing leaf.
    On precommit failure preserve the original and remove the temporary file.
    Return HistoryFailed(path=policy.path, message=a fixed nonsecret category) for
    serialization or I/O failure; never leave a partially truncated history file.
    """

    ensures Result.Ok(saved) => saved == ()

    error ClientError.HistoryFailed

    effects [file.write]

fn remember_history(
    policy: HistoryPolicy,
    entries: List[HistoryEntry],
    entry: HistoryEntry,
) -> List[HistoryEntry]:
    doc """
    Append entry to entries, then apply the exact HistoryPolicy normalization.
    This is pure list transformation with no clock or filesystem access.
    """

    ensures result.len <= policy.max_entries

    effects []

fn load_favorites(store: FavoriteStore) -> Result[List[Favorite], ClientError]:
    doc """
    Read store.path as the Favorite JSON format; a missing file is an empty success.
    Preserve all valid entries in file order; more than store.max_entries is an
    error, not truncation. Validate every row, including tags and duplicate names.
    Reject invalid UTF-8/JSON, files over 16 MiB, non-regular/symlink leaves and
    genuine I/O failures. Return FavoriteFailed(name=str(store.path)) for all file,
    shape, duplicate-name or capacity failures. Do not silently skip invalid rows.
    """

    ensures Result.Ok(favorites) => favorites.len <= store.max_entries

    error ClientError.FavoriteFailed

    effects [file.read]

fn save_favorites(store: FavoriteStore, favorites: List[Favorite]) -> Result[Unit, ClientError]:
    doc """
    Validate Favorite names and capacity exactly as the persistence format requires,
    retaining input order. Write UTF-8 JSON with ensure_ascii=False, compact
    separators and one newline; reject serialized data over 16 MiB.
    Use an exclusive same-directory temporary file, mode 0600, flush/fsync,
    os.replace and parent fsync. Do not create parents or follow symlink leaves;
    preserve the old file and remove the temporary file on precommit failure.
    Every validation/serialization/I/O failure is FavoriteFailed(name=str(store.path)).
    """

    ensures Result.Ok(saved) => saved == ()

    error ClientError.FavoriteFailed

    effects [file.write]

fn import_delimited(
    plan: ConnectionPlan,
    request: ImportRequest,
) -> Result[TransferResult, ClientError]:
    ensures Result.Ok(imported) => imported.rows <= request.max_rows

    error ClientError.ImportFailed
    error ClientError.QueryFailed

    effects [file.read, database.write]

fn export_query(
    plan: ConnectionPlan,
    request: ExportRequest,
) -> Result[TransferResult, ClientError]:
    ensures Result.Ok(exported) => exported.rows <= request.max_rows

    error ClientError.ExportFailed
    error ClientError.QueryFailed

    effects [database.read, file.write]

fn edit_in_editor(request: EditorRequest) -> Result[InputBuffer, ClientError]:
    ensures Result.Ok(buffer) => buffer.cursor <= buffer.text.len

    error ClientError.EditorFailed

    effects [file.read, file.write]

fn page_output(request: PagerRequest) -> Result[Unit, ClientError]:
    ensures Result.Ok(paged) => paged == ()

    error ClientError.PagerFailed

    effects [file.read, file.write]

fn receive_notifications(request: NotificationRequest) -> Result[List[Notification], ClientError]:
    ensures Result.Ok(notifications) => notifications.len <= request.max_notifications

    error ClientError.NotificationFailed

    effects [database.read, clock]

fn watch_query(request: WatchRequest) -> Result[WatchResult, ClientError]:
    ensures Result.Ok(watched) => watched.executions <= request.max_iterations

    error ClientError.QueryFailed
    error ClientError.TransactionFailed

    effects [database.read, database.write, clock]

fn run_meta_command(
    invocation: CommandInvocation,
    options: SessionOptions,
    catalog: Catalog,
) -> Result[CommandResult, ClientError]:
    ensures Result.Ok(step) => step.quit or step.buffer.cursor <= step.buffer.text.len

    error ClientError.InvalidCommand
    error ClientError.CatalogFailed
    error ClientError.QueryFailed
    error ClientError.TransactionFailed
    error ClientError.ImportFailed
    error ClientError.ExportFailed
    error ClientError.HistoryFailed
    error ClientError.FavoriteFailed
    error ClientError.EditorFailed
    error ClientError.PagerFailed
    error ClientError.NotificationFailed

    effects [file.read, file.write, database.read, database.write, clock]

fn run_interactive(request: InteractiveRequest) -> Result[Unit, ClientError]:
    ensures Result.Ok(finished) => finished == ()

    error ClientError.InvalidCommand
    error ClientError.InvalidSql
    error ClientError.CatalogFailed
    error ClientError.QueryFailed
    error ClientError.TransactionFailed
    error ClientError.HistoryFailed
    error ClientError.FavoriteFailed
    error ClientError.EditorFailed
    error ClientError.PagerFailed
    error ClientError.NotificationFailed
    error ClientError.TerminalFailed

    effects [file.read, file.write, network, database.read, database.write, clock]

fn run(arguments: List[Str]) -> Never:
    doc """
    Run a real psycopg line-oriented PostgreSQL REPL. arguments excludes argv[0].
    Use argparse with program name pgcli-cott, optional positional DSN, -h/--host,
    -p/--port, -U/--username, -d/--dbname, -c/--command and --help. Reserve -h for
    host, not help. Unknown or malformed arguments print usage to stderr and exit 2;
    --help prints usage and exits 0 without connecting. Nonempty supplied flags
    override the DSN; unspecified connection fields retain libpq defaults and
    PGHOST/PGPORT/PGUSER/PGDATABASE/PGPASSWORD environment behavior. Never accept a
    password argument, echo credentials or disable the DSN's TLS verification.
    Connect once using psycopg.connect with autocommit=True and connect_timeout=10.
    With -c, execute that complete SQL string once. Otherwise read one complete
    SQL command per stdin line (no multiline parser); skip empty lines and leave
    on a line equal to \q or quit after stripping. EOF is normal termination.
    Print "pgcli> " only when stdin is a terminal. Execute SQL through a real
    cursor; for row results print tab-separated column names followed by rows in
    driver order, rendering SQL NULL as NULL and other cells with str. For
    commands without rows print cursor.statusmessage when nonempty.
    On a query error print only a fixed "query failed" message to stderr; in -c
    mode exit 1, otherwise continue accepting lines but remember failure. Normal
    EOF/quit exits 0 if every query succeeded, otherwise 1. Connection or I/O
    failure exits 1 with a fixed category message. KeyboardInterrupt exits 130.
    Close every cursor and the connection before sys.exit; never log raw exception
    text or leave a background connection. This entrypoint does not create a hidden
    global session or infer a richer argument grammar from the upstream project.
    """

    effects [
        file.read,
        file.write,
        network,
        database.read,
        database.write,
        clock,
        random,
        process.exit,
    ]
