module frogmouth.history

use frogmouth.model.{Location, LocationKind}

doc """
The maximum number of locations kept in the browsing history.
"""
const MAXIMUM_HISTORY_LENGTH: U64 = 256

doc """
The browsing history, oldest location first. current is the index of the
history position the viewer is at; it is 0 in an empty history.
"""
struct History:
    locations: List[Location]
    current: U64

    invariant self.locations.len <= MAXIMUM_HISTORY_LENGTH
    invariant ((self.locations.len == 0 and self.current == 0) or self.current < self.locations.len)

doc """
One row of the history pane. history_id is the index of location in
History.locations; prompt is Rich console markup.
"""
struct HistoryEntry:
    history_id: U64
    location: Location
    prompt: Str

fn start_history(locations: List[Location]) -> History:
    doc """
    A history holding the newest MAXIMUM_HISTORY_LENGTH of locations (the
    oldest are dropped), in order, positioned at the newest location.
    """

    ensures ((locations.len <= MAXIMUM_HISTORY_LENGTH) => result.locations == locations)
    ensures ((locations.len > MAXIMUM_HISTORY_LENGTH) => result.locations.len == MAXIMUM_HISTORY_LENGTH)
    ensures ((result.locations.len > 0) => result.current + 1 == result.locations.len)

    effects []

fn current_location(history: History) -> Option[Location]:
    doc """
    The location at history.current, or Nothing for an empty history.
    """

    ensures Option.Some(_) => history.locations.len > 0
    ensures Option.Nothing => history.locations.len == 0

    effects []

fn remember_location(history: History, location: Location) -> History:
    doc """
    Record a newly viewed location: append it as the newest entry, even when
    it equals an existing entry, drop the oldest entry when the history would
    exceed MAXIMUM_HISTORY_LENGTH, and move current to the newest entry.
    Entries after current are kept.
    """

    ensures result.current + 1 == result.locations.len
    ensures ((history.locations.len < MAXIMUM_HISTORY_LENGTH) => result.locations.len == history.locations.len + 1)
    ensures ((history.locations.len == MAXIMUM_HISTORY_LENGTH) => result.locations.len == MAXIMUM_HISTORY_LENGTH)

    effects []

fn step_back(history: History) -> Option[History]:
    doc """
    Move one entry toward the oldest location, or Nothing when already at the
    oldest (or empty).
    """

    ensures Option.Some(moved) => moved.current + 1 == history.current
    ensures Option.Some(moved) => moved.locations == history.locations
    ensures Option.Nothing => history.current == 0

    effects []

fn step_forward(history: History) -> Option[History]:
    doc """
    Move one entry toward the newest location, or Nothing when already at the
    newest (or empty).
    """

    ensures Option.Some(moved) => moved.current == history.current + 1
    ensures Option.Some(moved) => moved.locations == history.locations
    ensures Option.Nothing => history.current + 1 >= history.locations.len

    effects []

fn delete_history_entry(history: History, history_id: U64) -> Option[History]:
    doc """
    Remove the entry at index history_id, or Nothing when there is no such
    entry. An entry older than current moves current down by one, so the same
    location stays current. Deleting the current entry keeps current at the
    same index, clamped to the new newest entry (0 when the history becomes
    empty).
    """

    ensures Option.Some(remaining) => remaining.locations.len + 1 == history.locations.len
    ensures Option.Nothing => history_id >= history.locations.len
    ensures Option.Some(remaining) => ((history_id < history.current) => remaining.current + 1 == history.current)
    ensures Option.Some(remaining) => ((history_id > history.current) => remaining.current == history.current)

    effects []

fn history_entries(history: History) -> List[HistoryEntry]:
    doc """
    The rows of the history pane, newest entry first, each with the index of
    its location. A Local prompt is
    ":page_facing_up: [bold]NAME[/]\n[dim]PARENT[/]" where NAME is the last
    "/"-separated segment of the target and PARENT the target without that
    segment and its separating "/" ("/" for a segment directly under the
    root, "." for a relative target of one segment). A Remote prompt is
    ":globe_with_meridians: [bold]NAME[/]\n[dim]PARENT\nHOST[/]" with NAME
    and PARENT taken the same way from the URL path (an empty path gives an
    empty NAME and the PARENT "."), and HOST the lower-cased host name
    without userinfo or port. NAME, PARENT and HOST are escaped like
    rich.markup.escape, so their text is shown literally.
    """

    ensures result.len == history.locations.len

    effects []

data guide: Location = Location(kind: LocationKind.Local, target: "/notes/guide.md")

data setup: Location = Location(kind: LocationKind.Local, target: "/notes/setup.md")

data remote: Location = Location(
    kind: LocationKind.Remote,
    target: "https://Example.com:8443/docs/intro.md",
)

scenario history_moves_and_remembers:
    call empty = start_history(List())
    assert empty == History(locations: List(), current: 0)
    call nowhere = current_location(empty)
    assert nowhere == Option.Nothing
    call first = remember_location(empty, guide)
    call second = remember_location(first, setup)
    assert second == History(locations: List(guide, setup), current: 1)
    call back = step_back(second)
    assert back == Option.Some(value: History(locations: List(guide, setup), current: 0))
    call oldest = step_back(History(locations: List(guide, setup), current: 0))
    assert oldest == Option.Nothing
    call forward = step_forward(History(locations: List(guide, setup), current: 0))
    assert forward == Option.Some(value: second)
    call newest = step_forward(second)
    assert newest == Option.Nothing
    call revisit = remember_location(History(locations: List(guide, setup), current: 0), setup)
    assert revisit == History(locations: List(guide, setup, setup), current: 2)
    call at = current_location(History(locations: List(guide, setup, remote), current: 1))
    assert at == Option.Some(value: setup)

scenario history_entries_are_deleted:
    data three: History = History(locations: List(guide, setup, remote), current: 2)
    call older = delete_history_entry(three, 0)
    assert older == Option.Some(value: History(locations: List(setup, remote), current: 1))
    call newest = delete_history_entry(three, 2)
    assert newest == Option.Some(value: History(locations: List(guide, setup), current: 1))
    call middle = delete_history_entry(
        History(locations: List(guide, setup, remote), current: 1),
        1,
    )
    assert middle == Option.Some(value: History(locations: List(guide, remote), current: 1))
    call last = delete_history_entry(History(locations: List(guide), current: 0), 0)
    assert last == Option.Some(value: History(locations: List(), current: 0))
    call missing = delete_history_entry(three, 3)
    assert missing == Option.Nothing

scenario history_pane_lists_newest_first:
    call rows = history_entries(
        History(
            locations: List(
                guide,
                Location(kind: LocationKind.Local, target: "/[red]x.md"),
                remote,
            ),
            current: 0,
        ),
    )
    assert rows == List(
        HistoryEntry(
            history_id: 2,
            location: remote,
            prompt: ":globe_with_meridians: [bold]intro.md[/]\n[dim]/docs\nexample.com[/]",
        ),
        HistoryEntry(
            history_id: 1,
            location: Location(kind: LocationKind.Local, target: "/[red]x.md"),
            prompt: ":page_facing_up: [bold]\\[red]x.md[/]\n[dim]/[/]",
        ),
        HistoryEntry(
            history_id: 0,
            location: guide,
            prompt: ":page_facing_up: [bold]guide.md[/]\n[dim]/notes[/]",
        ),
    )
