module frogmouth.application

enum SidebarMode:
    Hidden
    Help
    History
    Bookmarks

enum SidebarDock:
    Left
    Right

fn toggle_sidebar(current: SidebarMode, requested: SidebarMode) -> SidebarMode:
    requires requested != SidebarMode.Hidden

    ensures result == SidebarMode.Hidden or result == requested
    ensures (result == SidebarMode.Hidden) == (current == requested)

    effects []

fn toggle_sidebar_dock(current: SidebarDock) -> SidebarDock:
    ensures result != current

    effects []

fn parse_initial_location(arguments: List[Str]) -> Option[Str]:
    doc """
    Parse an optional initial location argument.
    """

fn resolve_state_path(
    platform_name: Str,
    home: Path,
    app_data: Option[Str],
    xdg_data_home: Option[Str],
) -> Path:
    doc """
    Resolve the application state storage path.
    """

const SIDEBAR_HIDDEN: SidebarMode = SidebarMode.Hidden

const SIDEBAR_HELP: SidebarMode = SidebarMode.Help

const SIDEBAR_HISTORY: SidebarMode = SidebarMode.History

const SIDEBAR_DOCK_LEFT: SidebarDock = SidebarDock.Left

const SIDEBAR_DOCK_RIGHT: SidebarDock = SidebarDock.Right

scenario sidebar_mode_workflow:
    call opened_help = toggle_sidebar(SIDEBAR_HIDDEN, SIDEBAR_HELP)
    assert opened_help == SIDEBAR_HELP
    call opened_history = toggle_sidebar(opened_help, SIDEBAR_HISTORY)
    assert opened_history == SIDEBAR_HISTORY
    call closed_history = toggle_sidebar(opened_history, SIDEBAR_HISTORY)
    assert closed_history == SIDEBAR_HIDDEN

scenario sidebar_dock_workflow:
    call docked_right = toggle_sidebar_dock(SIDEBAR_DOCK_LEFT)
    assert docked_right == SIDEBAR_DOCK_RIGHT
    call docked_left = toggle_sidebar_dock(docked_right)
    assert docked_left == SIDEBAR_DOCK_LEFT
