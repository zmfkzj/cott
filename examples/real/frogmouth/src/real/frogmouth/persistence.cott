module frogmouth.persistence

use frogmouth.model.{BrowserState, StateAction}

enum StateError:
    PermissionDenied(path: Path)
    InvalidData(path: Path)
    IoFailure(path: Path, message: Str)

fn add_history(history: List[Str], location: Str, history_limit: U64) -> List[Str]:
    requires history_limit > 0

    ensures location.len != 0 or result.len == history.len
    ensures location.len == 0 or result.len <= history_limit

fn toggle_bookmark(bookmarks: List[Str], location: Str) -> List[Str]:
    ensures result.len <= bookmarks.len + 1

fn remove_history(history: List[Str], location: Str) -> List[Str]:
    ensures result.len <= history.len

fn decode_state(source: Str, path: Path) -> Result[BrowserState, StateError]:
    ensures Result.Ok(decoded) => decoded.history.len + decoded.bookmarks.len <= source.len

    error StateError.InvalidData when source.len == 0
    error StateError.InvalidData

fn encode_state(current: BrowserState) -> Str:
    ensures result.len > 0

fn update_state(current: BrowserState, action: StateAction, history_limit: U64) -> BrowserState:
    requires history_limit > 0

    ensures result.history.len <= current.history.len + 1

fn load_state(path: Path) -> Result[BrowserState, StateError]:
    ensures Result.Ok(loaded) => true

    error StateError.PermissionDenied
    error StateError.InvalidData
    error StateError.IoFailure

    effects [file.read]

fn save_state(path: Path, current: BrowserState) -> Result[Unit, StateError]:
    ensures Result.Ok(saved) => true

    error StateError.PermissionDenied
    error StateError.IoFailure

    effects [file.write]
