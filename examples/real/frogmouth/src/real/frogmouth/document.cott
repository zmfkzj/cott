module frogmouth.document

use frogmouth.model.{Document, Location}

enum LoadError:
    NotFound(source: Str)
    InvalidEncoding(source: Str)
    TooLarge(source: Str)
    NetworkFailed(source: Str, message: Str)
    ReadFailed(source: Str, message: Str)

fn load_document(location: Location) -> Result[Document, LoadError]:
    doc """
    Load at most 5 MiB of UTF-8 Markdown and derive a title from its first heading.
    """

    ensures Result.Ok(document) => document.location == location
    ensures Result.Ok(document) => document.title.len > 0
    ensures Result.Ok(document) => document.markdown.len <= 5242880

    error LoadError.NotFound
    error LoadError.InvalidEncoding
    error LoadError.TooLarge
    error LoadError.NetworkFailed
    error LoadError.ReadFailed

    effects [file.read, network]
