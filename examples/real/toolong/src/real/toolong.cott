module real.toolong

struct ViewerOptions:
    sources: List[Path]
    contains: Option[Str]

struct LogEntry:
    source: Path
    line: U64
    text: Str

enum ToolongError:
    InvalidArguments(message: Str)
    ReadFailed(path: Path, message: Str)

fn parse_arguments(arguments: List[Str]) -> Result[ViewerOptions, ToolongError]:
    doc """
    Parse [--contains TEXT] followed by one or more log paths.
    """

    ensures Result.Ok(options) => options.sources.len > 0

    error ToolongError.InvalidArguments

    effects []

fn load_entries(sources: List[Path]) -> Result[List[LogEntry], ToolongError]:
    doc """
    Read UTF-8 log lines in source order and number each source from one.
    """

    ensures Result.Ok(entries) => sources.len > 0

    error ToolongError.ReadFailed

    effects [file.read]

fn filter_entries(entries: List[LogEntry], contains: Option[Str]) -> List[LogEntry]:
    doc """
    Keep all entries without a filter; otherwise keep case-insensitive substring matches.
    """

    effects []

fn render_entries(entries: List[LogEntry]) -> Str:
    doc """
    Render path:line and text for each entry, separated by newlines.
    """

    effects []

fn execute(arguments: List[Str]) -> Result[Str, ToolongError]:
    doc """
    Parse arguments, load logs, apply the optional filter, and render matching entries.
    """

    ensures Result.Ok(rendered) => arguments.len > 0

    error ToolongError.InvalidArguments
    error ToolongError.ReadFailed

    effects [file.read]
