module real.toolong.files

use real.toolong.model.{
    ByteSpan,
    Compression,
    FileIndex,
    FileTimestamps,
    FindQuery,
    LineLocation,
    LogSource,
    LogTimestamp,
    MergedIndex,
    TabIndex,
    TimeUnit,
    TimestampEntry,
}
use real.toolong.index.{
    add_scanned_breaks,
    add_tail_breaks,
    complete_file_scan,
    file_line_count,
    line_location,
    merge_timestamps,
    start_file_index,
}
use real.toolong.text.{line_matches}
use real.toolong.timestamps.{
    compare_timestamps,
    default_timestamp_order,
    scan_timestamp,
    shift_timestamp,
    timestamp_seconds,
}

enum SourceError:
    NotFound(name: Str, message: Str)
    OpenFailed(name: Str, message: Str)

enum SaveError:
    WriteFailed(message: Str)

enum DecompressError:
    Corrupt(message: Str)

doc """
New content read while tailing: the offset after the bytes read and an opaque
tuple of the LF byte offsets among them (Opaque(tag="file_breaks",
value=tuple of int), read as typing.cast(tuple[int, ...], breaks.unwrap())).
"""
struct TailChunk:
    position: U64
    breaks: Opaque["file_breaks"]

doc """
One batch of a merge timestamp scan: an opaque tuple of entries
(Opaque(tag="timestamp_entries", value=tuple of TimestampEntry), read as
typing.cast(tuple[TimestampEntry, ...], entries.unwrap())), the offset
where the next batch starts and the file's timestamp format order afterwards.
"""
struct TimestampBatch:
    entries: Opaque["timestamp_entries"]
    position: U64
    order: List[U8]

doc """
The outcome of a find navigation: the first matching line, if any, and
whether the regular expression was invalid (in which case the first line
examined matched).
"""
struct FindResult:
    line: Option[U64]
    invalid_regex: Bool

doc """
A line's timestamp and the per-file timestamp format orders after scanning
it (orders[i] belongs to file i).
"""
struct TimestampAt:
    timestamp: Option[LogTimestamp]
    orders: List[List[U8]]

doc """
The outcome of a timestamp navigation: the destination line (Nothing rings
the bell instead) and the per-file timestamp format orders afterwards.
"""
struct TimeJump:
    line: Option[U64]
    orders: List[List[U8]]

fn detect_compression(name: Str) -> Compression:
    doc """
    The compression Toolong detects from a file name (CPython 3.14
    mimetypes.guess_type(name, strict=False) encodings, restated because the
    mimetypes module is not importable here). Let ext be the final suffix of
    name (os.path.splitext). First, while ext.lower() is ".svgz", ".tgz",
    ".taz", ".tz", ".tbz2" or ".txz", replace that suffix by ".svg.gz",
    ".tar.gz", ".tar.gz", ".tar.gz", ".tar.bz2" or ".tar.xz" respectively and
    take the new final suffix. Then an ext of exactly ".gz" (case sensitive)
    is Gzip, exactly ".bz2" is Bzip2, and anything else is Uncompressed.
    """

    effects []

fn decompress(data: Bytes, compression: Compression) -> Result[Bytes, DecompressError]:
    doc """
    Decompress whole-file content: Gzip with gzip.decompress (multi-member
    files concatenate), Bzip2 with bz2.decompress, Uncompressed returns data
    unchanged. A decompression failure is DecompressError.Corrupt with str() of
    the exception, for example "Not a gzipped file (b'no')".
    """

    ensures Result.Ok(content) => (compression == Compression.Uncompressed => content == data)

    error DecompressError.Corrupt

    effects []

fn open_source(path: Path) -> Result[LogSource, SourceError]:
    doc """
    Open a log file the way Toolong's LogFile.open does. name is the final
    component of path (pathlib name) and compression is
    real.toolong.files.detect_compression(name).
    
    Outside a Cott scenario (the fixture read adapter reports that adapters
    are inactive): an Uncompressed file is opened read-only with os.open, its
    size is found by seeking its descriptor to the end, descriptor is Some of
    that descriptor and can_tail is true. A compressed file is decompressed
    with gzip.open / bz2.open in 256 KiB chunks into an anonymous temporary
    file (tempfile.TemporaryFile); descriptor is Some of a descriptor on that
    unlinked temporary file (the temporary file object itself is closed), size
    is the number of decompressed bytes and can_tail is false.
    
    While a Cott scenario file-system fixture is active, path is read through
    the fixture, compressed content is decompressed with
    real.toolong.files.decompress, descriptor is Nothing, size is the content
    length and can_tail is true only for Uncompressed files.
    
    A missing file is SourceError.NotFound(name, message); any other failure
    to open, read or decompress is SourceError.OpenFailed(name, message).
    message is str() of the underlying exception, e.g. "[Errno 2] No such file
    or directory: 'x.log'" (for fixture failures, of the adapter's OSError
    cause), or the DecompressError.Corrupt message.
    """

    ensures Result.Ok(source) => source.path == path

    error SourceError.NotFound
    error SourceError.OpenFailed

    effects [file.read, file.write]

fn close_source(source: LogSource) -> Unit:
    doc """
    Close source.descriptor with os.close when it is Some, ignoring OSError.
    Nothing to do when it is Nothing.
    """

    effects [file.read]

fn read_span(source: LogSource, span: ByteSpan) -> Bytes:
    doc """
    Toolong's get_raw: the content bytes [span.start, span.end). Empty when
    start >= end. With Some(descriptor) read them with os.pread (fewer bytes
    near the end of the content). With Nothing, read source.path through the
    active scenario file-system fixture, decompress it as source.compression
    says, and slice. Read failures give empty bytes.
    """

    ensures (span.start >= span.end => result.len == 0)
    ensures span.start >= span.end or result.len <= span.end - span.start

    effects [file.read]

fn read_lines(source: LogSource, spans: List[ByteSpan]) -> List[Str]:
    doc """
    Toolong's get_line for every span, in order: the span's bytes
    (real.toolong.files.read_span) decoded as UTF-8 with errors="replace",
    with every leading and trailing LF and CR removed (str.strip("\n\r")) and
    tabs expanded with str.expandtabs(4).
    """

    ensures result.len == spans.len

    effects [file.read]

fn scan_breaks(source: LogSource, start: U64, end: U64) -> Opaque["file_breaks"]:
    doc """
    The offsets of every LF byte in the content range [start, min(end,
    source.size)), ascending, as an opaque tuple of U64s. Read the range in
    bounded chunks with os.pread when source.descriptor is Some; with Nothing,
    use the fixture content as real.toolong.files.read_span does.
    """

    effects [file.read]

fn poll_source(source: LogSource, position: U64) -> TailChunk:
    doc """
    One poll of Toolong's tail watcher: read up to 65536 bytes of content
    starting at position (os.pread with a descriptor; the fixture content
    otherwise). The result position is position plus the number of bytes read
    and breaks are the offsets (position + index) of the LF bytes read, in
    order. Nothing read gives position unchanged and no breaks. Content that
    shrank below position (truncation) is not detected, exactly as upstream.
    """

    ensures result.position >= position

    effects [file.read]

fn scan_timestamps(
    source: LogSource,
    position: U64,
    first_line: U64,
    limit: U64,
    order: List[U8],
) -> TimestampBatch:
    doc """
    One batch of Toolong's merge scan. Starting at position, read up to limit
    lines the way a binary readline does: a line is the bytes up to and
    including the next LF, or the remaining bytes when no LF follows; reading
    stops at the end of the content (source.size). Each line, decoded as UTF-8
    with errors="replace" and still ending with its LF, is scanned with
    real.toolong.timestamps.scan_timestamp using the current order, which
    carries over from line to line. Entry k has line first_line + k, end the
    offset just after the line, and seconds
    real.toolong.timestamps.timestamp_seconds of the timestamp found or 0.0.
    The result position is the offset after the last line read and order is
    the final order. Return entries as an opaque tuple of TimestampEntry so
    a 10000-line batch is safe across the facade boundary.
    """

    ensures result.position >= position

    effects [file.read]

fn find_line(
    sources: List[LogSource],
    index: TabIndex,
    line_count: U64,
    start: I64,
    direction: I8,
    query: FindQuery,
) -> FindResult:
    doc """
    Toolong's advance_search while the find dialog is shown. Examine lines
    start, start + 1, ..., line_count - 1 when direction is positive, or start,
    start - 1, ..., 0 when it is not. In either direction, examine no lines
    when start is negative or start >= line_count. For each line, locate it with
    real.toolong.index.line_location, read its raw bytes with
    real.toolong.files.read_span from sources[location.file] (an empty string
    when that file is missing), decode them as UTF-8 with errors="replace"
    without stripping anything (so lines after the first of a single file
    start with the preceding LF), and test them with
    real.toolong.text.line_matches. The first line that matches is the result
    line; invalid_regex is true when that test reported an invalid regular
    expression.
    """

    ensures result.line matches Option.Some(found) => found < line_count
    ensures result.line matches Option.Some(found) => start >= 0

    effects [file.read]

fn line_timestamp(
    sources: List[LogSource],
    index: TabIndex,
    line: U64,
    orders: List[List[U8]],
) -> TimestampAt:
    doc """
    Toolong's get_timestamp: locate line with real.toolong.index.line_location,
    read its text as real.toolong.files.read_lines does from
    sources[location.file] (the empty string when that file is missing) and
    scan it with real.toolong.timestamps.scan_timestamp using that file's
    order. orders holds one order per file; before scanning, missing entries up
    to the file's index are filled with
    real.toolong.timestamps.default_timestamp_order(). The result orders are
    the (filled) orders with that file's order replaced by the scan's order.
    """

    ensures result.orders.len >= orders.len

    effects [file.read]

fn locate_time(
    sources: List[LogSource],
    index: TabIndex,
    line_count: U64,
    from_line: U64,
    steps: I32,
    unit: TimeUnit,
    orders: List[List[U8]],
) -> TimeJump:
    doc """
    Toolong's timestamp navigation (keys m/M, h/H, d/D) from from_line, using
    real.toolong.files.line_timestamp for every timestamp read and threading
    the orders through all reads.
    
    Starting at line = from_line, while the line has no timestamp: advance line
    by one and count the step; when the count reaches line_count or exceeds 10,
    the result line is Nothing (bell). With the timestamp t found, let
    direction be +1 when steps > 0 and -1 otherwise, move line by direction,
    and compute the target real.toolong.timestamps.shift_timestamp(t, steps,
    unit) (Nothing: the result line is Nothing).
    
    Forward: while line < line_count, stop at the first line whose timestamp
    compares (real.toolong.timestamps.compare_timestamps) greater than or equal
    to the target; otherwise advance. Backward: while line > 0, stop at the
    first line whose timestamp compares less than or equal to the target;
    otherwise go back one line. Incomparable timestamps (naive against aware)
    never stop the walk. The result line is where the walk stopped (possibly
    line_count or 0).
    """

    ensures result.line matches Option.Some(found) => found <= line_count

    effects [file.read]

fn save_lines(
    sources: List[LogSource],
    index: TabIndex,
    line_count: U64,
    path: Path,
) -> Result[U64, SaveError]:
    doc """
    Toolong's save of a merged view (--output-merge): for each line 0 ..
    line_count - 1 in order, read its text as real.toolong.files.read_lines
    does (locating it with real.toolong.index.line_location; missing files
    give ""), and write every non-empty line followed by LF, UTF-8 encoded, to
    path, replacing any existing file. Outside a Cott scenario write with the
    host file system (open(path, "w", encoding="utf-8")); while a scenario
    file-system fixture is active write through the fixture instead. Ok holds
    the number of lines written. Any failure is SaveError.WriteFailed with
    str() of the exception (of the adapter's OSError cause for fixture
    failures).
    """

    ensures Result.Ok(written) => written <= line_count

    error SaveError.WriteFailed

    effects [file.read, file.write]

data app_source: LogSource = LogSource(
    path: files.path("app.log"),
    name: "app.log",
    compression: Compression.Uncompressed,
    descriptor: Option.Nothing,
    size: 30,
    can_tail: true,
)

data timed_source: LogSource = LogSource(
    path: files.path("timed.log"),
    name: "timed.log",
    compression: Compression.Uncompressed,
    descriptor: Option.Nothing,
    size: 135,
    can_tail: true,
)

scenario plain_source_reads_like_toolong:
    fixtures:
        fs files:
            file "app.log" text("boot ok\r\nERROR disk\n\tindented\n")
    call opened = open_source(files.path("app.log"))
    assert (opened == Result.Ok(value: LogSource(path: files.path("app.log"), name: "app.log", compression: Compression.Uncompressed, descriptor: Option.Nothing, size: 30, can_tail: true)))
    call missing = open_source(files.path("absent.log"))
    assert missing matches Result.Err(SourceError.NotFound(name, _)) => name == "absent.log"
    call breaks = scan_breaks(app_source, 0, 30)
    call started = start_file_index(30)
    call indexed = add_scanned_breaks(started, breaks, 0)
    call done = complete_file_scan(indexed, 30, 0)
    call count = file_line_count(done)
    assert count == 4
    call second = line_location(TabIndex.Single(index: done), 1)
    assert second == LineLocation(file: 0, span: ByteSpan(start: 8, end: 19))
    call last = line_location(TabIndex.Single(index: done), 3)
    assert last == LineLocation(file: 0, span: ByteSpan(start: 29, end: 30))
    call middle = scan_breaks(app_source, 9, 25)
    call middle_index = add_scanned_breaks(started, middle, 9)
    call middle_span = line_location(TabIndex.Single(index: middle_index), 0)
    assert middle_span == LineLocation(file: 0, span: ByteSpan(start: 9, end: 19))
    call lines = read_lines(
        app_source,
        List(
            ByteSpan(start: 0, end: 8),
            ByteSpan(start: 8, end: 19),
            ByteSpan(start: 19, end: 29),
            ByteSpan(start: 29, end: 30),
        ),
    )
    assert lines == List("boot ok", "ERROR disk", "    indented", "")
    call raw = read_span(app_source, ByteSpan(start: 5, end: 12))
    assert raw == Bytes("6f6b0d0a455252")
    call nothing = read_span(app_source, ByteSpan(start: 7, end: 7))
    assert nothing == Bytes("")
    call tail = poll_source(app_source, 20)
    assert tail.position == 30
    call tailed = add_tail_breaks(started, tail.breaks, tail.position)
    call tail_end = line_location(TabIndex.Single(index: tailed), 1)
    assert tail_end == LineLocation(file: 0, span: ByteSpan(start: 30, end: 29))
    call idle = poll_source(app_source, 30)
    assert idle.position == 30
    call closed = close_source(app_source)
    assert closed == ()

scenario compressed_sources_are_decompressed:
    fixtures:
        fs files:
            file "app.log.gz" hex("1f8b080000000000020333323032d13530d435b2543034b63231b532325048cacf2fe1cacfe60200a0631e761c000000")
            file "app.log.bz2" hex("425a68393141592653597719e1010000065980001040027e30100884002000314c0001468c8f29ea7a89f68f00c682399aa9dc2419716f8bb9229c28483b8cf08080")
            file "bad.gz" text("not gzip")
    call gz = open_source(files.path("app.log.gz"))
    assert gz matches Result.Ok(source) => source.size == 28 and source.compression == Compression.Gzip and not source.can_tail
    call bz = open_source(files.path("app.log.bz2"))
    assert bz matches Result.Ok(source) => source.size == 28 and source.compression == Compression.Bzip2
    call bad = open_source(files.path("bad.gz"))
    assert bad matches Result.Err(SourceError.OpenFailed(name, message)) => name == "bad.gz" and message != ""
    call first = read_lines(
        LogSource(
            path: files.path("app.log.gz"),
            name: "app.log.gz",
            compression: Compression.Gzip,
            descriptor: Option.Nothing,
            size: 28,
            can_tail: false,
        ),
        List(ByteSpan(start: 0, end: 24)),
    )
    assert first == List("2024-01-29 13:45:20 boot")
    call breaks = scan_breaks(
        LogSource(
            path: files.path("app.log.bz2"),
            name: "app.log.bz2",
            compression: Compression.Bzip2,
            descriptor: Option.Nothing,
            size: 28,
            can_tail: false,
        ),
        0,
        28,
    )
    call compressed_started = start_file_index(28)
    call compressed_index = add_scanned_breaks(compressed_started, breaks, 0)
    call compressed_end = line_location(TabIndex.Single(index: compressed_index), 1)
    assert compressed_end == LineLocation(file: 0, span: ByteSpan(start: 24, end: 27))
    call broken = decompress(Bytes("6e6f"), Compression.Gzip)
    assert broken matches Result.Err(DecompressError.Corrupt(message)) => message != ""
    call gzip_name = detect_compression("access.log.2.gz")
    assert gzip_name == Compression.Gzip
    call bzip_name = detect_compression("logs.tbz2")
    assert bzip_name == Compression.Bzip2
    call upper = detect_compression("APP.GZ")
    assert upper == Compression.Uncompressed

scenario timestamps_find_and_navigation_read_lines:
    fixtures:
        fs files:
            file "timed.log" text("2024-01-29 13:45:20,100+0000 INFO boot\nTraceback here\n2024-01-29 13:46:30,300+0000 ERROR failed\n2024-01-29 13:47:00,000+0000 INFO done\n")
    call order = default_timestamp_order()
    call head = scan_timestamps(timed_source, 0, 0, 2, order)
    assert head.position == 54 and head.order == order
    call rest = scan_timestamps(timed_source, 54, 2, 10, order)
    assert rest.position == 135 and rest.order == order
    call complete_batch = scan_timestamps(timed_source, 0, 0, 10, order)
    call merged = merge_timestamps(
        List(FileTimestamps(opened: true, size: 135, entries: complete_batch.entries)),
        true,
    )
    call untimed_first = line_location(TabIndex.Merged(index: merged), 0)
    assert untimed_first == LineLocation(file: 0, span: ByteSpan(start: 39, end: 54))
    call partial = merge_timestamps(
        List(FileTimestamps(opened: true, size: 135, entries: complete_batch.entries)),
        false,
    )
    call file_first = line_location(TabIndex.Merged(index: partial), 0)
    assert file_first == LineLocation(file: 0, span: ByteSpan(start: 0, end: 39))
    call all_breaks = scan_breaks(timed_source, 0, 135)
    call unscanned = start_file_index(135)
    call scanned = add_scanned_breaks(unscanned, all_breaks, 0)
    call completed = complete_file_scan(scanned, 135, 0)
    call failure = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        0,
        1,
        FindQuery(text: "error", regex: false, case_sensitive: false),
    )
    assert failure == FindResult(line: Option.Some(value: 2), invalid_regex: false)
    call anchored = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        0,
        1,
        FindQuery(text: "ERROR", regex: true, case_sensitive: true),
    )
    assert anchored == FindResult(line: Option.Nothing, invalid_regex: false)
    call spaced = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        0,
        1,
        FindQuery(text: "\\s*2024.*ERROR", regex: true, case_sensitive: true),
    )
    assert spaced.line == Option.Some(value: 2)
    call backward = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        4,
        -1,
        FindQuery(text: "INFO", regex: false, case_sensitive: true),
    )
    assert backward.line == Option.Some(value: 3)
    call invalid = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        1,
        1,
        FindQuery(text: "[", regex: true, case_sensitive: false),
    )
    assert invalid == FindResult(line: Option.Some(value: 1), invalid_regex: true)
    call before_start = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        -1,
        -1,
        FindQuery(text: "INFO", regex: false, case_sensitive: false),
    )
    assert before_start.line == Option.Nothing
    call after_end = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        5,
        -1,
        FindQuery(text: "", regex: false, case_sensitive: false),
    )
    assert after_end == FindResult(line: Option.Nothing, invalid_regex: false)
    call empty_view = find_line(
        List(timed_source),
        TabIndex.Single(index: completed),
        0,
        0,
        -1,
        FindQuery(text: "", regex: false, case_sensitive: false),
    )
    assert empty_view == FindResult(line: Option.Nothing, invalid_regex: false)
    call untimed = line_timestamp(List(timed_source), TabIndex.Single(index: completed), 1, List())
    assert untimed == TimestampAt(timestamp: Option.Nothing, orders: List(order))
    call timed = line_timestamp(
        List(timed_source),
        TabIndex.Single(index: completed),
        2,
        List(order),
    )
    assert (timed.timestamp == Option.Some(value: LogTimestamp(year: 2024, month: 1, day: 29, hour: 13, minute: 46, second: 30, microsecond: 300000, utc_offset_seconds: Option.Some(value: 0))))
    call next_minute = locate_time(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        0,
        1,
        TimeUnit.Minute,
        List(order),
    )
    assert next_minute.line == Option.Some(value: 2)
    call from_untimed = locate_time(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        1,
        1,
        TimeUnit.Minute,
        List(order),
    )
    assert from_untimed.line == Option.Some(value: 5)
    call hour_back = locate_time(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        3,
        -1,
        TimeUnit.Hour,
        List(order),
    )
    assert hour_back.line == Option.Some(value: 0)
    call no_time = locate_time(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        4,
        1,
        TimeUnit.Day,
        List(order),
    )
    assert no_time.line == Option.Nothing

scenario merged_lines_are_saved_without_blank_lines:
    fixtures:
        fs files:
            file "timed.log" text("2024-01-29 13:45:20,100+0000 INFO boot\nTraceback here\n2024-01-29 13:46:30,300+0000 ERROR failed\n2024-01-29 13:47:00,000+0000 INFO done\n")
    call all_breaks = scan_breaks(timed_source, 0, 135)
    call unscanned = start_file_index(135)
    call scanned = add_scanned_breaks(unscanned, all_breaks, 0)
    call completed = complete_file_scan(scanned, 135, 0)
    call saved = save_lines(
        List(timed_source),
        TabIndex.Single(index: completed),
        5,
        files.path("out/merged.log"),
    )
    assert saved == Result.Ok(value: 4)
    call reopened = open_source(files.path("out/merged.log"))
    assert reopened matches Result.Ok(source) => source.size == 135
    call copied = read_lines(
        LogSource(
            path: files.path("out/merged.log"),
            name: "merged.log",
            compression: Compression.Uncompressed,
            descriptor: Option.Nothing,
            size: 135,
            can_tail: true,
        ),
        List(ByteSpan(start: 38, end: 53)),
    )
    assert copied == List("Traceback here")

scenario merge_orders_files_with_header_backfill:
    fixtures:
        fs files:
            file "first.log" text("header\n2024-01-29 13:45:20,100+0000 INFO boot\norphan\n")
            file "second.log" text("2024-01-29 13:45:19,000+0000 INFO first\n2024-01-29 13:45:20,100+0000 INFO tie\n")
    call order = default_timestamp_order()
    call first = scan_timestamps(
        LogSource(
            path: files.path("first.log"),
            name: "first.log",
            compression: Compression.Uncompressed,
            descriptor: Option.Nothing,
            size: 53,
            can_tail: true,
        ),
        0,
        0,
        10,
        order,
    )
    call second = scan_timestamps(
        LogSource(
            path: files.path("second.log"),
            name: "second.log",
            compression: Compression.Uncompressed,
            descriptor: Option.Nothing,
            size: 78,
            can_tail: true,
        ),
        0,
        0,
        10,
        order,
    )
    call merged = merge_timestamps(
        List(
            FileTimestamps(opened: true, size: 53, entries: first.entries),
            FileTimestamps(opened: true, size: 78, entries: second.entries),
        ),
        true,
    )
    assert merged.scanned_size == 131
    call orphan = line_location(TabIndex.Merged(index: merged), 0)
    assert orphan == LineLocation(file: 0, span: ByteSpan(start: 46, end: 53))
    call earlier = line_location(TabIndex.Merged(index: merged), 1)
    assert earlier == LineLocation(file: 1, span: ByteSpan(start: 0, end: 40))
    call header = line_location(TabIndex.Merged(index: merged), 2)
    assert header == LineLocation(file: 0, span: ByteSpan(start: 0, end: 7))
    call boot = line_location(TabIndex.Merged(index: merged), 3)
    assert boot == LineLocation(file: 0, span: ByteSpan(start: 7, end: 46))
    call tie = line_location(TabIndex.Merged(index: merged), 4)
    assert tie == LineLocation(file: 1, span: ByteSpan(start: 40, end: 78))
    call partial_merge = merge_timestamps(
        List(
            FileTimestamps(opened: true, size: 53, entries: first.entries),
            FileTimestamps(opened: true, size: 78, entries: second.entries),
        ),
        false,
    )
    call first_unsorted = line_location(TabIndex.Merged(index: partial_merge), 0)
    assert first_unsorted == LineLocation(file: 0, span: ByteSpan(start: 0, end: 7))

scenario failed_merged_save_keeps_previous_output:
    fixtures:
        fs files:
            file "app.log" text("boot ok\r\nERROR disk\n\tindented\n")
            file "out/merged.log" text("previous\n")
        failure disk_full:
            point: file.write
            occurrence: 1
            error: disk_full
    data previous_output: LogSource = LogSource(
        path: files.path("out/merged.log"),
        name: "merged.log",
        compression: Compression.Uncompressed,
        descriptor: Option.Nothing,
        size: 9,
        can_tail: true,
    )
    data merged_output: LogSource = LogSource(
        path: files.path("out/merged.log"),
        name: "merged.log",
        compression: Compression.Uncompressed,
        descriptor: Option.Nothing,
        size: 32,
        can_tail: true,
    )
    call breaks = scan_breaks(app_source, 0, 30)
    call started = start_file_index(30)
    call indexed = add_scanned_breaks(started, breaks, 0)
    call done = complete_file_scan(indexed, 30, 0)
    call count = file_line_count(done)
    call failed = save_lines(
        List(app_source),
        TabIndex.Single(index: done),
        count,
        files.path("out/merged.log"),
    )
    assert failed matches Result.Err(SaveError.WriteFailed(_))
    call kept = open_source(files.path("out/merged.log"))
    assert kept == Result.Ok(value: previous_output)
    call kept_lines = read_lines(previous_output, List(ByteSpan(start: 0, end: 9)))
    assert kept_lines == List("previous")
    call retried = save_lines(
        List(app_source),
        TabIndex.Single(index: done),
        count,
        files.path("out/merged.log"),
    )
    assert retried == Result.Ok(value: 3)
    call rewritten = open_source(files.path("out/merged.log"))
    assert rewritten == Result.Ok(value: merged_output)
    call written = read_span(merged_output, ByteSpan(start: 0, end: 32))
    assert written == Bytes("626f6f74206f6b0a4552524f52206469736b0a20202020696e64656e7465640a")

requirement FIND_SEARCHES_RAW_LINES for find_line:
    text "Find navigation tests the raw bytes of each line, so a regular expression is anchored before the LF that starts every line after the first of a single file."
    checked_by timestamps_find_and_navigation_read_lines

requirement TIME_NAVIGATION_SKIPS_TO_TARGET for locate_time:
    text "Timestamp navigation starts from the first timestamped line at or after the current line and stops at the first line at or beyond the shifted timestamp in the travel direction."
    checked_by timestamps_find_and_navigation_read_lines
