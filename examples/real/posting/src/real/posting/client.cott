module real.posting.client

enum HttpMethod:
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Custom(name: Str)

struct Header:
    name: Str
    value: Str

struct Request:
    method: HttpMethod
    url: Str
    headers: List[Header]
    body: Str
    timeout_ms: U32

struct Response:
    status: U16
    url: Str
    headers: List[Header]
    body: Str

enum PostingError:
    InvalidArguments(message: Str)
    InvalidRequest(message: Str)
    NetworkFailed(message: Str)

fn parse_method(source: Str) -> Result[HttpMethod, PostingError]:
    doc """
    Accept standard HTTP methods case-insensitively; preserve other non-empty methods.
    """

    ensures Result.Ok(method) => source.len > 0

    error PostingError.InvalidRequest

    effects []

fn parse_arguments(arguments: List[Str]) -> Result[Request, PostingError]:
    doc """
    Parse METHOD URL [BODY]; use a 30-second timeout and no headers.
    """

    ensures Result.Ok(request) => arguments.len >= 2

    error PostingError.InvalidArguments
    error PostingError.InvalidRequest

    effects []

fn send_request(request: Request) -> Result[Response, PostingError]:
    doc """
    Send one HTTP request and retain status, final URL, headers, and response bytes.
    """

    ensures Result.Ok(response) => response.status > 0

    error PostingError.InvalidRequest
    error PostingError.NetworkFailed

    effects [network]

fn render_response(response: Response) -> Str:
    doc """
    Render status and final URL, then headers and a UTF-8 replacement-decoded body.
    """

    effects []

fn execute(arguments: List[Str]) -> Result[Str, PostingError]:
    doc """
    Call real.posting.client.parse_arguments, pass its request to
    real.posting.client.send_request, and return the successful response rendered
    by real.posting.client.render_response. Return an error from either earlier
    operation unchanged; do not send a request after argument parsing fails.
    """

    ensures Result.Ok(rendered) => rendered.len > 0

    error PostingError.InvalidArguments
    error PostingError.InvalidRequest
    error PostingError.NetworkFailed

    effects [network]
