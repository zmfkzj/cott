module curriculum.workflow_scenario

enum SearchStatus:
    Loading
    Ready

struct SearchSnapshot:
    request_id: U64
    applied_request_id: U64
    query: Str
    result: Str
    status: SearchStatus

    invariant self.request_id > 0
    invariant self.status matches SearchStatus.Loading => (self.applied_request_id == 0 and self.result == "")
    invariant self.status matches SearchStatus.Ready => self.applied_request_id == self.request_id

struct SearchResult:
    request_id: U64
    query: Str
    result: Str

    invariant self.request_id > 0

enum SaveStatus:
    Queued
    Flushed

struct SaveSnapshot:
    revision: U64
    text: Str
    status: SaveStatus

    invariant self.revision > 0

struct SaveReceipt:
    revision: U64
    text: Str
    status: SaveStatus

    invariant self.revision > 0

fn begin_search(request_id: U64, query: Str) -> SearchSnapshot:
    doc """
    Start the snapshot of a new search request. Nothing is applied yet, so the
    snapshot is Loading with applied_request_id 0 and an empty result.
    """

    requires request_id > 0

    ensures result.request_id == request_id
    ensures result.query == query
    ensures result.status == SearchStatus.Loading

    effects []

async fn resolve_search(request_id: U64, query: Str) -> SearchResult:
    doc """
    Resolve one search request without observing host state. This lesson's
    resolver is a deterministic stand-in: the result text is the query followed
    by " result", so query "new" resolves to "new result".
    """

    requires request_id > 0

    ensures result.request_id == request_id
    ensures result.query == query
    ensures (starts_with(result.result, query) and ends_with(result.result, " result"))
    ensures result.result.len == query.len + 7

    effects []

fn apply_search(snapshot: SearchSnapshot, candidate: SearchResult) -> SearchSnapshot:
    doc """
    Apply a resolved result only when it belongs to the snapshot's request.
    A matching candidate makes the snapshot Ready with the candidate's result;
    a candidate for any other request is stale and leaves the snapshot
    unchanged, so an older result can never overwrite a newer request.
    """

    ensures preserves result from snapshot except applied_request_id, result, status
    ensures (candidate.request_id == snapshot.request_id => result.status == SearchStatus.Ready and result.result == candidate.result)
    ensures (candidate.request_id != snapshot.request_id => result == snapshot)

    effects []

fn begin_save(revision: U64, text: Str) -> SaveSnapshot:
    doc """
    Queue the first save request for revision.
    """

    requires revision > 0

    ensures result.revision == revision
    ensures result.text == text
    ensures result.status == SaveStatus.Queued

    effects []

fn request_save(snapshot: SaveSnapshot, revision: U64, text: Str) -> SaveSnapshot:
    doc """
    Coalesce a save request into the pending snapshot. Only a strictly newer
    revision replaces the pending request and queues it; an equal or older
    revision is ignored and the snapshot is returned unchanged.
    """

    requires revision > 0

    ensures (revision > snapshot.revision => result.revision == revision and result.text == text and result.status == SaveStatus.Queued)
    ensures (revision <= snapshot.revision => result == snapshot)

    effects []

fn flush_save(snapshot: SaveSnapshot) -> SaveReceipt:
    doc """
    Flush the coalesced save request and return its Flushed receipt.
    """

    ensures result.revision == snapshot.revision
    ensures result.text == snapshot.text
    ensures result.status == SaveStatus.Flushed

    effects []

const OLD_REQUEST_ID: U64 = 1

const NEW_REQUEST_ID: U64 = 2

const CANCELLED_REQUEST_ID: U64 = 3

const FIRST_SAVE_REVISION: U64 = 1

const LATEST_SAVE_REVISION: U64 = 2

const OLD_QUERY: Str = "old"

const NEW_QUERY: Str = "new"

const CANCELLED_QUERY: Str = "cancelled"

const DRAFT_TEXT: Str = "draft"

const PUBLISHED_TEXT: Str = "published"

const NEW_RESULT: Str = "new result"

scenario latest_result_and_coalesced_save:
    call old_state = begin_search(OLD_REQUEST_ID, OLD_QUERY)
    spawn old_worker = resolve_search(OLD_REQUEST_ID, OLD_QUERY)
    tick
    await old_worker as old_result
    call newest_state = begin_search(NEW_REQUEST_ID, NEW_QUERY)
    spawn cancelled_worker = resolve_search(CANCELLED_REQUEST_ID, CANCELLED_QUERY)
    spawn new_worker = resolve_search(NEW_REQUEST_ID, NEW_QUERY)
    cancel cancelled_worker
    tick
    await cancelled_worker cancelled
    await new_worker as new_result
    call applied = apply_search(newest_state, new_result)
    call protected = apply_search(applied, old_result)
    assert protected == SearchSnapshot(
        request_id: NEW_REQUEST_ID,
        applied_request_id: NEW_REQUEST_ID,
        query: NEW_QUERY,
        result: NEW_RESULT,
        status: SearchStatus.Ready,
    )
    call first_save = begin_save(FIRST_SAVE_REVISION, DRAFT_TEXT)
    call coalesced_save = request_save(first_save, LATEST_SAVE_REVISION, PUBLISHED_TEXT)
    call stale_save = request_save(coalesced_save, FIRST_SAVE_REVISION, DRAFT_TEXT)
    call flushed = flush_save(stale_save)
    assert flushed == SaveReceipt(
        revision: LATEST_SAVE_REVISION,
        text: PUBLISHED_TEXT,
        status: SaveStatus.Flushed,
    )

requirement PENDING_SEARCH_IS_CANCELLABLE for resolve_search:
    text "A spawned resolution stays pending until the scheduler's next turn, so cancelling it before that turn ends it cancelled instead of completed."
    checked_by latest_result_and_coalesced_save
