module curriculum.opaque_resource

external type TextBuffer

struct HandleBundle:
    handle: Opaque["client_session"]

enum HandleError:
    InvalidHandle

fn wrap_handle(raw_id: U64) -> Result[HandleBundle, HandleError]:
    doc """
    Wrap a nonzero connection ID in a bundle containing a client-session handle.
    """

    error HandleError.InvalidHandle when raw_id == 0

    effects []

fn extract_handle_id(bundle: HandleBundle) -> U64:
    doc """
    Extract the client-session handle ID from a bundle returned by wrap_handle.
    """

    ensures result > 0

    effects []

fn iter_lines(buffer: TextBuffer) -> Iterator[Str]:
    doc """
    Lazily yield the buffer's lines without their trailing line endings.
    """

    effects []

fn echo_values(values: Iterator[Any]) -> Generator[Any, Unknown, U64]:
    doc """
    Yield each input value, ignore sent values, and return the yielded count.
    """

    effects []
