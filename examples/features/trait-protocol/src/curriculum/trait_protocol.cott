module curriculum.trait_protocol

trait Summarizable:
    type Summary
    async fn summary(self) -> Summarizable.Summary

trait Prioritizable:
    async fn priority_level(self) -> I32

trait TaskView[+T] for Summarizable + Prioritizable:
    async fn display(self) -> T
    async fn category(self) -> Str = curriculum.trait_protocol.default_category

trait Completable:
    async fn complete(self) -> Bool

async fn default_category[T](receiver: TaskView[T]) -> Str:
    doc """
    Return the fixed default category "default" for any task view.
    """

    ensures result == "default"

    effects []

async fn specialized_display(receiver: SimpleTask) -> Str:
    doc """
    Return the text "specialized: " immediately followed by receiver.title.
    """

    ensures (starts_with(result, "specialized: "))
    ensures (ends_with(result, receiver.title))
    ensures result.len == receiver.title.len + 13

    effects []

fn task_factory() -> Factory[SimpleTask]:
    doc """
    Return the SimpleTask constructor itself as the factory.
    """

    effects []

async fn inspect_dyn(item: Dyn[TaskView[Str]]) -> Str:
    doc """
    Return the awaited summary of the dynamically dispatched task view item.
    """

    effects []

resource TaskLifecycle:
    initial Pending
    state Pending
    state Completed
    terminal Completed
    transition Pending -> Completed

specialize SimpleTask for TaskView[Str]:
    display = curriculum.trait_protocol.specialized_display

impl SimpleTask for TaskView[Str] + Completable:
    type Summary = Str
    state:
        title: Str
        urgency: I32
        lifecycle: TaskLifecycle
        completion_count: I32 = 0

    invariant self.title.len > 0
    invariant self.urgency >= 0
    invariant self.completion_count >= 0

    init(title: Str, urgency: I32):
        requires title.len > 0
        requires urgency >= 0

        ensures self.title == title
        ensures self.urgency == urgency

    async fn summary(self) -> Str:
        ensures result == self.title

        effects []

    async fn priority_level(self) -> I32:
        ensures result == self.urgency

        effects []

    async fn complete(self) -> Bool:
        transitions self.lifecycle: TaskLifecycle.Pending -> TaskLifecycle.Completed

        modifies self.completion_count

        ensures result == true
        ensures old(self.completion_count) + 1 == self.completion_count

        effects []

scenario dyn_view_dispatches_summary:
    call task = SimpleTask(title: "Launch", urgency: 1)
    call summary = task.summary()
    assert summary == "Launch"
    data view: Dyn[TaskView[Str]] = Dyn(value: task)
    call dyn_summary = inspect_dyn(view)
    assert dyn_summary == "Launch"

requirement DYN_VIEW_RETURNS_SUMMARY for inspect_dyn:
    text "The result is the awaited `summary()` of the viewed task, not its `display()` or `category()` text."
    checked_by dyn_view_dispatches_summary assert 2
