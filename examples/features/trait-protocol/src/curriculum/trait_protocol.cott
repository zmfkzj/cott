module curriculum.trait_protocol

trait Summarizable:
    fn summary(self) -> Str

trait Prioritizable:
    fn priority_level(self) -> I32

trait Completable:
    fn complete(self) -> Bool

fn format_summary[T: Summarizable](item: T) -> Str:
    doc """
    Format the summary string from any item implementing {Summarizable}.
    """

    ensures result.len >= 0

    effects []

fn inspect_task[T: Summarizable + Prioritizable](item: T) -> Str:
    doc """
    Inspect an item requiring both {Summarizable} and {Prioritizable} trait bounds.
    """

    ensures result.len > 0

    effects []

impl SimpleTask for Summarizable + Prioritizable + Completable:
    state:
        title: Str
        urgency: I32
        completed: Bool = false

    invariant self.title.len > 0
    invariant self.urgency >= 0

    init(title: Str, urgency: I32):
        requires title.len > 0
        requires urgency >= 0

        ensures self.title == title
        ensures self.urgency == urgency
        ensures self.completed == false

    fn summary(self) -> Str:
        ensures result.len > 0

        effects []

    fn priority_level(self) -> I32:
        ensures result == self.urgency

        effects []

    fn complete(self) -> Bool:
        requires self.completed == false

        modifies self.completed

        ensures old(self.completed) == false
        ensures self.completed == true
        ensures result == self.completed

        effects []
