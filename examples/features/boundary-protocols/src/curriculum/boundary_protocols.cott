module curriculum.boundary_protocols

external type TextBuffer

struct HandleBundle:
    handle: Opaque["client_session"]
    raw_id: U64

enum HandleError:
    InvalidHandle

fn wrap_handle(raw_id: U64) -> Result[HandleBundle, HandleError]:
    doc """
    Wrap a nonzero connection ID in a client-session opaque handle.
    """

    ensures Result.Ok(bundle) => bundle.raw_id == raw_id and bundle.raw_id > 0

    error HandleError.InvalidHandle when raw_id == 0

    effects []

fn extract_handle_id(bundle: HandleBundle) -> U64:
    doc """
    Explicitly adapt a client-session opaque handle to its Python ID.
    """

    ensures result > 0

    effects []

fn adapt_unknown(value: Any) -> Unknown:
    doc """
    Deliberately adapt an unconstrained value to an explicitly narrowed boundary value.
    """

    effects []

fn iter_lines(buffer: TextBuffer) -> Iterator[Str]:
    doc """
    Lazily yield buffer lines without trailing line endings.
    """

    effects []

fn echo_values(values: Iterator[Any]) -> Generator[Any, Unknown, U64]:
    doc """
    Yield each value, discard sent unknown values, and return the yield count.
    """

    effects []

async fn async_lines(values: AsyncIterator[Str]) -> AsyncIterator[Str]:
    doc """
    Return the supplied async iterator.
    """

    effects []

async fn echo_async(values: AsyncGenerator[Any, Unknown]) -> AsyncGenerator[Any, Unknown]:
    doc """
    Return the supplied async generator.
    """

    effects []
