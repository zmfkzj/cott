module curriculum.flashcard_schedule

enum Rating:
    Again
    Hard
    Good
    Easy

struct Review:
    due_day: U32
    interval_days: U32
    ease_permille: U16
    rating: Rating

struct ScheduledCard:
    due_day: U32
    interval_days: U32
    ease_permille: U16

enum FlashcardScheduleError:
    ZeroEase
    EaseOutOfRange
    DateOverflow

fn validate_review_ease(review: Review) -> Result[Unit, FlashcardScheduleError]:
    doc """
    Validates the ease value used by flashcard scheduling. ZeroEase takes
    priority over EaseOutOfRange.
    """

    error FlashcardScheduleError.ZeroEase when review.ease_permille == 0
    error FlashcardScheduleError.EaseOutOfRange when (review.ease_permille != 0 and (review.ease_permille < 1300 or review.ease_permille > 3000))

    effects []

fn schedule_review(review: Review) -> Result[ScheduledCard, FlashcardScheduleError]:
    doc """
    Validates review ease, then deterministically schedules the next due day.
    Again resets the interval to one day and subtracts 200 ease points; Hard
    grows the interval by 1.2 and subtracts 150; Good multiplies by the current
    ease; and Easy additionally multiplies by 1.3 and adds 150 ease points.
    DateOverflow is returned when adding the computed interval would exceed
    the maximum U32 due day.
    """

    ensures Result.Ok(card) => card.interval_days >= 1
    ensures Result.Ok(card) => card.due_day > review.due_day
    ensures Result.Ok(card) => card.ease_permille >= 1100 and card.ease_permille <= 3150

    error FlashcardScheduleError.ZeroEase when review.ease_permille == 0
    error FlashcardScheduleError.EaseOutOfRange when (review.ease_permille != 0 and (review.ease_permille < 1300 or review.ease_permille > 3000))
    error FlashcardScheduleError.DateOverflow

    effects []
