module curriculum.backup_plan

struct BackupPath:
    path: Path
    content_id: Str

struct BackupPlanRequest:
    paths: List[BackupPath]
    known_content_ids: Set[Str]

struct BackupPlan:
    upload_paths: List[Path]
    reused_content_ids: List[Str]

enum BackupPlanError:
    EmptyPath
    BlankContentId
    DuplicatePath

fn validate_backup_request(request: BackupPlanRequest) -> Result[Unit, BackupPlanError]:
    doc """
    Validate backup paths in request order. For each path, EmptyPath takes
    priority over BlankContentId, which takes priority over DuplicatePath.
    Duplicate detection includes every earlier valid path.
    """

    error BackupPlanError.EmptyPath
    error BackupPlanError.BlankContentId
    error BackupPlanError.DuplicatePath

    effects []

fn classify_backup_paths(paths: List[BackupPath], known_content_ids: Set[Str]) -> BackupPlan:
    doc """
    Classify the first occurrence of each content identifier in input order.
    Known content is reused; unknown content contributes its path for upload.
    """

    ensures plan => (plan.upload_paths.len + plan.reused_content_ids.len <= paths.len)

    effects []

fn plan_backup(request: BackupPlanRequest) -> Result[BackupPlan, BackupPlanError]:
    doc """
    Validate a backup request, then classify its paths into deterministic
    upload and reuse lists.
    """

    ensures Result.Ok(plan) => (plan.upload_paths.len + plan.reused_content_ids.len <= request.paths.len)

    error BackupPlanError.EmptyPath
    error BackupPlanError.BlankContentId
    error BackupPlanError.DuplicatePath

    effects []
