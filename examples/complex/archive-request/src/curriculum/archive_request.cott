module curriculum.archive_request

enum CaptureKind:
    Html
    Media

struct ArchiveRequest:
    url: Str
    include_html: Bool
    include_media: Bool

struct ArchivePlan:
    canonical_url: Str
    captures: List[CaptureKind]

enum ArchiveRequestError:
    InvalidUrl
    EmptySelection

fn canonicalize_archive_url(url: Str) -> Result[Str, ArchiveRequestError]:
    doc """
    Parse an HTTP or HTTPS URL and return its deterministic canonical form.
    The scheme and host are lowercased while user information, port, path,
    query, and fragment are retained. Invalid or malformed URLs return
    InvalidUrl.
    """

    ensures Result.Ok(canonical_url) => canonical_url.len > 0

    error ArchiveRequestError.InvalidUrl

    effects []

fn compose_archive_plan(canonical_url: Str, include_html: Bool, include_media: Bool) -> ArchivePlan:
    doc """
    Assemble an archive plan from a canonical URL and the requested capture
    kinds. HTML precedes media when both kinds are selected.
    """

    ensures result.canonical_url == canonical_url

    effects []

fn plan_archive(request: ArchiveRequest) -> Result[ArchivePlan, ArchiveRequestError]:
    doc """
    Reject a request with neither capture kind selected as EmptySelection before
    canonicalizing its URL. Otherwise canonicalize the URL and compose the plan;
    malformed URLs return InvalidUrl.
    """

    ensures Result.Ok(plan) => plan.canonical_url.len > 0 and plan.captures.len > 0

    error ArchiveRequestError.EmptySelection when (not request.include_html and not request.include_media)
    error ArchiveRequestError.InvalidUrl

    effects []
