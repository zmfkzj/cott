module curriculum.case_ranking

struct CaseRecord:
    case_id: Str
    title: Str
    terms: Set[Str]
    cited_by_count: U32

struct CaseRankingRequest:
    query_terms: Set[Str]
    cases: List[CaseRecord]

struct CaseRanking:
    case_ids: List[Str]

enum CaseRankingError:
    EmptyQuery
    BlankCaseId
    DuplicateCaseId
    BlankTerm

fn score_case_overlap(query_terms: Set[Str], case: CaseRecord) -> U64:
    doc """
    Count the distinct terms shared by a query and one case. Set semantics make
    every matching term contribute exactly one point. This operation is total,
    including for empty sets and otherwise unvalidated records.
    """

    ensures result <= query_terms.len
    ensures result <= case.terms.len

    effects []

fn order_matching_cases(query_terms: Set[Str], cases: List[CaseRecord]) -> CaseRanking:
    doc """
    Omit cases with no query overlap and deterministically order the remainder
    by descending overlap score, descending citation count, then ascending case
    identifier. Inputs need not have passed request validation.
    """

    ensures result.case_ids.len <= cases.len

    effects []

fn rank_cases(request: CaseRankingRequest) -> Result[CaseRanking, CaseRankingError]:
    doc """
    Validate a ranking request in source order, then rank its matching cases.
    An empty query is rejected before blank query terms. Cases are inspected in
    input order for blank identifiers, duplicate identifiers, and blank terms.
    """

    ensures Result.Ok(ranking) => ranking.case_ids.len <= request.cases.len

    error CaseRankingError.EmptyQuery when request.query_terms.len == 0
    error CaseRankingError.BlankCaseId
    error CaseRankingError.DuplicateCaseId
    error CaseRankingError.BlankTerm

    effects []
