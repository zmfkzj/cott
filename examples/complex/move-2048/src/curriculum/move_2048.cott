module curriculum.move_2048

struct Board4:
    cells: List[U16]

enum Direction:
    Left
    Right
    Up
    Down

struct MoveRequest:
    board: Board4
    direction: Direction

struct MoveResult:
    board: Board4
    score_gain: U32
    changed: Bool

struct LineMove:
    cells: List[U16]
    score_gain: U32

enum Move2048Error:
    InvalidBoardSize
    InvalidTile
    ScoreOverflow

fn validate_2048_board(board: Board4) -> Result[Unit, Move2048Error]:
    doc """
    Validate a row-major four-by-four board. InvalidBoardSize takes priority
    over InvalidTile. A valid tile is zero or a power of two representable as
    U16.
    """

    error Move2048Error.InvalidBoardSize when board.cells.len != 16
    error Move2048Error.InvalidTile

    effects []

fn merge_move_line(line: List[U16]) -> Result[LineMove, Move2048Error]:
    doc """
    Compact one line toward its first cell and merge equal adjacent nonzero
    tiles once. A tile created by a merge cannot merge again in the same line.
    Preserve the input length by padding with zeros and report ScoreOverflow
    if a merged tile cannot fit U16 or the accumulated score cannot fit U32.
    """

    ensures Result.Ok(moved) => moved.cells.len == line.len

    error Move2048Error.ScoreOverflow

    effects []

fn apply_2048_move(request: MoveRequest) -> Result[MoveResult, Move2048Error]:
    doc """
    Validate the board once, orient its four rows or columns toward the
    requested direction, merge each through merge_move_line, and restore
    row-major order. Return the immutable moved board, the checked sum of all
    merge scores, and whether any cell changed.
    """

    ensures Result.Ok(moved) => moved.board.cells.len == 16

    error Move2048Error.InvalidBoardSize when request.board.cells.len != 16
    error Move2048Error.InvalidTile
    error Move2048Error.ScoreOverflow

    effects []
