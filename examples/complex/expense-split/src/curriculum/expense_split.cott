module curriculum.expense_split

struct Expense:
    payer: Str
    amount_cents: U64
    participants: List[Str]

struct Transfer:
    sender: Str
    recipient: Str
    cents: U64

struct Settlement:
    transfers: List[Transfer]

struct Balance:
    participant: Str
    cents: U64

struct BalanceSheet:
    debtors: List[Balance]
    creditors: List[Balance]

enum ExpenseSplitError:
    BlankPayer
    EmptyParticipants
    DuplicateParticipant
    PayerNotParticipant
    ZeroAmount

fn calculate_balances(expense: Expense) -> Result[BalanceSheet, ExpenseSplitError]:
    doc """
    Validate one expense and calculate exact integer-cent balances. Validation
    priority is BlankPayer, EmptyParticipants, ZeroAmount,
    DuplicateParticipant, then PayerNotParticipant. The expense is divided
    evenly among alphabetically ordered participants, and remainder cents are
    charged one at a time in that order. Returned debtor and creditor entries
    are also ordered alphabetically. This pure function terminates for every
    finite Expense.
    """

    ensures Result.Ok(balances) => (balances.debtors.len + balances.creditors.len <= expense.participants.len)

    error ExpenseSplitError.BlankPayer when expense.payer.len == 0
    error ExpenseSplitError.EmptyParticipants when expense.participants.len == 0
    error ExpenseSplitError.ZeroAmount when expense.amount_cents == 0
    error ExpenseSplitError.DuplicateParticipant
    error ExpenseSplitError.PayerNotParticipant

    effects []

fn settle_balances(balances: BalanceSheet) -> Settlement:
    doc """
    Greedily match alphabetically ordered debtors and creditors using exact
    integer cents. Each transfer pays the smaller remaining balance, advancing
    every exhausted side. Zero balances are consumed without stalling, so this
    pure function terminates for every finite BalanceSheet.
    """

    ensures result.transfers.len <= (balances.debtors.len + balances.creditors.len)

    effects []

fn settle_expense(expense: Expense) -> Result[Settlement, ExpenseSplitError]:
    doc """
    Calculate the expense's exact balances, propagate the first validation
    error unchanged, and greedily settle every successful balance sheet.
    """

    ensures Result.Ok(settlement) => settlement.transfers.len <= expense.participants.len

    error ExpenseSplitError.BlankPayer when expense.payer.len == 0
    error ExpenseSplitError.EmptyParticipants when expense.participants.len == 0
    error ExpenseSplitError.ZeroAmount when expense.amount_cents == 0
    error ExpenseSplitError.DuplicateParticipant
    error ExpenseSplitError.PayerNotParticipant

    effects []
