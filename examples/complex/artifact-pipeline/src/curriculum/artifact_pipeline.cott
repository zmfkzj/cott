module curriculum.artifact_pipeline

struct BuildStep:
    name: Str
    needs: Set[Str]

struct Pipeline:
    steps: List[BuildStep]

struct ArtifactPlan:
    ordered_steps: List[Str]

enum ArtifactPipelineError:
    BlankStepName
    DuplicateStep
    UnknownDependency
    SelfDependency
    Cycle

fn topologically_order_steps(steps: List[BuildStep]) -> Result[List[Str], ArtifactPipelineError]:
    doc """
    Order build steps so that every step follows the steps named in its needs.
    Names and needs are compared exactly, without trimming or normalization. A
    blank name is empty or consists only of the 25 Unicode White_Space
    characters used by any_blank_by; U+FEFF, U+180E, U+200B and U+001C are not
    whitespace for this contract.
    """

    ensures Result.Ok(ordered_steps) => permutation_by(ordered_steps, steps, BuildStep.name)
    ensures Result.Ok(ordered_steps) => dependency_ordered_by(ordered_steps, steps, BuildStep.name, BuildStep.needs)

    errors complete
    error ArtifactPipelineError.BlankStepName when any_blank_by(steps, BuildStep.name)
    error ArtifactPipelineError.DuplicateStep when not unique_by(steps, BuildStep.name)
    error ArtifactPipelineError.UnknownDependency when unknown_dependency_by(steps, BuildStep.name, BuildStep.needs)
    error ArtifactPipelineError.SelfDependency when self_dependency_by(steps, BuildStep.name, BuildStep.needs)
    error ArtifactPipelineError.Cycle when cyclic_by(steps, BuildStep.name, BuildStep.needs)

    effects []

fn plan_pipeline(pipeline: Pipeline) -> Result[ArtifactPlan, ArtifactPipelineError]:
    doc """
    Plan the pipeline by ordering pipeline.steps through the public
    topologically_order_steps facade.
    """

    ensures Result.Ok(plan) => permutation_by(plan.ordered_steps, pipeline.steps, BuildStep.name)
    ensures Result.Ok(plan) => dependency_ordered_by(plan.ordered_steps, pipeline.steps, BuildStep.name, BuildStep.needs)

    errors complete
    error ArtifactPipelineError.BlankStepName when any_blank_by(pipeline.steps, BuildStep.name)
    error ArtifactPipelineError.DuplicateStep when not unique_by(pipeline.steps, BuildStep.name)
    error ArtifactPipelineError.UnknownDependency when unknown_dependency_by(pipeline.steps, BuildStep.name, BuildStep.needs)
    error ArtifactPipelineError.SelfDependency when self_dependency_by(pipeline.steps, BuildStep.name, BuildStep.needs)
    error ArtifactPipelineError.Cycle when cyclic_by(pipeline.steps, BuildStep.name, BuildStep.needs)

    effects []

scenario ready_steps_in_name_order:
    data steps: List[BuildStep] = List(
        BuildStep(name: "lint", needs: Set()),
        BuildStep(name: "test", needs: Set()),
        BuildStep(name: "bundle", needs: Set("lint")),
    )
    call order = topologically_order_steps(steps)
    assert order matches Result.Ok(names) => names == List("lint", "bundle", "test")
    call plan = plan_pipeline(Pipeline(steps: steps))
    assert plan matches Result.Ok(value) => value.ordered_steps == List("lint", "bundle", "test")

scenario blank_name_precedes_other_errors:
    call plan = plan_pipeline(
        Pipeline(
            steps: List(
                BuildStep(name: "", needs: Set("missing")),
                BuildStep(name: "", needs: Set("")),
            ),
        ),
    )
    assert plan matches Result.Err(ArtifactPipelineError.BlankStepName)

scenario duplicate_step_precedes_dependency_errors:
    call plan = plan_pipeline(
        Pipeline(
            steps: List(
                BuildStep(name: "a", needs: Set("ghost")),
                BuildStep(name: "a", needs: Set("a")),
                BuildStep(name: "b", needs: Set("c")),
                BuildStep(name: "c", needs: Set("b")),
            ),
        ),
    )
    assert plan matches Result.Err(ArtifactPipelineError.DuplicateStep)

scenario unknown_dependency_precedes_self_dependency:
    call plan = plan_pipeline(
        Pipeline(
            steps: List(
                BuildStep(name: "a", needs: Set("a", "ghost")),
                BuildStep(name: "b", needs: Set("c")),
                BuildStep(name: "c", needs: Set("b")),
            ),
        ),
    )
    assert plan matches Result.Err(ArtifactPipelineError.UnknownDependency)

scenario self_dependency_precedes_cycle:
    call plan = plan_pipeline(
        Pipeline(
            steps: List(
                BuildStep(name: "a", needs: Set("a")),
                BuildStep(name: "b", needs: Set("c")),
                BuildStep(name: "c", needs: Set("b")),
            ),
        ),
    )
    assert plan matches Result.Err(ArtifactPipelineError.SelfDependency)

scenario cycle_is_rejected:
    call plan = plan_pipeline(
        Pipeline(
            steps: List(
                BuildStep(name: "a", needs: Set("b")),
                BuildStep(name: "b", needs: Set("a")),
            ),
        ),
    )
    assert plan matches Result.Err(ArtifactPipelineError.Cycle)

requirement READY_STEPS_IN_NAME_ORDER for topologically_order_steps:
    text "Whenever several steps have all their needs placed, the next step is the one whose name is smallest in Unicode code point order, so a valid pipeline has exactly one result regardless of input order."
    checked_by ready_steps_in_name_order assert 1

requirement PLAN_USES_ORDERING_FACADE for plan_pipeline:
    text "plan_pipeline calls the public topologically_order_steps facade with pipeline.steps; ordered_steps is exactly the returned order and an ordering error is returned unchanged."
    checked_by ready_steps_in_name_order assert 2
