module curriculum.reputation

enum ReputationEvent:
    Upvote
    Downvote
    AcceptedAnswer

struct Reputation:
    value: I32

struct ReputationRequest:
    starting: I32
    events: List[ReputationEvent]

enum ReputationError:
    NegativeStarting
    ReputationOverflow
    WouldBecomeNegative

fn reputation_delta(event: ReputationEvent) -> I32:
    doc """
    Return the fixed score change for one reputation event.
    
    Upvotes add 10, downvotes subtract 2, and accepted answers add 15.
    """

    effects []

fn calculate_reputation(request: ReputationRequest) -> Result[Reputation, ReputationError]:
    doc """
    Fold reputation events in request order from a non-negative starting score.
    
    Reject a negative starting score before processing events. During the fold,
    reject the first event that would overflow I32 or make the score negative.
    """

    ensures Result.Ok(reputation) => reputation.value >= 0
    ensures Result.Ok(reputation) => reputation.value <= 2147483647

    error ReputationError.NegativeStarting when request.starting < 0
    error ReputationError.ReputationOverflow
    error ReputationError.WouldBecomeNegative

    effects []
