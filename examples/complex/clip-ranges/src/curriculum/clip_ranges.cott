module curriculum.clip_ranges

struct TimeRange:
    start_ms: U64
    end_ms: U64

struct ClipRequest:
    duration_ms: U64
    ranges: List[TimeRange]

struct ClipPlan:
    ranges: List[TimeRange]
    total_ms: U64

enum ClipRangeError:
    EmptyRanges
    StartNotBeforeEnd
    PastDuration
    TotalOverflow

fn range_duration_ms(range: TimeRange) -> U64:
    doc """
    Return the duration of one validated half-open time range in milliseconds.
    The caller must establish that the range starts before it ends.
    """

    requires range.start_ms < range.end_ms

fn plan_clip_ranges(request: ClipRequest) -> Result[ClipPlan, ClipRangeError]:
    doc """
    Validate requested intervals in input order and build a clip plan.
    Empty input is rejected first. Each range must start before it ends and
    must not extend past the source duration. Valid ranges remain unchanged
    and their durations are accumulated with checked U64 arithmetic.
    """

    ensures Result.Ok(plan) => plan.ranges.len == request.ranges.len
    ensures Result.Ok(plan) => plan.ranges.len > 0

    error ClipRangeError.EmptyRanges when request.ranges.len == 0
    error ClipRangeError.StartNotBeforeEnd
    error ClipRangeError.PastDuration
    error ClipRangeError.TotalOverflow
