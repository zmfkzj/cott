{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cott",
  "scopeName": "source.cott",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#docstrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function_definition"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.cott",
          "match": "#.*$"
        }
      ]
    },
    "docstrings": {
      "patterns": [
        {
          "name": "string.quoted.triple.cott",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.cott",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cott",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cott",
              "match": "\\\\([nrt\\\\'\"]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "function_definition": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.cott"
            },
            "2": {
              "name": "entity.name.function.cott"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.cott",
          "match": "\\b(module|use|alias|newtype|struct|enum|trait|rule|const|fn)\\b"
        },
        {
          "name": "storage.modifier.cott",
          "match": "\\b(override|delete|remove)\\b"
        },
        {
          "name": "keyword.control.contract.cott",
          "match": "\\b(requires|ensures|error|when|effects|where|doc)\\b"
        },
        {
          "name": "keyword.operator.logical.cott",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.cott",
          "match": "\\b(self|result)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.cott",
          "match": "\\b(Bool|I8|I16|I32|I64|U8|U16|U32|U64|F32|F64|Str|Bytes|Path|Unit|JsonValue|Never|Opaque)\\b"
        },
        {
          "name": "support.type.container.cott",
          "match": "\\b(List|Set|Map|Tuple|Option|Result)\\b"
        },
        {
          "name": "support.class.variant.cott",
          "match": "\\b(Ok|Err|Some|Nothing)\\b"
        },
        {
          "name": "entity.name.type.cott",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cott",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.float.cott",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.cott",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.cott",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.cott",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.cott",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.cott",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.dot.cott",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.cott",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.cott",
          "match": ":"
        },
        {
          "name": "punctuation.section.parens.cott",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.cott",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.cott",
          "match": "[{}]"
        }
      ]
    }
  }
}
