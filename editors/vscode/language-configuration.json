{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["\"\"\"", "\"\"\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(module|struct|enum|trait|rule|fn|alias|newtype)\\b.*:\\s*$",
    "decreaseIndentPattern": "^\\s*(where|requires|ensures|error|effects|override|delete)\\b"
  }
}
